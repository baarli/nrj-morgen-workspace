<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mission Control API Documentation</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #667eea; --primary-dark: #764ba2; --success: #10b981;
            --warning: #f59e0b; --danger: #ef4444; --info: #3b82f6;
            --dark: #0f172a; --dark-light: #1e293b; --text: #e2e8f0;
            --text-muted: #94a3b8; --text-dim: #64748b;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, var(--dark) 0%, var(--dark-light) 100%);
            color: var(--text); min-height: 100vh;
        }
        .container { display: flex; min-height: 100vh; }
        .sidebar {
            width: 300px; background: rgba(30, 41, 59, 0.98); padding: 24px;
            border-right: 1px solid rgba(255,255,255,0.1); position: fixed;
            height: 100vh; overflow-y: auto; z-index: 100;
        }
        .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .logo-icon { width: 48px; height: 48px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .nav { list-style: none; }
        .nav li { margin-bottom: 4px; }
        .nav a { display: block; padding: 10px 16px; border-radius: 8px; color: var(--text-muted); text-decoration: none; transition: all 0.2s; font-size: 14px; }
        .nav a:hover, .nav a.active { background: rgba(102, 126, 234, 0.1); color: white; }
        .nav .section { font-size: 11px; text-transform: uppercase; color: var(--text-dim); margin: 16px 0 8px; padding-left: 16px; }
        .main { flex: 1; margin-left: 300px; padding: 32px; max-width: 900px; }
        h1 { font-size: 36px; margin-bottom: 16px; }
        h2 { font-size: 28px; margin: 32px 0 16px; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        h3 { font-size: 20px; margin: 24px 0 12px; }
        p { line-height: 1.7; margin-bottom: 16px; color: var(--text-muted); }
        .endpoint { background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; margin-bottom: 24px; overflow: hidden; }
        .endpoint-header { padding: 16px 20px; background: rgba(15, 23, 42, 0.5); display: flex; align-items: center; gap: 12px; }
        .method { padding: 4px 12px; border-radius: 4px; font-size: 12px; font-weight: bold; text-transform: uppercase; }
        .method-get { background: var(--success); color: white; }
        .method-post { background: var(--primary); color: white; }
        .method-patch { background: var(--warning); color: white; }
        .method-delete { background: var(--danger); color: white; }
        .path { font-family: monospace; font-size: 14px; }
        .endpoint-body { padding: 20px; }
        .code-block { background: #1e1e1e; border-radius: 8px; overflow: hidden; margin: 16px 0; }
        .code-block pre { margin: 0; padding: 16px; overflow-x: auto; }
        .param { display: grid; grid-template-columns: 150px 100px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .param:last-child { border-bottom: none; }
        .param-name { font-family: monospace; color: var(--primary); }
        .param-type { color: var(--text-dim); font-size: 13px; }
        .param-desc { color: var(--text-muted); font-size: 14px; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; margin-left: 8px; }
        .badge-required { background: var(--danger); color: white; }
        .badge-optional { background: var(--text-dim); color: white; }
        @media (max-width: 768px) { .sidebar { display: none; } .main { margin-left: 0; } }
    </style>
</head>
<body>
    <div class="container">
        <!-- Standard Navigation Template - Copy this to all HTML files -->
<aside class="sidebar">
    <div class="logo">
        <div class="logo-icon">🚀</div>
        <div>
            <h1 style="font-size: 18px; margin: 0;">Mission Control</h1>
            <p style="font-size: 11px; color: #94a3b8; margin: 4px 0 0 0;">v3.0</p>
        </div>
    </div>
    <ul class="nav">
        <li><a href="total-control.html"><i class="fas fa-home"></i> Oversikt</a></li>
        <li><a href="sakslista-pro.html"><i class="fas fa-list"></i> Saker</a></li>
        <li><a href="analytics.html"><i class="fas fa-chart-line"></i> Analyse</a></li>
        <li><a href="ai-assistant.html"><i class="fas fa-robot"></i> AI Assistant</a></li>
        <li><a href="widget-dashboard.html"><i class="fas fa-th-large"></i> Widgets</a></li>
        <li><a href="podkast-control.html"><i class="fas fa-podcast"></i> Podkast</a></li>
        <li><a href="cron-control.html"><i class="fas fa-clock"></i> Cron</a></li>
        <li><a href="agent-control.html"><i class="fas fa-robot"></i> Agent</a></li>
        <li><a href="notifications.html"><i class="fas fa-bell"></i> Varsler</a></li>
        <li><a href="system-monitor.html"><i class="fas fa-heartbeat"></i> System</a></li>
        <li><a href="database-admin.html"><i class="fas fa-database"></i> Database</a></li>
        <li><a href="git-control.html"><i class="fas fa-code-branch"></i> Git</a></li>
        <li><a href="api-docs.html" class="active"><i class="fas fa-book"></i> API Docs</a></li>
        <li><a href="innstillinger.html"><i class="fas fa-cog"></i> Innstillinger</a></li>
    </ul>
</aside>

        <main class="main">
            <h1>Mission Control API</h1>
            
            <p>Complete API reference for Mission Control Total Control system. Base URL: <code>http://47.84.19.119:8081/api</code></p>

            <h2 id="intro">Introduction</h2>
            <p>The Mission Control API provides programmatic access to all system functions. All requests and responses are in JSON format.</p>

            <h2 id="auth">Authentication</h2>
            <p>Currently, the API uses IP-based authentication. Future versions will include API key support.</p>

            <h2 id="status">Status</h2>
            
            <div class="endpoint">
                <div class="endpoint-header">
                    <span class="method method-get">GET</span>
                    <span class="path">/status</span>
                </div>
                <div class="endpoint-body">
                    <p>Get overall system status.</p>
                    
                    <h4>Response</h4>
                    <div class="code-block">
                        <pre><code class="language-json">{
  "status": "operational",
  "timestamp": "2026-02-24T05:00:00Z",
  "systems": {
    "agent": {
      "auto_exec": "active",
      "autonomous_mode": "active"
    },
    "database": "connected",
    "api": "active",
    "morning_routine": "idle"
  }
}</code></pre>
                    </div>
                </div>
            </div>

            <h2 id="system">System</h2>
            
            <div class="endpoint">
                <div class="endpoint-header">
                    <span class="method method-get">GET</span>
                    <span class="path">/system/resources</span>
                </div>
                <div class="endpoint-body">
                    <p>Get system resource usage (CPU, RAM, Disk).</p>
                    
                    <h4>Response</h4>
                    <div class="code-block">
                        <pre><code class="language-json">{
  "cpu": 12.5,
  "memory": {
    "used": 4,
    "total": 8,
    "percent": 45
  },
  "disk": {
    "used": 45,
    "total": 60,
    "percent": 78
  }
}</code></pre>
                    </div>
                </div>
            </div>

            <h2 id="nrj">NRJ Sakslista</h2>
            
            <div class="endpoint">
                <div class="endpoint-header">
                    <span class="method method-get">GET</span>
                    <span class="path">/nrj/saker</span>
                </div>
                <div class="endpoint-body">
                    <p>Get today's saker from Supabase.</p>
                </div>
            </div>

            <div class="endpoint">
                <div class="endpoint-header">
                    <span class="method method-post">POST</span>
                    <span class="path">/nrj/saker</span>
                </div>
                <div class="endpoint-body">
                    <p>Create a new sak.</p>
                    
                    <h4>Request Body</h4>
                    <div class="param">
                        <span class="param-name">title</span>
                        <span class="param-type">string</span>
                        <span class="param-desc">Sak title</span>
                    </div>
                    <div class="param">
                        <span class="param-name">description</span>
                        <span class="param-type">string</span>
                        <span class="param-desc">Sak description</span>
                    </div>
                </div>
            </div>

            <h2 id="websocket">WebSocket Events</h2>
            
            <p>Connect to <code>ws://47.84.19.119:8081/ws</code> for real-time updates.</p>

            <h3>Event Types</h3>
            
            <div class="endpoint">
                <div class="endpoint-header">
                    <span class="method" style="background: var(--info);">EVENT</span>
                    <span class="path">system.metrics</span>
                </div>
                <div class="endpoint-body">
                    <p>Real-time system metrics updates.</p>
                </div>
            </div>

            <div class="endpoint">
                <div class="endpoint-header">
                    <span class="method" style="background: var(--info);">EVENT</span>
                    <span class="path">activity.log</span>
                </div>
                <div class="endpoint-body">
                    <p>New activity log entries.</p>
                </div>
            </div>

        </main>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js"></script>
<script src="auto-nav.js"></script>
</body>
</html>
