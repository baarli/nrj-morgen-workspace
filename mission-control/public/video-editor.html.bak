<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Editor - Mission Control</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #667eea; --primary-dark: #764ba2; --success: #10b981;
            --warning: #f59e0b; --danger: #ef4444; --info: #3b82f6;
            --dark: #0f172a; --dark-light: #1e293b; --text: #e2e8f0;
            --text-muted: #94a3b8; --text-dim: #64748b; --border: rgba(255,255,255,0.1);
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, var(--dark) 0%, var(--dark-light) 100%);
            color: var(--text); min-height: 100vh;
        }
        .container { display: flex; min-height: 100vh; }
        .sidebar {
            width: 280px; background: rgba(30, 41, 59, 0.98); padding: 24px;
            border-right: 1px solid var(--border); position: fixed;
            height: 100vh; overflow-y: auto; z-index: 100;
        }
        .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid var(--border); }
        .logo-icon { width: 48px; height: 48px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .nav { list-style: none; }
        .nav li { margin-bottom: 8px; }
        .nav a { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; color: var(--text-muted); text-decoration: none; transition: all 0.2s; }
        .nav a:hover, .nav a.active { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; }
        .main { flex: 1; margin-left: 280px; padding: 24px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        .header h2 { font-size: 24px; display: flex; align-items: center; gap: 12px; }
        .header h2 i { color: var(--primary); }
        
        /* Editor Layout */
        .editor-container { display: grid; grid-template-columns: 1fr 320px; gap: 24px; height: calc(100vh - 120px); }
        .editor-main { display: flex; flex-direction: column; gap: 16px; }
        .editor-sidebar { display: flex; flex-direction: column; gap: 16px; overflow-y: auto; }
        
        /* Canvas Container */
        .canvas-container {
            flex: 1; background: rgba(15, 23, 42, 0.8); border: 1px solid var(--border);
            border-radius: 12px; display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden; min-height: 400px;
        }
        #videoCanvas {
            max-width: 100%; max-height: 100%; background: #000;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        }
        .canvas-overlay {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            pointer-events: none; display: flex; align-items: center; justify-content: center;
        }
        .canvas-placeholder {
            text-align: center; color: var(--text-muted);
        }
        .canvas-placeholder i { font-size: 64px; margin-bottom: 16px; opacity: 0.5; }
        
        /* Timeline */
        .timeline-container {
            background: rgba(30, 41, 59, 0.7); border: 1px solid var(--border);
            border-radius: 12px; padding: 16px;
        }
        .timeline-header {
            display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;
        }
        .timeline-controls { display: flex; gap: 8px; }
        .timeline-btn {
            padding: 8px 16px; background: rgba(102, 126, 234, 0.2); border: 1px solid var(--primary);
            border-radius: 6px; color: var(--text); cursor: pointer; transition: all 0.2s;
            font-size: 13px; display: flex; align-items: center; gap: 6px;
        }
        .timeline-btn:hover { background: var(--primary); }
        .timeline-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .timeline-btn.primary { background: var(--primary); }
        .timeline-btn.primary:hover { background: var(--primary-dark); }
        .timeline-btn.danger { border-color: var(--danger); background: rgba(239, 68, 68, 0.2); color: var(--danger); }
        .timeline-btn.danger:hover { background: var(--danger); color: white; }
        
        #waveform { height: 80px; background: rgba(15, 23, 42, 0.5); border-radius: 8px; margin-top: 8px; }
        .time-display {
            font-family: 'JetBrains Mono', monospace; font-size: 14px; color: var(--text-muted);
            display: flex; gap: 16px;
        }
        .time-display span { color: var(--primary); font-weight: 600; }
        
        /* Sidebar Panels */
        .panel {
            background: rgba(30, 41, 59, 0.7); border: 1px solid var(--border);
            border-radius: 12px; padding: 16px;
        }
        .panel-header {
            display: flex; align-items: center; gap: 8px; margin-bottom: 16px;
            font-weight: 600; color: var(--text); font-size: 14px;
        }
        .panel-header i { color: var(--primary); }
        
        /* Upload Area */
        .upload-area {
            border: 2px dashed var(--border); border-radius: 8px; padding: 24px;
            text-align: center; cursor: pointer; transition: all 0.2s;
        }
        .upload-area:hover { border-color: var(--primary); background: rgba(102, 126, 234, 0.05); }
        .upload-area.dragover { border-color: var(--primary); background: rgba(102, 126, 234, 0.1); }
        .upload-area i { font-size: 32px; color: var(--primary); margin-bottom: 8px; }
        .upload-area p { font-size: 13px; color: var(--text-muted); }
        .upload-area input { display: none; }
        
        /* Form Elements */
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px; }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%; padding: 10px 12px; background: rgba(15, 23, 42, 0.5);
            border: 1px solid var(--border); border-radius: 6px; color: var(--text);
            font-size: 13px; outline: none; transition: border-color 0.2s;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--primary); }
        .form-group input[type="color"] { padding: 4px; height: 36px; cursor: pointer; }
        .form-group input[type="range"] { padding: 0; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        
        /* Layer List */
        .layer-list { max-height: 200px; overflow-y: auto; }
        .layer-item {
            display: flex; align-items: center; gap: 8px; padding: 10px;
            background: rgba(15, 23, 42, 0.5); border-radius: 6px; margin-bottom: 8px;
            cursor: pointer; transition: all 0.2s;
        }
        .layer-item:hover { background: rgba(102, 126, 234, 0.1); }
        .layer-item.active { border: 1px solid var(--primary); }
        .layer-item i { color: var(--primary); width: 16px; }
        .layer-item span { flex: 1; font-size: 13px; }
        .layer-item .layer-actions { display: flex; gap: 4px; opacity: 0; transition: opacity 0.2s; }
        .layer-item:hover .layer-actions { opacity: 1; }
        .layer-btn {
            padding: 4px 8px; background: transparent; border: none; color: var(--text-muted);
            cursor: pointer; border-radius: 4px; font-size: 12px;
        }
        .layer-btn:hover { color: var(--danger); background: rgba(239, 68, 68, 0.1); }
        
        /* Export Progress */
        .export-progress {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.8); display: none; align-items: center; justify-content: center;
            z-index: 1000;
        }
        .export-progress.active { display: flex; }
        .export-modal {
            background: var(--dark-light); border: 1px solid var(--border);
            border-radius: 16px; padding: 32px; text-align: center; min-width: 300px;
        }
        .export-modal i { font-size: 48px; color: var(--primary); margin-bottom: 16px; }
        .export-modal h3 { margin-bottom: 8px; }
        .export-modal p { color: var(--text-muted); margin-bottom: 20px; }
        .progress-bar {
            height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden;
        }
        .progress-fill {
            height: 100%; background: linear-gradient(90deg, var(--primary), var(--primary-dark));
            border-radius: 4px; transition: width 0.3s ease; width: 0%;
        }
        
        /* Notification */
        .notification-container { position: fixed; top: 20px; right: 20px; z-index: 1001; }
        .notification {
            padding: 16px 20px; background: rgba(30,41,59,0.98); border-radius: 8px;
            margin-bottom: 8px; border-left: 4px solid; animation: slideInRight 0.3s ease;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }
        @keyframes slideInRight {
            from { opacity: 0; transform: translateX(100%); }
            to { opacity: 1; transform: translateX(0); }
        }
        .notification.success { border-left-color: var(--success); }
        .notification.error { border-left-color: var(--danger); }
        .notification.info { border-left-color: var(--info); }
        
        /* Responsive */
        @media (max-width: 1200px) {
            .editor-container { grid-template-columns: 1fr; }
            .editor-sidebar { flex-direction: row; flex-wrap: wrap; }
            .panel { flex: 1; min-width: 280px; }
        }
        @media (max-width: 768px) {
            .sidebar { display: none; }
            .main { margin-left: 0; }
            .editor-container { height: auto; }
        }
        
        /* Range slider styling */
        input[type="range"] {
            -webkit-appearance: none; appearance: none; width: 100%; height: 6px;
            background: rgba(255,255,255,0.1); border-radius: 3px; outline: none;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none; appearance: none; width: 16px; height: 16px;
            background: var(--primary); border-radius: 50%; cursor: pointer;
        }
        input[type="range"]::-moz-range-thumb {
            width: 16px; height: 16px; background: var(--primary); border-radius: 50%; cursor: pointer; border: none;
        }
        
        /* Preview button */
        .preview-btn {
            position: absolute; bottom: 16px; right: 16px;
            padding: 12px 24px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none; border-radius: 8px; color: white; font-weight: 600;
            cursor: pointer; display: flex; align-items: center; gap: 8px;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            transition: all 0.2s;
        }
        .preview-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5); }
        .preview-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        
        /* Image preview in panel */
        .image-preview {
            width: 100%; height: 100px; object-fit: cover; border-radius: 6px;
            border: 1px solid var(--border); margin-top: 8px;
        }
        
        /* Tabs */
        .tabs { display: flex; gap: 4px; margin-bottom: 16px; }
        .tab {
            padding: 8px 16px; background: rgba(15, 23, 42, 0.5); border: none;
            border-radius: 6px; color: var(--text-muted); cursor: pointer; font-size: 13px;
            transition: all 0.2s;
        }
        .tab:hover { color: var(--text); }
        .tab.active { background: var(--primary); color: white; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body>
    <div class="container">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="logo">
                <div class="logo-icon">🎬</div>
                <div>
                    <h1 style="font-size: 18px; margin: 0;">Video Editor</h1>
                    <p style="font-size: 11px; color: #94a3b8; margin: 4px 0 0 0;">Mission Control</p>
                </div>
            </div>
            <ul class="nav">
                <li><a href="total-control.html"><i class="fas fa-home"></i> Oversikt</a></li>
                <li><a href="sakslista-pro.html"><i class="fas fa-list"></i> Saker</a></li>
                <li><a href="analytics.html"><i class="fas fa-chart-line"></i> Analyse</a></li>
                <li><a href="ai-assistant.html"><i class="fas fa-robot"></i> AI Assistant</a></li>
                <li><a href="podkast-control.html"><i class="fas fa-podcast"></i> Podkast</a></li>
                <li><a href="video-editor.html" class="active"><i class="fas fa-video"></i> Video Editor</a></li>
                <li><a href="cron-control.html"><i class="fas fa-clock"></i> Cron</a></li>
                <li><a href="system-monitor.html"><i class="fas fa-heartbeat"></i> System</a></li>
                <li><a href="innstillinger.html"><i class="fas fa-cog"></i> Innstillinger</a></li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main">
            <div class="header">
                <h2><i class="fas fa-film"></i> Video Editor</h2>
                <div style="display: flex; gap: 12px;">
                    <button class="timeline-btn" onclick="resetEditor()">
                        <i class="fas fa-trash"></i> Nullstill
                    </button>
                    <button class="timeline-btn primary" onclick="exportVideo()" id="exportBtn" disabled>
                        <i class="fas fa-download"></i> Eksporter MP4
                    </button>
                </div>
            </div>

            <div class="editor-container">
                <!-- Main Editor Area -->
                <div class="editor-main">
                    <!-- Canvas -->
                    <div class="canvas-container" id="canvasContainer">
                        <div class="canvas-placeholder" id="placeholder">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <h3>Last opp media</h3>
                            <p>Dra og slipp MP3/MP4, eller bruk panelet til høyre</p>
                        </div>
                        <canvas id="videoCanvas" width="1280" height="720" style="display: none;"></canvas>
                        <button class="preview-btn" id="previewBtn" onclick="togglePreview()" disabled>
                            <i class="fas fa-play"></i> <span id="previewText">Forhåndsvis</span>
                        </button>
                    </div>

                    <!-- Timeline -->
                    <div class="timeline-container">
                        <div class="timeline-header">
                            <div class="timeline-controls">
                                <button class="timeline-btn" onclick="seekToStart()">
                                    <i class="fas fa-step-backward"></i>
                                </button>
                                <button class="timeline-btn primary" onclick="togglePlay()" id="playBtn" disabled>
                                    <i class="fas fa-play" id="playIcon"></i>
                                </button>
                                <button class="timeline-btn" onclick="seekToEnd()">
                                    <i class="fas fa-step-forward"></i>
                                </button>
                            </div>
                            <div class="time-display">
                                <div>Nå: <span id="currentTime">00:00</span></div>
                                <div>Total: <span id="totalTime">00:00</span></div>
                            </div>
                        </div>
                        <div id="waveform"></div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="editor-sidebar">
                    <!-- Media Upload -->
                    <div class="panel">
                        <div class="panel-header"><i class="fas fa-upload"></i> Media</div>
                        <div class="upload-area" id="uploadArea" onclick="document.getElementById('fileInput').click()">
                            <i class="fas fa-music"></i>
                            <p>Klikk for å laste opp MP3/MP4</p>
                            <input type="file" id="fileInput" accept="audio/mp3,audio/mpeg,video/mp4,audio/wav,audio/webm" onchange="handleFileSelect(event)">
                        </div>
                        <div id="mediaInfo" style="margin-top: 12px; display: none;">
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 13px;">
                                <i class="fas fa-file-audio" style="color: var(--primary);"></i>
                                <span id="mediaName" style="flex: 1; overflow: hidden; text-overflow: ellipsis;"></span>
                                <button class="layer-btn" onclick="removeMedia()" title="Fjern">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Tabs for Images/Text -->
                    <div class="panel">
                        <div class="tabs">
                            <button class="tab active" onclick="switchTab('images')">Bilder</button>
                            <button class="tab" onclick="switchTab('text')">Tekst</button>
                        </div>
                        
                        <!-- Images Tab -->
                        <div class="tab-content active" id="imagesTab">
                            <div class="upload-area" onclick="document.getElementById('imageInput').click()">
                                <i class="fas fa-image"></i>
                                <p>Legg til bilde</p>
                                <input type="file" id="imageInput" accept="image/*" onchange="handleImageUpload(event)">
                            </div>
                            <div class="form-group" style="margin-top: 12px;">
                                <label>Eller bilde-URL:</label>
                                <div style="display: flex; gap: 8px;">
                                    <input type="text" id="imageUrl" placeholder="https://..." style="flex: 1;">
                                    <button class="timeline-btn" onclick="addImageFromUrl()">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Text Tab -->
                        <div class="tab-content" id="textTab">
                            <div class="form-group">
                                <label>Tekst:</label>
                                <textarea id="textContent" rows="2" placeholder="Skriv tekst her..."></textarea>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Font:</label>
                                    <select id="textFont">
                                        <option value="Arial">Arial</option>
                                        <option value="Helvetica">Helvetica</option>
                                        <option value="Georgia">Georgia</option>
                                        <option value="Impact">Impact</option>
                                        <option value="Comic Sans MS">Comic Sans</option>
                                        <option value="Courier New">Courier</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Størrelse:</label>
                                    <input type="number" id="textSize" value="48" min="12" max="200">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Farge:</label>
                                    <input type="color" id="textColor" value="#ffffff">
                                </div>
                                <div class="form-group">
                                    <label>Posisjon:</label>
                                    <select id="textPosition">
                                        <option value="center">Midten</option>
                                        <option value="top">Topp</option>
                                        <option value="bottom">Bunn</option>
                                        <option value="left">Venstre</option>
                                        <option value="right">Høyre</option>
                                    </select>
                                </div>
                            </div>
                            <button class="timeline-btn primary" onclick="addTextLayer()" style="width: 100%; margin-top: 8px;">
                                <i class="fas fa-plus"></i> Legg til tekst
                            </button>
                        </div>
                    </div>

                    <!-- Layers -->
                    <div class="panel">
                        <div class="panel-header"><i class="fas fa-layer-group"></i> Lag</div>
                        <div class="layer-list" id="layerList">
                            <p style="color: var(--text-muted); font-size: 13px; text-align: center;">Ingen lag ennå</p>
                        </div>
                    </div>

                    <!-- Layer Properties -->
                    <div class="panel" id="propertiesPanel" style="display: none;">
                        <div class="panel-header"><i class="fas fa-sliders-h"></i> Egenskaper</div>
                        <div id="layerProperties">
                            <!-- Dynamic content based on selected layer -->
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Export Progress Modal -->
    <div class="export-progress" id="exportModal">
        <div class="export-modal">
            <i class="fas fa-cog fa-spin"></i>
            <h3>Eksporterer video...</h3>
            <p id="exportStatus">Initialiserer...</p>
            <div class="progress-bar">
                <div class="progress-fill" id="exportProgress"></div>
            </div>
        </div>
    </div>

    <!-- Notification Container -->
    <div class="notification-container" id="notifications"></div>

    <script>
        // Global state
        let audioContext = null;
        let audioBuffer = null;
        let audioSource = null;
        let isPlaying = false;
        let startTime = 0;
        let pauseTime = 0;
        let duration = 0;
        let animationId = null;
        let waveform = null;
        
        // Canvas and layers
        const canvas = document.getElementById('videoCanvas');
        const ctx = canvas.getContext('2d');
        let layers = [];
        let selectedLayer = null;
        let mediaFile = null;
        
        // Video dimensions (16:9)
        const VIDEO_WIDTH = 1280;
        const VIDEO_HEIGHT = 720;
        
        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            initWaveform();
            setupDragAndDrop();
        });
        
        // Initialize waveform
        function initWaveform() {
            waveform = WaveSurfer.create({
                container: '#waveform',
                waveColor: '#667eea',
                progressColor: '#764ba2',
                cursorColor: '#ffffff',
                barWidth: 2,
                barGap: 1,
                height: 80,
                responsive: true,
                backend: 'WebAudio'
            });
            
            waveform.on('ready', () => {
                duration = waveform.getDuration();
                document.getElementById('totalTime').textContent = formatTime(duration);
            });
            
            waveform.on('audioprocess', () => {
                document.getElementById('currentTime').textContent = formatTime(waveform.getCurrentTime());
                renderFrame();
            });
            
            waveform.on('seek', () => {
                renderFrame();
            });
        }
        
        // Setup drag and drop
        function setupDragAndDrop() {
            const uploadArea = document.getElementById('uploadArea');
            const canvasContainer = document.getElementById('canvasContainer');
            
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                uploadArea.addEventListener(eventName, preventDefaults, false);
                canvasContainer.addEventListener(eventName, preventDefaults, false);
            });
            
            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }
            
            ['dragenter', 'dragover'].forEach(eventName => {
                uploadArea.addEventListener(eventName, () => uploadArea.classList.add('dragover'), false);
                canvasContainer.addEventListener(eventName, () => canvasContainer.style.borderColor = 'var(--primary)', false);
            });
            
            ['dragleave', 'drop'].forEach(eventName => {
                uploadArea.addEventListener(eventName, () => uploadArea.classList.remove('dragover'), false);
                canvasContainer.addEventListener(eventName, () => canvasContainer.style.borderColor = '', false);
            });
            
            uploadArea.addEventListener('drop', handleDrop, false);
            canvasContainer.addEventListener('drop', handleDrop, false);
        }
        
        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            if (files.length > 0) {
                handleFile(files[0]);
            }
        }
        
        // File handling
        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (file) handleFile(file);
        }
        
        function handleFile(file) {
            if (!file.type.match(/audio|video/)) {
                showNotification('Kun MP3/MP4 filer støttes', 'error');
                return;
            }
            
            mediaFile = file;
            document.getElementById('mediaName').textContent = file.name;
            document.getElementById('mediaInfo').style.display = 'block';
            
            const url = URL.createObjectURL(file);
            waveform.load(url);
            
            // Show canvas, hide placeholder
            document.getElementById('placeholder').style.display = 'none';
            canvas.style.display = 'block';
            
            // Enable buttons
            document.getElementById('playBtn').disabled = false;
            document.getElementById('previewBtn').disabled = false;
            document.getElementById('exportBtn').disabled = false;
            
            showNotification(`Lastet opp: ${file.name}`, 'success');
            
            // Initial render
            renderFrame();
        }
        
        function removeMedia() {
            waveform.empty();
            mediaFile = null;
            document.getElementById('mediaInfo').style.display = 'none';
            document.getElementById('placeholder').style.display = 'flex';
            canvas.style.display = 'none';
            document.getElementById('playBtn').disabled = true;
            document.getElementById('previewBtn').disabled = true;
            document.getElementById('exportBtn').disabled = true;
            document.getElementById('currentTime').textContent = '00:00';
            document.getElementById('totalTime').textContent = '00:00';
        }
        
        // Playback controls
        function togglePlay() {
            if (!waveform) return;
            
            if (isPlaying) {
                waveform.pause();
                isPlaying = false;
                document.getElementById('playIcon').className = 'fas fa-play';
                document.getElementById('previewText').textContent = 'Fortsett';
                cancelAnimationFrame(animationId);
            } else {
                waveform.play();
                isPlaying = true;
                document.getElementById('playIcon').className = 'fas fa-pause';
                document.getElementById('previewText').textContent = 'Pause';
                startRenderLoop();
            }
        }
        
        function togglePreview() {
            togglePlay();
        }
        
        function seekToStart() {
            if (waveform) {
                waveform.seekTo(0);
                renderFrame();
            }
        }
        
        function seekToEnd() {
            if (waveform) {
                waveform.seekTo(1);
                renderFrame();
            }
        }
        
        // Render loop
        function startRenderLoop() {
            function loop() {
                if (isPlaying) {
                    renderFrame();
                    animationId = requestAnimationFrame(loop);
                }
            }
            loop();
        }
        
        // Render frame to canvas
        function renderFrame() {
            // Clear canvas with background
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(0, 0, VIDEO_WIDTH, VIDEO_HEIGHT);
            
            // Draw gradient background
            const gradient = ctx.createLinearGradient(0, 0, VIDEO_WIDTH, VIDEO_HEIGHT);
            gradient.addColorStop(0, '#0f172a');
            gradient.addColorStop(0.5, '#1e293b');
            gradient.addColorStop(1, '#0f172a');
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, VIDEO_WIDTH, VIDEO_HEIGHT);
            
            // Draw animated waveform visualization
            if (isPlaying) {
                drawAudioVisualization();
            }
            
            // Draw layers
            layers.forEach(layer => {
                if (layer.type === 'image') {
                    drawImageLayer(layer);
                } else if (layer.type === 'text') {
                    drawTextLayer(layer);
                }
            });
            
            // Draw progress indicator
            if (duration > 0) {
                const progress = waveform.getCurrentTime() / duration;
                ctx.fillStyle = 'rgba(102, 126, 234, 0.8)';
                ctx.fillRect(0, VIDEO_HEIGHT - 4, VIDEO_WIDTH * progress, 4);
            }
        }
        
        // Audio visualization
        function drawAudioVisualization() {
            const bars = 64;
            const barWidth = VIDEO_WIDTH / bars;
            const time = Date.now() / 1000;
            
            for (let i = 0; i < bars; i++) {
                const height = Math.sin(time * 2 + i * 0.2) * 50 + 60;
                const x = i * barWidth;
                const y = VIDEO_HEIGHT / 2 - height / 2;
                
                const barGradient = ctx.createLinearGradient(0, y, 0, y + height);
                barGradient.addColorStop(0, 'rgba(102, 126, 234, 0.3)');
                barGradient.addColorStop(0.5, 'rgba(118, 75, 162, 0.5)');
                barGradient.addColorStop(1, 'rgba(102, 126, 234, 0.3)');
                
                ctx.fillStyle = barGradient;
                ctx.fillRect(x + 2, y, barWidth - 4, height);
            }
        }
        
        // Draw image layer
        function drawImageLayer(layer) {
            if (!layer.img) return;
            
            const x = layer.x || VIDEO_WIDTH / 2 - layer.width / 2;
            const y = layer.y || VIDEO_HEIGHT / 2 - layer.height / 2;
            
            ctx.save();
            ctx.globalAlpha = layer.opacity || 1;
            
            if (layer.shadow) {
                ctx.shadowColor = 'rgba(0,0,0,0.5)';
                ctx.shadowBlur = 20;
                ctx.shadowOffsetX = 5;
                ctx.shadowOffsetY = 5;
            }
            
            ctx.drawImage(layer.img, x, y, layer.width, layer.height);
            ctx.restore();
        }
        
        // Draw text layer
        function drawTextLayer(layer) {
            ctx.save();
            ctx.font = `${layer.size}px ${layer.font}`;
            ctx.fillStyle = layer.color;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            
            // Calculate position
            let x = VIDEO_WIDTH / 2;
            let y = VIDEO_HEIGHT / 2;
            
            switch (layer.position) {
                case 'top': y = VIDEO_HEIGHT * 0.15; break;
                case 'bottom': y = VIDEO_HEIGHT * 0.85; break;
                case 'left': x = VIDEO_WIDTH * 0.2; ctx.textAlign = 'left'; break;
                case 'right': x = VIDEO_WIDTH * 0.8; ctx.textAlign = 'right'; break;
            }
            
            // Draw shadow
            ctx.shadowColor = 'rgba(0,0,0,0.8)';
            ctx.shadowBlur = 10;
            ctx.shadowOffsetX = 2;
            ctx.shadowOffsetY = 2;
            
            // Draw text
            ctx.fillText(layer.text, x, y);
            
            ctx.restore();
        }
        
        // Tab switching
        function switchTab(tab) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            
            event.target.classList.add('active');
            document.getElementById(tab + 'Tab').classList.add('active');
        }
        
        // Image handling
        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            const reader = new FileReader();
            reader.onload = (e) => {
                addImageLayer(e.target.result, file.name);
            };
            reader.readAsDataURL(file);
        }
        
        function addImageFromUrl() {
            const url = document.getElementById('imageUrl').value.trim();
            if (!url) {
                showNotification('Vennligst skriv inn en URL', 'error');
                return;
            }
            addImageLayer(url, 'Bilde fra URL');
            document.getElementById('imageUrl').value = '';
        }
        
        function addImageLayer(src, name) {
            const img = new Image();
            img.onload = () => {
                const layer = {
                    id: Date.now(),
                    type: 'image',
                    name: name,
                    img: img,
                    src: src,
                    x: VIDEO_WIDTH / 2 - 200,
                    y: VIDEO_HEIGHT / 2 - 150,
                    width: 400,
                    height: 300,
                    opacity: 1,
                    shadow: true
                };
                
                // Maintain aspect ratio
                const aspectRatio = img.width / img.height;
                if (aspectRatio > 1) {
                    layer.height = layer.width / aspectRatio;
                } else {
                    layer.width = layer.height * aspectRatio;
                }
                
                layers.push(layer);
                updateLayerList();
                selectLayer(layer.id);
                renderFrame();
                showNotification('Bilde lagt til', 'success');
            };
            img.src = src;
        }
        
        // Text handling
        function addTextLayer() {
            const text = document.getElementById('textContent').value.trim();
            if (!text) {
                showNotification('Vennligst skriv inn tekst', 'error');
                return;
            }
            
            const layer = {
                id: Date.now(),
                type: 'text',
                name: `Tekst: "${text.substring(0, 20)}${text.length > 20 ? '...' : ''}"`,
                text: text,
                font: document.getElementById('textFont').value,
                size: parseInt(document.getElementById('textSize').value),
                color: document.getElementById('textColor').value,
                position: document.getElementById('textPosition').value
            };
            
            layers.push(layer);
            updateLayerList();
            selectLayer(layer.id);
            renderFrame();
            
            // Clear input
            document.getElementById('textContent').value = '';
            showNotification('Tekst lagt til', 'success');
        }
        
        // Layer management
        function updateLayerList() {
            const list = document.getElementById('layerList');
            if (layers.length === 0) {
                list.innerHTML = '<p style="color: var(--text-muted); font-size: 13px; text-align: center;">Ingen lag ennå</p>';
                return;
            }
            
            list.innerHTML = layers.map((layer, index) => `
                <div class="layer-item ${selectedLayer === layer.id ? 'active' : ''}" onclick="selectLayer(${layer.id})">
                    <i class="fas fa-${layer.type === 'image' ? 'image' : 'font'}"></i>
                    <span>${layer.name}</span>
                    <div class="layer-actions">
                        <button class="layer-btn" onclick="moveLayer(${index}, -1); event.stopPropagation();" title="Flytt opp">
                            <i class="fas fa-arrow-up"></i>
                        </button>
                        <button class="layer-btn" onclick="moveLayer(${index}, 1); event.stopPropagation();" title="Flytt ned">
                            <i class="fas fa-arrow-down"></i>
                        </button>
                        <button class="layer-btn" onclick="deleteLayer(${layer.id}); event.stopPropagation();" title="Slett">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `).reverse().join('');
        }
        
        function selectLayer(id) {
            selectedLayer = id;
            updateLayerList();
            showLayerProperties(id);
        }
        
        function showLayerProperties(id) {
            const layer = layers.find(l => l.id === id);
            if (!layer) {
                document.getElementById('propertiesPanel').style.display = 'none';
                return;
            }
            
            document.getElementById('propertiesPanel').style.display = 'block';
            const container = document.getElementById('layerProperties');
            
            if (layer.type === 'image') {
                container.innerHTML = `
                    <img loading="lazy" src="${layer.src}" class="image-preview">
                    <div class="form-group">
                        <label>Posisjon X:</label>
                        <input type="range" min="0" max="${VIDEO_WIDTH}" value="${layer.x}" oninput="updateLayerProp(${id}, 'x', this.value)">
                    </div>
                    <div class="form-group">
                        <label>Posisjon Y:</label>
                        <input type="range" min="0" max="${VIDEO_HEIGHT}" value="${layer.y}" oninput="updateLayerProp(${id}, 'y', this.value)">
                    </div>
                    <div class="form-group">
                        <label>Bredde:</label>
                        <input type="range" min="50" max="${VIDEO_WIDTH}" value="${layer.width}" oninput="updateLayerProp(${id}, 'width', this.value)">
                    </div>
                    <div class="form-group">
                        <label>Gjennomsiktighet:</label>
                        <input type="range" min="0" max="1" step="0.1" value="${layer.opacity}" oninput="updateLayerProp(${id}, 'opacity', this.value)">
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" ${layer.shadow ? 'checked' : ''} onchange="updateLayerProp(${id}, 'shadow', this.checked)">
                            Skygge
                        </label>
                    </div>
                `;
            } else if (layer.type === 'text') {
                container.innerHTML = `
                    <div class="form-group">
                        <label>Tekst:</label>
                        <textarea oninput="updateLayerProp(${id}, 'text', this.value)">${layer.text}</textarea>
                    </div>
                    <div class="form-group">
                        <label>Font:</label>
                        <select onchange="updateLayerProp(${id}, 'font', this.value)">
                            ${['Arial', 'Helvetica', 'Georgia', 'Impact', 'Comic Sans MS', 'Courier New'].map(f => 
                                `<option value="${f}" ${layer.font === f ? 'selected' : ''}>${f}</option>`
                            ).join('')}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Størrelse:</label>
                        <input type="range" min="12" max="200" value="${layer.size}" oninput="updateLayerProp(${id}, 'size', this.value)">
                    </div>
                    <div class="form-group">
                        <label>Farge:</label>
                        <input type="color" value="${layer.color}" oninput="updateLayerProp(${id}, 'color', this.value)">
                    </div>
                    <div class="form-group">
                        <label>Posisjon:</label>
                        <select onchange="updateLayerProp(${id}, 'position', this.value)">
                            ${['center', 'top', 'bottom', 'left', 'right'].map(p => 
                                `<option value="${p}" ${layer.position === p ? 'selected' : ''}>${p}</option>`
                            ).join('')}
                        </select>
                    </div>
                `;
            }
        }
        
        function updateLayerProp(id, prop, value) {
            const layer = layers.find(l => l.id === id);
            if (layer) {
                if (prop === 'shadow') {
                    layer[prop] = value;
                } else if (['x', 'y', 'width', 'opacity', 'size'].includes(prop)) {
                    layer[prop] = parseFloat(value);
                } else {
                    layer[prop] = value;
                }
                
                if (prop === 'text' || prop === 'width') {
                    layer.name = layer.type === 'image' 
                        ? layer.name 
                        : `Tekst: "${layer.text.substring(0, 20)}${layer.text.length > 20 ? '...' : ''}"`;
                    updateLayerList();
                }
                
                renderFrame();
            }
        }
        
        function moveLayer(index, direction) {
            const newIndex = index + direction;
            if (newIndex >= 0 && newIndex < layers.length) {
                [layers[index], layers[newIndex]] = [layers[newIndex], layers[index]];
                updateLayerList();
                renderFrame();
            }
        }
        
        function deleteLayer(id) {
            layers = layers.filter(l => l.id !== id);
            if (selectedLayer === id) {
                selectedLayer = null;
                document.getElementById('propertiesPanel').style.display = 'none';
            }
            updateLayerList();
            renderFrame();
            showNotification('Lag slettet', 'info');
        }
        
        // Export video
        async function exportVideo() {
            if (!mediaFile) {
                showNotification('Ingen media lastet opp', 'error');
                return;
            }
            
            const modal = document.getElementById('exportModal');
            const progress = document.getElementById('exportProgress');
            const status = document.getElementById('exportStatus');
            
            modal.classList.add('active');
            status.textContent = 'Forbereder eksport...';
            progress.style.width = '0%';
            
            try {
                // Create MediaRecorder
                const stream = canvas.captureStream(30);
                const audioElement = document.createElement('audio');
                audioElement.src = URL.createObjectURL(mediaFile);
                
                // Wait for audio to load
                await new Promise((resolve, reject) => {
                    audioElement.onloadedmetadata = resolve;
                    audioElement.onerror = reject;
                    audioElement.load();
                });
                
                // Add audio to stream if possible
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const source = audioContext.createMediaElementSource(audioElement);
                const dest = audioContext.createMediaStreamDestination();
                source.connect(dest);
                source.connect(audioContext.destination);
                
                dest.stream.getAudioTracks().forEach(track => stream.addTrack(track));
                
                const mediaRecorder = new MediaRecorder(stream, {
                    mimeType: 'video/webm;codecs=vp9,opus'
                });
                
                const chunks = [];
                mediaRecorder.ondataavailable = (e) => {
                    if (e.data.size > 0) chunks.push(e.data);
                };
                
                mediaRecorder.onstop = () => {
                    const blob = new Blob(chunks, { type: 'video/webm' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `video-export-${Date.now()}.webm`;
                    a.click();
                    URL.revokeObjectURL(url);
                    
                    modal.classList.remove('active');
                    showNotification('Video eksportert!', 'success');
                };
                
                // Start recording
                mediaRecorder.start(100);
                audioElement.play();
                
                // Update progress
                const duration = audioElement.duration * 1000;
                const startTime = Date.now();
                
                const progressInterval = setInterval(() => {
                    const elapsed = Date.now() - startTime;
                    const percent = Math.min((elapsed / duration) * 100, 100);
                    progress.style.width = percent + '%';
                    status.textContent = `Eksporterer... ${Math.round(percent)}%`;
                    
                    // Render frame
                    renderFrame();
                    
                    if (elapsed >= duration) {
                        clearInterval(progressInterval);
                        mediaRecorder.stop();
                        audioElement.pause();
                    }
                }, 100);
                
            } catch (error) {
                console.error('Export error:', error);
                modal.classList.remove('active');
                showNotification('Eksport feilet: ' + error.message, 'error');
            }
        }
        
        // Reset editor
        function resetEditor() {
            if (confirm('Er du sikker på at du vil nullstille editoren?')) {
                removeMedia();
                layers = [];
                selectedLayer = null;
                updateLayerList();
                document.getElementById('propertiesPanel').style.display = 'none';
                showNotification('Editor nullstilt', 'info');
            }
        }
        
        // Utilities
        function formatTime(seconds) {
            if (isNaN(seconds)) return '00:00';
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }
        
        function showNotification(message, type = 'info') {
            const container = document.getElementById('notifications');
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.innerHTML = `
                <div style="display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i>
                    <span>${message}</span>
                </div>
            `;
            container.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }
    </script>
</body>
</html>
