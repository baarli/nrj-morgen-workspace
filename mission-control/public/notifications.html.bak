<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notification Center - Mission Control</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #667eea; --primary-dark: #764ba2; --success: #10b981;
            --warning: #f59e0b; --danger: #ef4444; --info: #3b82f6;
            --dark: #0f172a; --dark-light: #1e293b; --text: #e2e8f0;
            --text-muted: #94a3b8; --text-dim: #64748b;
            --critical: #dc2626; --high: #ea580c; --medium: #ca8a04; --low: #16a34a;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, var(--dark) 0%, var(--dark-light) 100%);
            color: var(--text); min-height: 100vh;
        }
        .container { display: flex; min-height: 100vh; }
        .sidebar {
            width: 280px; background: rgba(30, 41, 59, 0.98); padding: 24px;
            border-right: 1px solid rgba(255,255,255,0.1); position: fixed;
            height: 100vh; overflow-y: auto; z-index: 100;
        }
        .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .logo-icon { width: 48px; height: 48px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .nav { list-style: none; }
        .nav li { margin-bottom: 8px; }
        .nav a { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; color: var(--text-muted); text-decoration: none; transition: all 0.2s; }
        .nav a:hover, .nav a.active { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; }
        .nav-badge { margin-left: auto; background: var(--danger); color: white; padding: 2px 8px; border-radius: 10px; font-size: 11px; }
        .main { flex: 1; margin-left: 280px; padding: 32px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
        .header h2 { font-size: 28px; }
        .header-actions { display: flex; gap: 12px; }
        .btn { padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
        .btn:hover { transform: translateY(-1px); opacity: 0.9; }
        .btn-primary { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; }
        .btn-success { background: var(--success); color: white; }
        .btn-danger { background: var(--danger); color: white; }
        .btn-warning { background: var(--warning); color: white; }
        .btn-secondary { background: rgba(255,255,255,0.1); color: white; }
        .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid rgba(255,255,255,0.1); }
        .btn-ghost:hover { background: rgba(255,255,255,0.05); color: white; }
        .btn-sm { padding: 6px 12px; font-size: 12px; }

        /* Tab Navigation */
        .tab-nav { display: flex; gap: 4px; padding: 4px; background: rgba(15, 23, 42, 0.5); border-radius: 12px; margin-bottom: 24px; overflow-x: auto; }
        .tab-btn { padding: 12px 20px; border: none; background: transparent; color: var(--text-muted); font-size: 14px; font-weight: 500; cursor: pointer; border-radius: 8px; transition: all 0.2s; white-space: nowrap; display: flex; align-items: center; gap: 8px; }
        .tab-btn:hover { color: var(--text); }
        .tab-btn.active { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.3s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Stats Grid */
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px; }
        .stat-card { background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 20px; text-align: center; }
        .stat-card h3 { font-size: 12px; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
        .stat-card .value { font-size: 32px; font-weight: bold; margin-bottom: 4px; }
        .stat-card .label { font-size: 13px; color: var(--text-dim); }
        .stat-card .trend { font-size: 12px; margin-top: 8px; display: flex; align-items: center; justify-content: center; gap: 4px; }
        .trend.up { color: var(--success); }
        .trend.down { color: var(--danger); }

        /* Cards */
        .card { background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 24px; margin-bottom: 24px; }
        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .card-title { font-size: 18px; font-weight: 600; display: flex; align-items: center; gap: 10px; }
        .card-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; }

        /* Notification Hub */
        .notification-hub { display: grid; grid-template-columns: 1fr 350px; gap: 24px; }
        .notification-list { max-height: 600px; overflow-y: auto; }
        .notification-item { display: flex; gap: 16px; padding: 16px; background: rgba(15, 23, 42, 0.5); border-radius: 10px; margin-bottom: 12px; border-left: 4px solid transparent; transition: all 0.2s; cursor: pointer; }
        .notification-item:hover { background: rgba(15, 23, 42, 0.8); transform: translateX(4px); }
        .notification-item.unread { border-left-color: var(--primary); }
        .notification-item.critical { border-left-color: var(--critical); }
        .notification-item.high { border-left-color: var(--high); }
        .notification-item.medium { border-left-color: var(--medium); }
        .notification-item.low { border-left-color: var(--low); }
        .notification-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
        .notification-icon.email { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
        .notification-icon.slack { background: rgba(139, 92, 246, 0.2); color: #a78bfa; }
        .notification-icon.discord { background: rgba(99, 102, 241, 0.2); color: #818cf8; }
        .notification-icon.push { background: rgba(16, 185, 129, 0.2); color: #34d399; }
        .notification-icon.alert { background: rgba(239, 68, 68, 0.2); color: #f87171; }
        .notification-icon.system { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
        .notification-content { flex: 1; }
        .notification-title { font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
        .notification-message { font-size: 14px; color: var(--text-muted); margin-bottom: 8px; }
        .notification-meta { display: flex; gap: 16px; font-size: 12px; color: var(--text-dim); }
        .notification-actions { display: flex; gap: 8px; opacity: 0; transition: opacity 0.2s; }
        .notification-item:hover .notification-actions { opacity: 1; }
        .notification-actions button { background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 4px; border-radius: 4px; }
        .notification-actions button:hover { background: rgba(255,255,255,0.1); color: white; }

        /* Priority Badges */
        .priority-badge { padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 600; text-transform: uppercase; }
        .priority-critical { background: rgba(220, 38, 38, 0.2); color: #f87171; }
        .priority-high { background: rgba(234, 88, 12, 0.2); color: #fb923c; }
        .priority-medium { background: rgba(202, 138, 4, 0.2); color: #facc15; }
        .priority-low { background: rgba(22, 163, 74, 0.2); color: #4ade80; }

        /* Sidebar Widgets */
        .widget { background: rgba(15, 23, 42, 0.5); border-radius: 10px; padding: 16px; margin-bottom: 16px; }
        .widget-title { font-size: 14px; font-weight: 600; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .filter-item { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); cursor: pointer; }
        .filter-item:last-child { border-bottom: none; }
        .filter-item:hover { color: var(--primary); }
        .filter-checkbox { width: 18px; height: 18px; border-radius: 4px; border: 2px solid var(--text-muted); display: flex; align-items: center; justify-content: center; }
        .filter-checkbox.checked { background: var(--primary); border-color: var(--primary); }
        .filter-count { margin-left: auto; background: rgba(255,255,255,0.1); padding: 2px 8px; border-radius: 10px; font-size: 11px; }

        /* Settings Grid */
        .settings-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
        .setting-group { background: rgba(15, 23, 42, 0.5); border-radius: 10px; padding: 20px; }
        .setting-item { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .setting-item:last-child { border-bottom: none; }
        .setting-info h4 { font-size: 14px; margin-bottom: 4px; }
        .setting-info p { font-size: 12px; color: var(--text-muted); }

        /* Toggle Switch */
        .toggle { width: 48px; height: 24px; background: var(--text-muted); border-radius: 12px; position: relative; cursor: pointer; transition: background 0.2s; }
        .toggle.active { background: var(--success); }
        .toggle::after { content: ''; position: absolute; width: 20px; height: 20px; background: white; border-radius: 50%; top: 2px; left: 2px; transition: transform 0.2s; }
        .toggle.active::after { transform: translateX(24px); }

        /* Form Elements */
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; font-size: 14px; color: var(--text-muted); }
        .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 12px 16px; background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: white; font-size: 14px; outline: none; }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus { border-color: var(--primary); }
        .form-group textarea { min-height: 100px; resize: vertical; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

        /* Integration Cards */
        .integration-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .integration-card { background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 24px; text-align: center; transition: all 0.2s; }
        .integration-card:hover { border-color: var(--primary); transform: translateY(-2px); }
        .integration-card.connected { border-color: var(--success); }
        .integration-icon { width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 16px; }
        .integration-icon.slack { background: rgba(139, 92, 246, 0.2); color: #a78bfa; }
        .integration-icon.discord { background: rgba(99, 102, 241, 0.2); color: #818cf8; }
        .integration-icon.email { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
        .integration-icon.push { background: rgba(16, 185, 129, 0.2); color: #34d399; }
        .integration-icon.webhook { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
        .integration-icon.sms { background: rgba(236, 72, 153, 0.2); color: #f472b6; }
        .integration-status { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; font-size: 12px; margin-top: 12px; }
        .integration-status.connected { background: rgba(16, 185, 129, 0.2); color: var(--success); }
        .integration-status.disconnected { background: rgba(239, 68, 68, 0.2); color: var(--danger); }

        /* Templates */
        .template-list { display: grid; gap: 12px; }
        .template-item { display: flex; align-items: center; gap: 16px; padding: 16px; background: rgba(15, 23, 42, 0.5); border-radius: 10px; cursor: pointer; transition: all 0.2s; }
        .template-item:hover { background: rgba(15, 23, 42, 0.8); }
        .template-preview { flex: 1; }
        .template-preview h4 { font-size: 14px; margin-bottom: 4px; }
        .template-preview p { font-size: 12px; color: var(--text-muted); }
        .template-vars { display: flex; gap: 8px; flex-wrap: wrap; }
        .template-var { background: rgba(102, 126, 234, 0.2); color: var(--primary); padding: 2px 8px; border-radius: 4px; font-size: 11px; font-family: monospace; }

        /* Alert Rules */
        .rule-list { display: grid; gap: 12px; }
        .rule-item { display: flex; align-items: center; gap: 16px; padding: 16px; background: rgba(15, 23, 42, 0.5); border-radius: 10px; border-left: 4px solid var(--primary); }
        .rule-item.critical { border-left-color: var(--critical); }
        .rule-item.warning { border-left-color: var(--warning); }
        .rule-item.info { border-left-color: var(--info); }
        .rule-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; background: rgba(255,255,255,0.05); }
        .rule-content { flex: 1; }
        .rule-content h4 { font-size: 14px; margin-bottom: 4px; }
        .rule-content p { font-size: 12px; color: var(--text-muted); }
        .rule-condition { background: rgba(102, 126, 234, 0.1); padding: 4px 12px; border-radius: 20px; font-size: 12px; font-family: monospace; }
        .rule-actions { display: flex; gap: 8px; }

        /* Schedule Calendar */
        .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
        .calendar-header { text-align: center; padding: 12px; font-size: 12px; color: var(--text-muted); text-transform: uppercase; }
        .calendar-day { aspect-ratio: 1; background: rgba(15, 23, 42, 0.5); border-radius: 8px; padding: 8px; cursor: pointer; transition: all 0.2s; position: relative; }
        .calendar-day:hover { background: rgba(15, 23, 42, 0.8); }
        .calendar-day.today { border: 2px solid var(--primary); }
        .calendar-day.has-event::after { content: ''; position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%); width: 6px; height: 6px; background: var(--primary); border-radius: 50%; }
        .calendar-day-number { font-size: 14px; font-weight: 600; }
        .scheduled-notifications { margin-top: 24px; }
        .scheduled-item { display: flex; align-items: center; gap: 16px; padding: 12px; background: rgba(15, 23, 42, 0.5); border-radius: 8px; margin-bottom: 8px; }
        .scheduled-time { background: var(--primary); color: white; padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; }
        .scheduled-content { flex: 1; }
        .scheduled-content h4 { font-size: 14px; }
        .scheduled-content p { font-size: 12px; color: var(--text-muted); }

        /* Do Not Disturb */
        .dnd-panel { background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%); border: 1px solid rgba(102, 126, 234, 0.3); border-radius: 12px; padding: 24px; text-align: center; }
        .dnd-status { font-size: 48px; margin-bottom: 16px; }
        .dnd-toggle { width: 80px; height: 40px; background: var(--text-muted); border-radius: 20px; position: relative; cursor: pointer; transition: background 0.3s; margin: 20px auto; }
        .dnd-toggle.active { background: var(--primary); }
        .dnd-toggle::after { content: ''; position: absolute; width: 32px; height: 32px; background: white; border-radius: 50%; top: 4px; left: 4px; transition: transform 0.3s; box-shadow: 0 2px 8px rgba(0,0,0,0.2); }
        .dnd-toggle.active::after { transform: translateX(40px); }
        .dnd-schedule { display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: center; margin-top: 20px; }
        .dnd-exceptions { margin-top: 24px; text-align: left; }
        .exception-item { display: flex; align-items: center; gap: 12px; padding: 12px; background: rgba(15, 23, 42, 0.5); border-radius: 8px; margin-bottom: 8px; }

        /* History Timeline */
        .timeline { position: relative; padding-left: 30px; }
        .timeline::before { content: ''; position: absolute; left: 10px; top: 0; bottom: 0; width: 2px; background: rgba(255,255,255,0.1); }
        .timeline-item { position: relative; padding-bottom: 24px; }
        .timeline-item::before { content: ''; position: absolute; left: -24px; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: var(--primary); border: 2px solid var(--dark); }
        .timeline-item.success::before { background: var(--success); }
        .timeline-item.error::before { background: var(--danger); }
        .timeline-item.warning::before { background: var(--warning); }
        .timeline-time { font-size: 12px; color: var(--text-muted); margin-bottom: 4px; }
        .timeline-content { background: rgba(15, 23, 42, 0.5); padding: 16px; border-radius: 10px; }
        .timeline-content h4 { font-size: 14px; margin-bottom: 4px; }
        .timeline-content p { font-size: 13px; color: var(--text-muted); }

        /* Modal */
        .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; z-index: 1000; opacity: 0; visibility: hidden; transition: all 0.3s; }
        .modal-overlay.active { opacity: 1; visibility: visible; }
        .modal { background: var(--dark-light); border-radius: 16px; width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto; transform: scale(0.9); transition: transform 0.3s; }
        .modal-overlay.active .modal { transform: scale(1); }
        .modal-header { padding: 24px; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; }
        .modal-close { background: none; border: none; color: var(--text-muted); font-size: 24px; cursor: pointer; }
        .modal-body { padding: 24px; }
        .modal-footer { padding: 24px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: flex-end; gap: 12px; }

        /* Toast Notifications */
        .toast-container { position: fixed; top: 20px; right: 20px; z-index: 1001; display: flex; flex-direction: column; gap: 8px; }
        .toast { padding: 16px 20px; background: rgba(30, 41, 59, 0.98); border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); display: flex; align-items: center; gap: 12px; animation: slideIn 0.3s ease; min-width: 300px; border-left: 4px solid; }
        .toast.success { border-left-color: var(--success); }
        .toast.error { border-left-color: var(--danger); }
        .toast.warning { border-left-color: var(--warning); }
        .toast.info { border-left-color: var(--info); }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

        /* Responsive */
        @media (max-width: 1200px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } .notification-hub { grid-template-columns: 1fr; } .settings-grid { grid-template-columns: 1fr; } .integration-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 768px) { .sidebar { display: none; } .main { margin-left: 0; } .stats-grid { grid-template-columns: 1fr; } .integration-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="container">
        <!-- Standard Navigation Template - Copy this to all HTML files -->
<aside class="sidebar">
    <div class="logo">
        <div class="logo-icon">🚀</div>
        <div>
            <h1 style="font-size: 18px; margin: 0;">Mission Control</h1>
            <p style="font-size: 11px; color: #94a3b8; margin: 4px 0 0 0;">v3.0</p>
        </div>
    </div>
    <ul class="nav">
        <li><a href="total-control.html"><i class="fas fa-home"></i> Oversikt</a></li>
        <li><a href="sakslista-pro.html"><i class="fas fa-list"></i> Saker</a></li>
        <li><a href="analytics.html"><i class="fas fa-chart-line"></i> Analyse</a></li>
        <li><a href="ai-assistant.html"><i class="fas fa-robot"></i> AI Assistant</a></li>
        <li><a href="widget-dashboard.html"><i class="fas fa-th-large"></i> Widgets</a></li>
        <li><a href="podkast-control.html"><i class="fas fa-podcast"></i> Podkast</a></li>
        <li><a href="cron-control.html"><i class="fas fa-clock"></i> Cron</a></li>
        <li><a href="agent-control.html"><i class="fas fa-robot"></i> Agent</a></li>
        <li><a href="notifications.html" class="active"><i class="fas fa-bell"></i> Varsler</a></li>
        <li><a href="system-monitor.html"><i class="fas fa-heartbeat"></i> System</a></li>
        <li><a href="database-admin.html"><i class="fas fa-database"></i> Database</a></li>
        <li><a href="git-control.html"><i class="fas fa-code-branch"></i> Git</a></li>
        <li><a href="api-docs.html"><i class="fas fa-book"></i> API Docs</a></li>
        <li><a href="innstillinger.html"><i class="fas fa-cog"></i> Innstillinger</a></li>
    </ul>
</aside>

        <!-- Main Content -->
        <main class="main">
            <div class="header">
                <h2><i class="fas fa-bell" style="color: var(--primary);"></i> Notification Center</h2>
                <div class="header-actions">
                    <button class="btn btn-ghost" onclick="markAllRead()">
                        <i class="fas fa-check-double"></i> Mark All Read
                    </button>
                    <button class="btn btn-primary" onclick="openSendNotificationModal()">
                        <i class="fas fa-paper-plane"></i> Send Notification
                    </button>
                </div>
            </div>

            <!-- Tab Navigation -->
            <div class="tab-nav">
                <button class="tab-btn active" onclick="showTab('hub')">
                    <i class="fas fa-inbox"></i> Hub <span class="nav-badge" style="position: static; margin-left: 8px;">3</span>
                </button>
                <button class="tab-btn" onclick="showTab('integrations')">
                    <i class="fas fa-plug"></i> Integrations
                </button>
                <button class="tab-btn" onclick="showTab('templates')">
                    <i class="fas fa-file-alt"></i> Templates
                </button>
                <button class="tab-btn" onclick="showTab('scheduled')">
                    <i class="fas fa-calendar-alt"></i> Scheduled
                </button>
                <button class="tab-btn" onclick="showTab('alerts')">
                    <i class="fas fa-exclamation-triangle"></i> Alert Rules
                </button>
                <button class="tab-btn" onclick="showTab('history')">
                    <i class="fas fa-history"></i> History
                </button>
                <button class="tab-btn" onclick="showTab('settings')">
                    <i class="fas fa-cog"></i> Settings
                </button>
            </div>

            <!-- HUB TAB -->
            <div id="tab-hub" class="tab-content active">
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3>Unread</h3>
                        <div class="value" style="color: var(--primary);">3</div>
                        <div class="label">Notifications</div>
                    </div>
                    <div class="stat-card">
                        <h3>Critical</h3>
                        <div class="value" style="color: var(--critical);">1</div>
                        <div class="label">Requires attention</div>
                    </div>
                    <div class="stat-card">
                        <h3>Today</h3>
                        <div class="value">12</div>
                        <div class="label">Total notifications</div>
                    </div>
                    <div class="stat-card">
                        <h3>Do Not Disturb</h3>
                        <div class="value" style="color: var(--success);">OFF</div>
                        <div class="label">Receiving all alerts</div>
                    </div>
                </div>

                <div class="notification-hub">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-inbox" style="color: var(--primary);"></i> Recent Notifications</h3>
                            <div>
                                <button class="btn btn-ghost btn-sm" onclick="refreshNotifications()">
                                    <i class="fas fa-sync-alt"></i> Refresh
                                </button>
                            </div>
                        </div>
                        <div class="notification-list" id="notification-list">
                            <!-- Notification items will be populated by JS -->
                        </div>
                    </div>

                    <div>
                        <div class="widget">
                            <div class="widget-title"><i class="fas fa-filter"></i> Filter by Type</div>
                            <div class="filter-item" onclick="toggleFilter(this, 'all')">
                                <div class="filter-checkbox checked"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span>All Notifications</span>
                                <span class="filter-count">24</span>
                            </div>
                            <div class="filter-item" onclick="toggleFilter(this, 'email')">
                                <div class="filter-checkbox"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span><i class="fas fa-envelope" style="color: var(--info); margin-right: 6px;"></i> Email</span>
                                <span class="filter-count">8</span>
                            </div>
                            <div class="filter-item" onclick="toggleFilter(this, 'slack')">
                                <div class="filter-checkbox"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span><i class="fab fa-slack" style="color: #a78bfa; margin-right: 6px;"></i> Slack</span>
                                <span class="filter-count">5</span>
                            </div>
                            <div class="filter-item" onclick="toggleFilter(this, 'discord')">
                                <div class="filter-checkbox"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span><i class="fab fa-discord" style="color: #818cf8; margin-right: 6px;"></i> Discord</span>
                                <span class="filter-count">3</span>
                            </div>
                            <div class="filter-item" onclick="toggleFilter(this, 'push')">
                                <div class="filter-checkbox"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span><i class="fas fa-mobile-alt" style="color: var(--success); margin-right: 6px;"></i> Push</span>
                                <span class="filter-count">6</span>
                            </div>
                            <div class="filter-item" onclick="toggleFilter(this, 'system')">
                                <div class="filter-checkbox"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span><i class="fas fa-server" style="color: var(--warning); margin-right: 6px;"></i> System</span>
                                <span class="filter-count">2</span>
                            </div>
                        </div>

                        <div class="widget">
                            <div class="widget-title"><i class="fas fa-exclamation-circle"></i> Filter by Priority</div>
                            <div class="filter-item" onclick="toggleFilter(this, 'critical')">
                                <div class="filter-checkbox"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span><span class="priority-badge priority-critical">Critical</span></span>
                                <span class="filter-count">1</span>
                            </div>
                            <div class="filter-item" onclick="toggleFilter(this, 'high')">
                                <div class="filter-checkbox"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span><span class="priority-badge priority-high">High</span></span>
                                <span class="filter-count">3</span>
                            </div>
                            <div class="filter-item" onclick="toggleFilter(this, 'medium')">
                                <div class="filter-checkbox checked"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span><span class="priority-badge priority-medium">Medium</span></span>
                                <span class="filter-count">8</span>
                            </div>
                            <div class="filter-item" onclick="toggleFilter(this, 'low')">
                                <div class="filter-checkbox checked"><i class="fas fa-check" style="font-size: 10px; color: white;"></i></div>
                                <span><span class="priority-badge priority-low">Low</span></span>
                                <span class="filter-count">12</span>
                            </div>
                        </div>

                        <div class="dnd-panel">
                            <div class="dnd-status">🔔</div>
                            <h3>Do Not Disturb</h3>
                            <p style="color: var(--text-muted); font-size: 14px; margin-top: 8px;">Pause non-critical notifications</p>
                            <div class="dnd-toggle" id="dnd-toggle" onclick="toggleDND()"></div>
                            <p style="font-size: 12px; color: var(--text-muted);">Click to enable DND mode</p>
                            
                            <div class="dnd-schedule">
                                <div class="form-group" style="margin: 0;">
                                    <label style="font-size: 12px;">From</label>
                                    <input type="time" value="22:00" style="padding: 8px;">
                                </div>
                                <span style="color: var(--text-muted);">to</span>
                                <div class="form-group" style="margin: 0;">
                                    <label style="font-size: 12px;">Until</label>
                                    <input type="time" value="08:00" style="padding: 8px;">
                                </div>
                            </div>

                            <div class="dnd-exceptions">
                                <div class="widget-title"><i class="fas fa-shield-alt"></i> Exceptions (Always Notify)</div>
                                <div class="exception-item">
                                    <i class="fas fa-exclamation-triangle" style="color: var(--danger);"></i>
                                    <span>Critical system alerts</span>
                                    <div class="toggle active" style="margin-left: auto;"></div>
                                </div>
                                <div class="exception-item">
                                    <i class="fas fa-server" style="color: var(--warning);"></i>
                                    <span>Server downtime</span>
                                    <div class="toggle active" style="margin-left: auto;"></div>
                                </div>
                                <div class="exception-item">
                                    <i class="fas fa-user-shield" style="color: var(--primary);"></i>
                                    <span>Security breaches</span>
                                    <div class="toggle active" style="margin-left: auto;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- INTEGRATIONS TAB -->
            <div id="tab-integrations" class="tab-content">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-plug" style="color: var(--primary);"></i> Connected Services</h3>
                        <button class="btn btn-primary btn-sm" onclick="addIntegration()">
                            <i class="fas fa-plus"></i> Add Integration
                        </button>
                    </div>
                    <div class="integration-grid">
                        <div class="integration-card connected">
                            <div class="integration-icon slack"><i class="fab fa-slack"></i></div>
                            <h3>Slack</h3>
                            <p style="font-size: 13px; color: var(--text-muted); margin-top: 8px;">#notifications channel</p>
                            <span class="integration-status connected"><i class="fas fa-check-circle"></i> Connected</span>
                            <div style="margin-top: 16px;">
                                <button class="btn btn-ghost btn-sm" onclick="configureIntegration('slack')">Configure</button>
                            </div>
                        </div>
                        <div class="integration-card connected">
                            <div class="integration-icon discord"><i class="fab fa-discord"></i></div>
                            <h3>Discord</h3>
                            <p style="font-size: 13px; color: var(--text-muted); margin-top: 8px;">Mission Control server</p>
                            <span class="integration-status connected"><i class="fas fa-check-circle"></i> Connected</span>
                            <div style="margin-top: 16px;">
                                <button class="btn btn-ghost btn-sm" onclick="configureIntegration('discord')">Configure</button>
                            </div>
                        </div>
                        <div class="integration-card connected">
                            <div class="integration-icon email"><i class="fas fa-envelope"></i></div>
                            <h3>Email (SMTP)</h3>
                            <p style="font-size: 13px; color: var(--text-muted); margin-top: 8px;">baarliclaw@gmail.com</p>
                            <span class="integration-status connected"><i class="fas fa-check-circle"></i> Connected</span>
                            <div style="margin-top: 16px;">
                                <button class="btn btn-ghost btn-sm" onclick="configureIntegration('email')">Configure</button>
                            </div>
                        </div>
                        <div class="integration-card">
                            <div class="integration-icon push"><i class="fas fa-mobile-alt"></i></div>
                            <h3>Push Notifications</h3>
                            <p style="font-size: 13px; color: var(--text-muted); margin-top: 8px;">Web Push API</p>
                            <span class="integration-status disconnected"><i class="fas fa-times-circle"></i> Not Configured</span>
                            <div style="margin-top: 16px;">
                                <button class="btn btn-primary btn-sm" onclick="configureIntegration('push')">Setup</button>
                            </div>
                        </div>
                        <div class="integration-card connected">
                            <div class="integration-icon webhook"><i class="fas fa-code"></i></div>
                            <h3>Webhooks</h3>
                            <p style="font-size: 13px; color: var(--text-muted); margin-top: 8px;">3 endpoints configured</p>
                            <span class="integration-status connected"><i class="fas fa-check-circle"></i> Active</span>
                            <div style="margin-top: 16px;">
                                <button class="btn btn-ghost btn-sm" onclick="configureIntegration('webhook')">Manage</button>
                            </div>
                        </div>
                        <div class="integration-card">
                            <div class="integration-icon sms"><i class="fas fa-sms"></i></div>
                            <h3>SMS</h3>
                            <p style="font-size: 13px; color: var(--text-muted); margin-top: 8px;">Twilio integration</p>
                            <span class="integration-status disconnected"><i class="fas fa-times-circle"></i> Not Configured</span>
                            <div style="margin-top: 16px;">
                                <button class="btn btn-primary btn-sm" onclick="configureIntegration('sms')">Setup</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-cog" style="color: var(--warning);"></i> Email Configuration</h3>
                    </div>
                    <div class="settings-grid">
                        <div class="setting-group">
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>SMTP Server</h4>
                                    <p>smtp.gmail.com:587</p>
                                </div>
                                <button class="btn btn-ghost btn-sm">Edit</button>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>From Address</h4>
                                    <p>baarliclaw@gmail.com</p>
                                </div>
                                <button class="btn btn-ghost btn-sm">Edit</button>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>TLS Encryption</h4>
                                    <p>Secure connection enabled</p>
                                </div>
                                <div class="toggle active"></div>
                            </div>
                        </div>
                        <div class="setting-group">
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Daily Digest</h4>
                                    <p>Send summary at 08:00</p>
                                </div>
                                <div class="toggle active"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>HTML Emails</h4>
                                    <p>Rich formatting enabled</p>
                                </div>
                                <div class="toggle active"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Test Mode</h4>
                                    <p>Log only, don't send</p>
                                </div>
                                <div class="toggle"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TEMPLATES TAB -->
            <div id="tab-templates" class="tab-content">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-file-alt" style="color: var(--primary);"></i> Notification Templates</h3>
                        <button class="btn btn-primary btn-sm" onclick="createTemplate()">
                            <i class="fas fa-plus"></i> New Template
                        </button>
                    </div>
                    <div class="template-list">
                        <div class="template-item" onclick="editTemplate('system-alert')">
                            <div class="card-icon" style="background: rgba(239, 68, 68, 0.2); color: #f87171;"><i class="fas fa-exclamation-triangle"></i></div>
                            <div class="template-preview">
                                <h4>System Alert</h4>
                                <p>🚨 Alert: {{alert_type}} - {{message}}</p>
                                <div class="template-vars">
                                    <span class="template-var">{{alert_type}}</span>
                                    <span class="template-var">{{message}}</span>
                                    <span class="template-var">{{timestamp}}</span>
                                    <span class="template-var">{{severity}}</span>
                                </div>
                            </div>
                            <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i> Edit</button>
                        </div>
                        <div class="template-item" onclick="editTemplate('morning-routine')">
                            <div class="card-icon" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24;"><i class="fas fa-sun"></i></div>
                            <div class="template-preview">
                                <h4>Morning Routine Complete</h4>
                                <p>☀️ Good morning! {{task_count}} tasks completed. NRJ: {{nrj_listeners}} listeners.</p>
                                <div class="template-vars">
                                    <span class="template-var">{{task_count}}</span>
                                    <span class="template-var">{{nrj_listeners}}</span>
                                    <span class="template-var">{{podcast_rank}}</span>
                                    <span class="template-var">{{date}}</span>
                                </div>
                            </div>
                            <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i> Edit</button>
                        </div>
                        <div class="template-item" onclick="editTemplate('podcast-published')">
                            <div class="card-icon" style="background: rgba(16, 185, 129, 0.2); color: #34d399;"><i class="fas fa-podcast"></i></div>
                            <div class="template-preview">
                                <h4>Podcast Published</h4>
                                <p>🎧 New episode: "{{episode_title}}" is now live!</p>
                                <div class="template-vars">
                                    <span class="template-var">{{episode_title}}</span>
                                    <span class="template-var">{{episode_number}}</span>
                                    <span class="template-var">{{duration}}</span>
                                    <span class="template-var">{{url}}</span>
                                </div>
                            </div>
                            <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i> Edit</button>
                        </div>
                        <div class="template-item" onclick="editTemplate('deploy-success')">
                            <div class="card-icon" style="background: rgba(59, 130, 246, 0.2); color: #60a5fa;"><i class="fas fa-rocket"></i></div>
                            <div class="template-preview">
                                <h4>Deployment Success</h4>
                                <p>🚀 {{project_name}} deployed successfully to {{environment}}!</p>
                                <div class="template-vars">
                                    <span class="template-var">{{project_name}}</span>
                                    <span class="template-var">{{environment}}</span>
                                    <span class="template-var">{{version}}</span>
                                    <span class="template-var">{{deploy_time}}</span>
                                </div>
                            </div>
                            <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i> Edit</button>
                        </div>
                        <div class="template-item" onclick="editTemplate('nrj-stats')">
                            <div class="card-icon" style="background: rgba(139, 92, 246, 0.2); color: #a78bfa;"><i class="fas fa-chart-line"></i></div>
                            <div class="template-preview">
                                <h4>NRJ Weekly Stats</h4>
                                <p>📻 Week {{week_number}}: {{daily_listeners}} daily listeners (+{{change_percent}}%)</p>
                                <div class="template-vars">
                                    <span class="template-var">{{week_number}}</span>
                                    <span class="template-var">{{daily_listeners}}</span>
                                    <span class="template-var">{{change_percent}}</span>
                                    <span class="template-var">{{market_share}}</span>
                                </div>
                            </div>
                            <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i> Edit</button>
                        </div>
                        <div class="template-item" onclick="editTemplate('custom')">
                            <div class="card-icon" style="background: rgba(255,255,255,0.1); color: var(--text-muted);"><i class="fas fa-plus"></i></div>
                            <div class="template-preview">
                                <h4>Create Custom Template</h4>
                                <p>Design your own notification template with variables</p>
                            </div>
                            <button class="btn btn-primary btn-sm">Create</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SCHEDULED TAB -->
            <div id="tab-scheduled" class="tab-content">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-calendar-alt" style="color: var(--primary);"></i> Scheduled Notifications</h3>
                        <button class="btn btn-primary btn-sm" onclick="scheduleNotification()">
                            <i class="fas fa-plus"></i> Schedule New
                        </button>
                    </div>
                    
                    <div class="calendar-grid">
                        <div class="calendar-header">Mon</div>
                        <div class="calendar-header">Tue</div>
                        <div class="calendar-header">Wed</div>
                        <div class="calendar-header">Thu</div>
                        <div class="calendar-header">Fri</div>
                        <div class="calendar-header">Sat</div>
                        <div class="calendar-header">Sun</div>
                        
                        <!-- Calendar days -->
                        <div class="calendar-day"><span class="calendar-day-number">24</span></div>
                        <div class="calendar-day today has-event"><span class="calendar-day-number">25</span></div>
                        <div class="calendar-day has-event"><span class="calendar-day-number">26</span></div>
                        <div class="calendar-day"><span class="calendar-day-number">27</span></div>
                        <div class="calendar-day has-event"><span class="calendar-day-number">28</span></div>
                        <div class="calendar-day"><span class="calendar-day-number">1</span></div>
                        <div class="calendar-day"><span class="calendar-day-number">2</span></div>
                    </div>

                    <div class="scheduled-notifications">
                        <h4 style="margin-bottom: 16px;"><i class="fas fa-clock"></i> Upcoming</h4>
                        <div class="scheduled-item">
                            <span class="scheduled-time">06:00</span>
                            <div class="scheduled-content">
                                <h4>Morning Routine Report</h4>
                                <p>Daily NRJ stats and podcast updates</p>
                            </div>
                            <span class="priority-badge priority-medium">Recurring</span>
                            <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                        </div>
                        <div class="scheduled-item">
                            <span class="scheduled-time">09:00</span>
                            <div class="scheduled-content">
                                <h4>Weekly Podcast Summary</h4>
                                <p>Rankings and download stats</p>
                            </div>
                            <span class="priority-badge priority-low">Weekly</span>
                            <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                        </div>
                        <div class="scheduled-item">
                            <span class="scheduled-time">14:00</span>
                            <div class="scheduled-content">
                                <h4>System Health Check</h4>
                                <p>Server status and cron job report</p>
                            </div>
                            <span class="priority-badge priority-high">Daily</span>
                            <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                        </div>
                        <div class="scheduled-item">
                            <span class="scheduled-time">18:00</span>
                            <div class="scheduled-content">
                                <h4>Evening Digest</h4>
                                <p>Summary of day's activities</p>
                            </div>
                            <span class="priority-badge priority-low">Daily</span>
                            <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ALERT RULES TAB -->
            <div id="tab-alerts" class="tab-content">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-exclamation-triangle" style="color: var(--warning);"></i> System Alert Rules</h3>
                        <button class="btn btn-primary btn-sm" onclick="createAlertRule()">
                            <i class="fas fa-plus"></i> New Rule
                        </button>
                    </div>
                    <div class="rule-list">
                        <div class="rule-item critical">
                            <div class="rule-icon" style="color: var(--danger);"><i class="fas fa-microchip"></i></div>
                            <div class="rule-content">
                                <h4>High CPU Usage</h4>
                                <p>Notify when CPU exceeds threshold for 5 minutes</p>
                            </div>
                            <span class="rule-condition">CPU > 90%</span>
                            <div class="rule-actions">
                                <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                                <div class="toggle active"></div>
                            </div>
                        </div>
                        <div class="rule-item critical">
                            <div class="rule-icon" style="color: var(--danger);"><i class="fas fa-memory"></i></div>
                            <div class="rule-content">
                                <h4>Low Memory</h4>
                                <p>Alert when available RAM drops below threshold</p>
                            </div>
                            <span class="rule-condition">RAM < 10%</span>
                            <div class="rule-actions">
                                <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                                <div class="toggle active"></div>
                            </div>
                        </div>
                        <div class="rule-item critical">
                            <div class="rule-icon" style="color: var(--danger);"><i class="fas fa-hdd"></i></div>
                            <div class="rule-content">
                                <h4>Disk Space Critical</h4>
                                <p>Warn when disk usage exceeds safe limits</p>
                            </div>
                            <span class="rule-condition">Disk > 85%</span>
                            <div class="rule-actions">
                                <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                                <div class="toggle active"></div>
                            </div>
                        </div>
                        <div class="rule-item warning">
                            <div class="rule-icon" style="color: var(--warning);"><i class="fas fa-clock"></i></div>
                            <div class="rule-content">
                                <h4>Cron Job Failure</h4>
                                <p>Notify when scheduled tasks fail to execute</p>
                            </div>
                            <span class="rule-condition">Exit code ≠ 0</span>
                            <div class="rule-actions">
                                <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                                <div class="toggle active"></div>
                            </div>
                        </div>
                        <div class="rule-item warning">
                            <div class="rule-icon" style="color: var(--warning);"><i class="fas fa-code-branch"></i></div>
                            <div class="rule-content">
                                <h4>Git Sync Failed</h4>
                                <p>Alert when repository sync encounters errors</p>
                            </div>
                            <span class="rule-condition">Sync failed</span>
                            <div class="rule-actions">
                                <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                                <div class="toggle active"></div>
                            </div>
                        </div>
                        <div class="rule-item info">
                            <div class="rule-icon" style="color: var(--info);"><i class="fas fa-wifi"></i></div>
                            <div class="rule-content">
                                <h4>Network Latency</h4>
                                <p>Monitor response times for external services</p>
                            </div>
                            <span class="rule-condition">Latency > 500ms</span>
                            <div class="rule-actions">
                                <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                                <div class="toggle"></div>
                            </div>
                        </div>
                        <div class="rule-item info">
                            <div class="rule-icon" style="color: var(--info);"><i class="fas fa-podcast"></i></div>
                            <div class="rule-content">
                                <h4>Podcast Ranking Change</h4>
                                <p>Notify when podcast ranking changes significantly</p>
                            </div>
                            <span class="rule-condition">Δ Rank > 10</span>
                            <div class="rule-actions">
                                <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                                <div class="toggle active"></div>
                            </div>
                        </div>
                        <div class="rule-item info">
                            <div class="rule-icon" style="color: var(--info);"><i class="fas fa-radio"></i></div>
                            <div class="rule-content">
                                <h4>NRJ Listener Milestone</h4>
                                <p>Celebrate listener count milestones</p>
                            </div>
                            <span class="rule-condition">Milestone reached</span>
                            <div class="rule-actions">
                                <button class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></button>
                                <div class="toggle active"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- HISTORY TAB -->
            <div id="tab-history" class="tab-content">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-history" style="color: var(--primary);"></i> Notification History</h3>
                        <div>
                            <button class="btn btn-ghost btn-sm" onclick="exportHistory()">
                                <i class="fas fa-download"></i> Export
                            </button>
                            <button class="btn btn-ghost btn-sm" onclick="clearHistory()">
                                <i class="fas fa-trash"></i> Clear
                            </button>
                        </div>
                    </div>
                    <div class="timeline" id="history-timeline">
                        <div class="timeline-item success">
                            <div class="timeline-time">Today, 05:12</div>
                            <div class="timeline-content">
                                <h4><i class="fas fa-bell" style="color: var(--primary);"></i> Notification Center Created</h4>
                                <p>New notification system deployed and integrated with all existing systems.</p>
                            </div>
                        </div>
                        <div class="timeline-item success">
                            <div class="timeline-time">Today, 04:44</div>
                            <div class="timeline-content">
                                <h4><i class="fas fa-rocket" style="color: var(--success);"></i> Dashboard Deployed</h4>
                                <p>Total Control dashboard successfully deployed to Netlify.</p>
                            </div>
                        </div>
                        <div class="timeline-item success">
                            <div class="timeline-time">Today, 04:30</div>
                            <div class="timeline-content">
                                <h4><i class="fas fa-server" style="color: var(--info);"></i> System Monitor Started</h4>
                                <p>System monitoring service initialized with all alert rules active.</p>
                            </div>
                        </div>
                        <div class="timeline-item warning">
                            <div class="timeline-time">Yesterday, 23:45</div>
                            <div class="timeline-content">
                                <h4><i class="fas fa-exclamation-triangle" style="color: var(--warning);"></i> High Memory Usage</h4>
                                <p>Memory usage reached 78% during podcast clip generation. Auto-scaling triggered.</p>
                            </div>
                        </div>
                        <div class="timeline-item success">
                            <div class="timeline-time">Yesterday, 07:00</div>
                            <div class="timeline-content">
                                <h4><i class="fas fa-sun" style="color: var(--warning);"></i> Morning Routine Complete</h4>
                                <p>15 tasks completed. NRJ: 69K listeners. Podcast: #62 ranking.</p>
                            </div>
                        </div>
                        <div class="timeline-item error">
                            <div class="timeline-time">Feb 23, 22:15</div>
                            <div class="timeline-content">
                                <h4><i class="fas fa-times-circle" style="color: var(--danger);"></i> Cron Job Failed</h4>
                                <p>Nielsen data fetch failed due to API timeout. Retry scheduled.</p>
                            </div>
                        </div>
                        <div class="timeline-item success">
                            <div class="timeline-time">Feb 23, 18:30</div>
                            <div class="timeline-content">
                                <h4><i class="fas fa-podcast" style="color: var(--success);"></i> Podcast Episode Published</h4>
                                <p>New episode "Handleapp, hyperfokus og husfred" is now live!</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SETTINGS TAB -->
            <div id="tab-settings" class="tab-content">
                <div class="settings-grid">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-bell" style="color: var(--primary);"></i> General Settings</h3>
                        </div>
                        <div class="setting-group" style="background: transparent; padding: 0;">
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Desktop Notifications</h4>
                                    <p>Show browser notifications</p>
                                </div>
                                <div class="toggle active" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Sound Alerts</h4>
                                    <p>Play sound for critical alerts</p>
                                </div>
                                <div class="toggle active" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Auto-mark as Read</h4>
                                    <p>Mark notifications as read after viewing</p>
                                </div>
                                <div class="toggle" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Notification Retention</h4>
                                    <p>Keep notifications for 30 days</p>
                                </div>
                                <select style="padding: 8px 12px; background: rgba(15,23,42,0.5); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; color: white;">
                                    <option>7 days</option>
                                    <option selected>30 days</option>
                                    <option>90 days</option>
                                    <option>1 year</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-envelope" style="color: var(--info);"></i> Email Settings</h3>
                        </div>
                        <div class="setting-group" style="background: transparent; padding: 0;">
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Email Notifications</h4>
                                    <p>Send notifications via email</p>
                                </div>
                                <div class="toggle active" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Daily Digest</h4>
                                    <p>Send summary at 08:00 daily</p>
                                </div>
                                <div class="toggle active" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Weekly Report</h4>
                                    <p>Send weekly summary on Mondays</p>
                                </div>
                                <div class="toggle active" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Critical Only</h4>
                                    <p>Only email critical alerts</p>
                                </div>
                                <div class="toggle" onclick="this.classList.toggle('active')"></div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fab fa-slack" style="color: #a78bfa;"></i> Slack Settings</h3>
                        </div>
                        <div class="setting-group" style="background: transparent; padding: 0;">
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Slack Notifications</h4>
                                    <p>Send to #notifications channel</p>
                                </div>
                                <div class="toggle active" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>@mentions</h4>
                                    <p>Mention @channel for critical</p>
                                </div>
                                <div class="toggle active" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Thread Replies</h4>
                                    <p>Group related notifications</p>
                                </div>
                                <div class="toggle" onclick="this.classList.toggle('active')"></div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fab fa-discord" style="color: #818cf8;"></i> Discord Settings</h3>
                        </div>
                        <div class="setting-group" style="background: transparent; padding: 0;">
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Discord Notifications</h4>
                                    <p>Send to Mission Control server</p>
                                </div>
                                <div class="toggle active" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>Rich Embeds</h4>
                                    <p>Use embeds for better formatting</p>
                                </div>
                                <div class="toggle active" onclick="this.classList.toggle('active')"></div>
                            </div>
                            <div class="setting-item">
                                <div class="setting-info">
                                    <h4>@everyone Ping</h4>
                                    <p>Ping everyone for critical alerts</p>
                                </div>
                                <div class="toggle" onclick="this.classList.toggle('active')"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toast-container"></div>

    <!-- Send Notification Modal -->
    <div class="modal-overlay" id="send-modal">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-paper-plane"></i> Send Notification</h3>
                <button class="modal-close" onclick="closeModal('send-modal')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Title</label>
                    <input type="text" placeholder="Enter notification title">
                </div>
                <div class="form-group">
                    <label>Message</label>
                    <textarea placeholder="Enter notification message"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Priority</label>
                        <select>
                            <option value="low">Low</option>
                            <option value="medium" selected>Medium</option>
                            <option value="high">High</option>
                            <option value="critical">Critical</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Channel</label>
                        <select>
                            <option value="all">All Channels</option>
                            <option value="email">Email</option>
                            <option value="slack">Slack</option>
                            <option value="discord">Discord</option>
                            <option value="push">Push</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-ghost" onclick="closeModal('send-modal')">Cancel</button>
                <button class="btn btn-primary" onclick="sendNotification()">
                    <i class="fas fa-paper-plane"></i> Send
                </button>
            </div>
        </div>
    </div>

    <script>
        // Sample notifications data
        const notifications = [
            {
                id: 1,
                type: 'system',
                icon: 'server',
                title: 'High CPU Usage Detected',
                message: 'CPU usage exceeded 90% for more than 5 minutes on production server.',
                priority: 'critical',
                time: '2 minutes ago',
                unread: true,
                channel: 'system'
            },
            {
                id: 2,
                type: 'slack',
                icon: 'slack',
                title: 'Morning Routine Complete',
                message: '☀️ 15 tasks completed. NRJ: 69K listeners. Podcast: #62 ranking.',
                priority: 'low',
                time: '1 hour ago',
                unread: true,
                channel: 'slack'
            },
            {
                id: 3,
                type: 'email',
                icon: 'envelope',
                title: 'Weekly Podcast Report',
                message: 'Your weekly podcast statistics are ready for review.',
                priority: 'medium',
                time: '3 hours ago',
                unread: true,
                channel: 'email'
            },
            {
                id: 4,
                type: 'push',
                icon: 'mobile-alt',
                title: 'Deployment Successful',
                message: 'Mission Control dashboard deployed to production.',
                priority: 'low',
                time: '5 hours ago',
                unread: false,
                channel: 'push'
            },
            {
                id: 5,
                type: 'discord',
                icon: 'discord',
                title: 'New Podcast Episode',
                message: '🎧 "Handleapp, hyperfokus og husfred" is now live!',
                priority: 'medium',
                time: 'Yesterday',
                unread: false,
                channel: 'discord'
            },
            {
                id: 6,
                type: 'system',
                icon: 'exclamation-triangle',
                title: 'Cron Job Warning',
                message: 'Nielsen data fetch took longer than expected (45s).',
                priority: 'medium',
                time: 'Yesterday',
                unread: false,
                channel: 'system'
            }
        ];

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            renderNotifications();
            updateBadgeCount();
        });

        // Tab navigation
        function showTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            
            // Show selected tab
            document.getElementById('tab-' + tabName).classList.add('active');
            event.target.closest('.tab-btn').classList.add('active');
        }

        // Render notifications
        function renderNotifications() {
            const container = document.getElementById('notification-list');
            container.innerHTML = notifications.map(n => `
                <div class="notification-item ${n.unread ? 'unread' : ''} ${n.priority}" data-id="${n.id}">
                    <div class="notification-icon ${n.type}">
                        <i class="fas fa-${n.icon}"></i>
                    </div>
                    <div class="notification-content">
                        <div class="notification-title">
                            ${n.title}
                            <span class="priority-badge priority-${n.priority}">${n.priority}</span>
                        </div>
                        <div class="notification-message">${n.message}</div>
                        <div class="notification-meta">
                            <span><i class="fas fa-${n.type === 'slack' ? 'hashtag' : n.type === 'discord' ? 'server' : n.type === 'email' ? 'envelope' : n.type === 'push' ? 'mobile-alt' : 'server'}"></i> ${n.channel}</span>
                            <span><i class="fas fa-clock"></i> ${n.time}</span>
                        </div>
                    </div>
                    <div class="notification-actions">
                        ${n.unread ? `<button onclick="markAsRead(${n.id})" title="Mark as read"><i class="fas fa-check"></i></button>` : ''}
                        <button onclick="deleteNotification(${n.id})" title="Delete"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
            `).join('');
        }

        // Update badge count
        function updateBadgeCount() {
            const unread = notifications.filter(n => n.unread).length;
            document.getElementById('nav-badge').textContent = unread;
        }

        // Mark as read
        function markAsRead(id) {
            const notification = notifications.find(n => n.id === id);
            if (notification) {
                notification.unread = false;
                renderNotifications();
                updateBadgeCount();
                showToast('Marked as read', 'success');
            }
        }

        // Mark all as read
        function markAllRead() {
            notifications.forEach(n => n.unread = false);
            renderNotifications();
            updateBadgeCount();
            showToast('All notifications marked as read', 'success');
        }

        // Delete notification
        function deleteNotification(id) {
            const index = notifications.findIndex(n => n.id === id);
            if (index > -1) {
                notifications.splice(index, 1);
                renderNotifications();
                updateBadgeCount();
                showToast('Notification deleted', 'success');
            }
        }

        // Refresh notifications
        function refreshNotifications() {
            showToast('Refreshing notifications...', 'info');
            setTimeout(() => {
                showToast('Notifications updated', 'success');
            }, 1000);
        }

        // Toggle filter
        function toggleFilter(element, type) {
            const checkbox = element.querySelector('.filter-checkbox');
            checkbox.classList.toggle('checked');
        }

        // Toggle DND
        function toggleDND() {
            const toggle = document.getElementById('dnd-toggle');
            toggle.classList.toggle('active');
            const isActive = toggle.classList.contains('active');
            showToast(isActive ? 'Do Not Disturb enabled' : 'Do Not Disturb disabled', isActive ? 'warning' : 'success');
        }

        // Modal functions
        function openSendNotificationModal() {
            document.getElementById('send-modal').classList.add('active');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        function sendNotification() {
            closeModal('send-modal');
            showToast('Notification sent successfully', 'success');
        }

        // Integration functions
        function addIntegration() {
            showToast('Add integration feature coming soon', 'info');
        }

        function configureIntegration(type) {
            showToast(`Configuring ${type} integration...`, 'info');
        }

        // Template functions
        function createTemplate() {
            showToast('Create template feature coming soon', 'info');
        }

        function editTemplate(id) {
            showToast(`Editing template: ${id}`, 'info');
        }

        // Schedule functions
        function scheduleNotification() {
            showToast('Schedule notification feature coming soon', 'info');
        }

        // Alert rule functions
        function createAlertRule() {
            showToast('Create alert rule feature coming soon', 'info');
        }

        // History functions
        function exportHistory() {
            showToast('Exporting history...', 'info');
            setTimeout(() => showToast('History exported', 'success'), 1000);
        }

        function clearHistory() {
            if (confirm('Are you sure you want to clear all history?')) {
                showToast('History cleared', 'success');
            }
        }

        // Toast notification
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'times-circle' : type === 'warning' ? 'exclamation-triangle' : 'info-circle'}"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        // Close modal on overlay click
        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('active');
                }
            });
        });
    </script>
<script src="auto-nav.js"></script>
</body>
</html>