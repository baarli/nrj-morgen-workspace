<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NRJ Morgen - Sakslista Pro</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="ai-content-suggestions.js" defer></script>
    <script src="realtime-collaboration.js" defer></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --primary: #667eea;
            --primary-dark: #764ba2;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #3b82f6;
            --dark: #0f172a;
            --dark-light: #1e293b;
            --dark-lighter: #334155;
            --text: #e2e8f0;
            --text-muted: #94a3b8;
            --text-dim: #64748b;
            --bg-card: rgba(30, 41, 59, 0.7);
            --bg-hover: rgba(255,255,255,0.03);
            --border-color: rgba(255,255,255,0.1);
        }
        
        /* Light Theme */
        [data-theme="light"] {
            --dark: #f8fafc;
            --dark-light: #ffffff;
            --dark-lighter: #e2e8f0;
            --text: #1e293b;
            --text-muted: #64748b;
            --text-dim: #94a3b8;
            --bg-card: rgba(255, 255, 255, 0.9);
            --bg-hover: rgba(0,0,0,0.03);
            --border-color: rgba(0,0,0,0.1);
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, var(--dark) 0%, var(--dark-light) 100%);
            color: var(--text);
            min-height: 100vh;
            transition: background 0.3s, color 0.3s;
        }
        
        .container { display: flex; min-height: 100vh; }
        
        /* Sidebar */
        .sidebar {
            width: 280px;
            background: var(--dark-light);
            padding: 24px;
            border-right: 1px solid var(--border-color);
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            z-index: 100;
            transition: background 0.3s;
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 32px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border-color);
        }
        
        .logo-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
        
        .logo-text h1 { font-size: 20px; margin-bottom: 4px; }
        .logo-text p { font-size: 12px; color: var(--text-muted); }
        
        .nav { list-style: none; }
        .nav li { margin-bottom: 8px; }
        .nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            color: var(--text-muted);
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
        }
        .nav a:hover, .nav a.active {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
        }
        
        /* Active Users */
        .active-users {
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid var(--border-color);
        }
        
        .active-users h4 {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
        }
        
        .user-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        
        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            color: white;
            position: relative;
            cursor: pointer;
        }
        
        .user-avatar.online::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: 0;
            width: 10px;
            height: 10px;
            background: var(--success);
            border-radius: 50%;
            border: 2px solid var(--dark-light);
        }
        
        .user-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }
        
        /* Main Content */
        .main {
            flex: 1;
            margin-left: 280px;
            padding: 32px;
        }
        
        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-bottom: 32px;
        }
        
        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            text-align: center;
            transition: transform 0.2s;
        }
        
        .stat-card:hover { transform: translateY(-4px); }
        
        .stat-card h3 {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 8px;
            text-transform: uppercase;
        }
        
        .stat-card .value {
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 4px;
        }
        
        .stat-card .label {
            font-size: 14px;
            color: var(--text-dim);
        }
        
        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }
        
        .header h2 { font-size: 28px; }
        
        .header-actions {
            display: flex;
            gap: 12px;
        }
        
        /* Buttons */
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--dark-lighter);
            color: var(--text);
        }
        
        .btn:hover { opacity: 0.9; transform: translateY(-1px); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .btn-primary { 
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); 
            color: white; 
        }
        .btn-success { background: var(--success); color: white; }
        .btn-danger { background: var(--danger); color: white; }
        .btn-warning { background: var(--warning); color: white; }
        .btn-secondary { background: var(--dark-lighter); color: var(--text); }
        .btn-ghost { background: transparent; border: 1px solid var(--border-color); color: var(--text); }
        
        /* Toolbar */
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding: 16px 20px;
            background: var(--bg-card);
            border-radius: 12px;
            gap: 16px;
            flex-wrap: wrap;
            border: 1px solid var(--border-color);
        }
        
        .toolbar-left, .toolbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .search-box {
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--dark);
            padding: 10px 16px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            min-width: 280px;
        }
        
        .search-box input {
            background: none;
            border: none;
            color: var(--text);
            font-size: 14px;
            width: 100%;
            outline: none;
        }
        
        .search-box input::placeholder { color: var(--text-dim); }
        
        .filter-select {
            background: var(--dark);
            border: 1px solid var(--border-color);
            color: var(--text);
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            outline: none;
        }
        
        .filter-select:focus { border-color: var(--primary); }
        
        /* Advanced Filters Panel */
        .advanced-filters {
            display: none;
            padding: 16px 20px;
            background: var(--bg-card);
            border-radius: 12px;
            margin-bottom: 20px;
            border: 1px solid var(--border-color);
            gap: 16px;
            flex-wrap: wrap;
        }
        
        .advanced-filters.active { display: flex; }
        
        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        
        .filter-group label {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .filter-group input, .filter-group select {
            background: var(--dark);
            border: 1px solid var(--border-color);
            color: var(--text);
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
        }
        
        /* Duplicate Warning */
        .duplicate-warning {
            display: none;
            padding: 12px 20px;
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 8px;
            margin-bottom: 16px;
            align-items: center;
            gap: 12px;
        }
        
        .duplicate-warning.active { display: flex; }
        
        .duplicate-warning i { color: var(--warning); }
        
        /* Bulk Actions Bar */
        .bulk-actions {
            display: none;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            background: rgba(102, 126, 234, 0.1);
            border: 1px solid rgba(102, 126, 234, 0.3);
            border-radius: 8px;
            margin-bottom: 16px;
        }
        
        .bulk-actions.active { display: flex; }
        
        .bulk-actions span {
            color: var(--primary);
            font-weight: 600;
        }
        
        /* Saker List */
        .saker-container {
            background: var(--bg-card);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }
        
        .saker-header {
            display: grid;
            grid-template-columns: 40px 40px 1fr 120px 100px 120px 40px;
            gap: 12px;
            padding: 16px 20px;
            background: var(--dark);
            font-weight: 600;
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .saker-list {
            min-height: 200px;
        }
        
        .sak-item {
            display: grid;
            grid-template-columns: 40px 40px 1fr 120px 100px 120px 40px;
            gap: 12px;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-color);
            align-items: center;
            transition: all 0.2s;
            background: transparent;
            position: relative;
        }
        
        .sak-item:hover { 
            background: var(--bg-hover);
        }
        
        .sak-item.selected {
            background: rgba(102, 126, 234, 0.1);
            border-left: 3px solid var(--primary);
        }
        
        .sak-item.dragging {
            opacity: 0.5;
            background: rgba(102, 126, 234, 0.2);
        }
        
        .sak-item.duplicate {
            border-left: 3px solid var(--warning);
        }
        
        .sak-item:last-child { border-bottom: none; }
        
        .sak-checkbox {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .sak-checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--primary);
        }
        
        .sak-drag {
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dim);
            cursor: grab;
        }
        
        .sak-drag:active { cursor: grabbing; }
        
        .sak-drag:hover { color: var(--text); }
        
        .sak-info {
            min-width: 0;
        }
        
        .sak-info h4 {
            font-size: 15px;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .sak-info h4 a {
            color: var(--primary);
            text-decoration: none;
        }
        
        .sak-info h4 a:hover { text-decoration: underline; }
        
        .sak-info p {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .sak-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 6px;
            font-size: 12px;
            color: var(--text-dim);
        }
        
        .sak-meta span {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        
        .sak-category .badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .badge-talk { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
        .badge-music { background: rgba(16, 185, 129, 0.15); color: #34d399; }
        .badge-news { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
        .badge-breaking { background: rgba(239, 68, 68, 0.15); color: #f87171; }
        
        .sak-time {
            font-size: 13px;
            color: var(--text-muted);
        }
        
        .sak-actions {
            display: flex;
            gap: 4px;
            justify-content: flex-end;
        }
        
        .sak-actions button {
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 8px;
            border-radius: 6px;
            transition: all 0.2s;
            font-size: 14px;
        }
        
        .sak-actions button:hover {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        
        .sak-actions .preview:hover { color: var(--info); }
        .sak-actions .edit:hover { color: var(--warning); }
        .sak-actions .delete:hover { color: var(--danger); }
        .sak-actions .history:hover { color: var(--primary); }
        .sak-actions .comments:hover { color: var(--success); }
        .sak-actions .ai-suggest { 
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.2) 0%, rgba(118, 75, 162, 0.2) 100%) !important;
            color: var(--primary) !important;
        }
        .sak-actions .ai-suggest:hover { 
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%) !important;
            color: white !important;
        }
        
        .comments-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: var(--danger);
            color: white;
            font-size: 10px;
            padding: 2px 5px;
            border-radius: 10px;
            min-width: 16px;
            text-align: center;
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 24px;
        }
        
        .empty-state i {
            font-size: 80px;
            color: var(--text-dim);
            margin-bottom: 24px;
            opacity: 0.5;
        }
        
        .empty-state h3 {
            font-size: 22px;
            margin-bottom: 12px;
        }
        
        .empty-state p {
            color: var(--text-muted);
            margin-bottom: 24px;
            max-width: 400px;
            margin-left: auto;
            margin-right: auto;
        }
        
        /* Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
            padding: 20px;
        }
        
        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        
        .modal {
            background: var(--dark-light);
            border-radius: 16px;
            width: 100%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            transform: scale(0.95);
            transition: transform 0.3s;
            border: 1px solid var(--border-color);
        }
        
        .modal-overlay.active .modal {
            transform: scale(1);
        }
        
        .modal-header {
            padding: 24px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            background: var(--dark-light);
            z-index: 10;
        }
        
        .modal-header h3 { font-size: 20px; }
        
        .modal-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 24px;
            cursor: pointer;
            padding: 4px;
            border-radius: 6px;
            transition: all 0.2s;
        }
        
        .modal-close:hover {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        
        .modal-body {
            padding: 24px;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--text-muted);
            font-weight: 500;
        }
        
        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px 16px;
            background: var(--dark);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text);
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }
        
        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .form-group textarea {
            min-height: 100px;
            resize: vertical;
            font-family: inherit;
            line-height: 1.6;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        
        .form-row-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 16px;
        }
        
        /* AI Suggestions */
        .ai-suggestions {
            margin-top: 8px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        
        .ai-suggestion {
            padding: 6px 12px;
            background: rgba(102, 126, 234, 0.1);
            border: 1px solid rgba(102, 126, 234, 0.3);
            border-radius: 20px;
            font-size: 12px;
            color: var(--primary);
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .ai-suggestion:hover {
            background: rgba(102, 126, 234, 0.2);
        }
        
        .ai-suggestion i {
            margin-right: 4px;
        }
        
        /* Image Preview */
        .image-preview {
            width: 100%;
            height: 200px;
            background: var(--dark);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }
        
        .image-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .image-preview .placeholder {
            color: var(--text-dim);
            font-size: 14px;
        }
        
        /* Preview Modal */
        .preview-modal .modal {
            max-width: 600px;
        }
        
        .preview-content {
            background: var(--dark);
            border-radius: 12px;
            padding: 24px;
        }
        
        .preview-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        
        .preview-title {
            font-size: 22px;
            margin-bottom: 12px;
            line-height: 1.4;
        }
        
        .preview-description {
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 20px;
        }
        
        .preview-notes {
            background: rgba(102, 126, 234, 0.1);
            border-left: 3px solid var(--primary);
            padding: 16px;
            border-radius: 0 8px 8px 0;
            font-size: 14px;
            line-height: 1.6;
            white-space: pre-wrap;
        }
        
        .preview-meta {
            display: flex;
            gap: 16px;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
        }
        
        .preview-meta span {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: var(--text-muted);
        }
        
        /* Comments Section */
        .comments-section {
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid var(--border-color);
        }
        
        .comments-section h4 {
            margin-bottom: 16px;
            font-size: 16px;
        }
        
        .comment-list {
            max-height: 300px;
            overflow-y: auto;
            margin-bottom: 16px;
        }
        
        .comment {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
            padding: 12px;
            background: var(--dark);
            border-radius: 8px;
        }
        
        .comment-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            color: white;
            flex-shrink: 0;
        }
        
        .comment-content {
            flex: 1;
        }
        
        .comment-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4px;
        }
        
        .comment-author {
            font-weight: 600;
            font-size: 13px;
        }
        
        .comment-time {
            font-size: 11px;
            color: var(--text-dim);
        }
        
        .comment-text {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.5;
        }
        
        .comment-input {
            display: flex;
            gap: 12px;
        }
        
        .comment-input input {
            flex: 1;
            padding: 10px 16px;
            background: var(--dark);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text);
            font-size: 14px;
            outline: none;
        }
        
        /* Version History */
        .version-list {
            max-height: 400px;
            overflow-y: auto;
        }
        
        .version-item {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 16px;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: background 0.2s;
        }
        
        .version-item:hover {
            background: var(--bg-hover);
        }
        
        .version-item.current {
            background: rgba(102, 126, 234, 0.1);
            border-left: 3px solid var(--primary);
        }
        
        .version-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--dark);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
        }
        
        .version-content {
            flex: 1;
        }
        
        .version-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4px;
        }
        
        .version-time {
            font-size: 13px;
            font-weight: 600;
        }
        
        .version-badge {
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 10px;
            background: var(--primary);
            color: white;
        }
        
        .version-badge.current {
            background: var(--success);
        }
        
        .version-author {
            font-size: 12px;
            color: var(--text-muted);
        }
        
        .version-changes {
            margin-top: 8px;
            font-size: 12px;
            color: var(--text-dim);
        }
        
        /* Modal Footer */
        .modal-footer {
            padding: 20px 24px;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            bottom: 0;
            background: var(--dark-light);
        }
        
        .modal-footer-left {
            font-size: 13px;
            color: var(--text-dim);
        }
        
        .modal-footer-right {
            display: flex;
            gap: 12px;
        }
        
        /* Notification */
        .notification-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1001;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .notification {
            padding: 16px 20px;
            background: var(--dark-light);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 300px;
            max-width: 400px;
            animation: slideIn 0.3s ease;
        }
        
        .notification.success { border-left: 4px solid var(--success); }
        .notification.error { border-left: 4px solid var(--danger); }
        .notification.warning { border-left: 4px solid var(--warning); }
        .notification.info { border-left: 4px solid var(--info); }
        
        .notification-icon {
            font-size: 20px;
        }
        
        .notification-content {
            flex: 1;
        }
        
        .notification-title {
            font-weight: 600;
            margin-bottom: 2px;
        }
        
        .notification-message {
            font-size: 13px;
            color: var(--text-muted);
        }
        
        .notification-close {
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            padding: 4px;
            font-size: 16px;
        }
        
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        @keyframes slideOut {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 1; }
        }
        
        .notification.hiding {
            animation: slideOut 0.3s ease forwards;
        }
        
        /* Progress Bar */
        .progress-container {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: rgba(255,255,255,0.1);
            z-index: 1002;
            display: none;
        }
        
        .progress-container.active { display: block; }
        
        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
            transition: width 0.3s ease;
            width: 0%;
        }
        
        /* Loading */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255,255,255,0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* Keyboard Shortcuts Help Modal */
        .shortcuts-modal .modal {
            max-width: 600px;
        }
        
        .shortcuts-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }
        
        .shortcut-category {
            margin-bottom: 24px;
        }
        
        .shortcut-category h4 {
            margin-bottom: 12px;
            color: var(--text-muted);
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .shortcut-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--border-color);
        }
        
        .shortcut-item:last-child {
            border-bottom: none;
        }
        
        .shortcut-keys {
            display: flex;
            gap: 4px;
        }
        
        kbd {
            background: var(--dark);
            padding: 4px 10px;
            border-radius: 4px;
            font-family: monospace;
            font-size: 12px;
            border: 1px solid var(--border-color);
        }
        
        /* Print Styles */
        @media print {
            .sidebar, .toolbar, .bulk-actions, .header-actions, 
            .sak-actions, .sak-checkbox, .sak-drag, .shortcuts-help,
            .notification-container, .progress-container {
                display: none !important;
            }
            
            body {
                background: white !important;
                color: black !important;
            }
            
            .main {
                margin-left: 0 !important;
                padding: 20px !important;
            }
            
            .saker-container {
                border: 1px solid #ccc !important;
                background: white !important;
            }
            
            .sak-item {
                border-bottom: 1px solid #eee !important;
                page-break-inside: avoid;
            }
            
            .saker-header {
                background: #f5f5f5 !important;
                color: black !important;
            }
            
            .stats-grid {
                grid-template-columns: repeat(4, 1fr) !important;
            }
            
            .stat-card {
                border: 1px solid #ccc !important;
                background: white !important;
            }
        }
        
        /* Responsive */
        @media (max-width: 1200px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .saker-header, .sak-item {
                grid-template-columns: 40px 40px 1fr 100px 80px 100px 40px;
            }
        }
        
        @media (max-width: 768px) {
            .sidebar { display: none; }
            .main { margin-left: 0; padding: 20px; }
            .stats-grid { grid-template-columns: 1fr; }
            .toolbar { flex-direction: column; align-items: stretch; }
            .toolbar-left, .toolbar-right { width: 100%; }
            .search-box { min-width: 0; }
            .saker-header { display: none; }
            .sak-item {
                grid-template-columns: 1fr;
                gap: 12px;
            }
            .sak-drag, .sak-checkbox { display: none; }
            .sak-actions { justify-content: flex-start; }
            .shortcuts-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <!-- Progress Bar -->
    <div class="progress-container" id="progress-container">
        <div class="progress-bar" id="progress-bar"></div>
    </div>

    <div class="container">
        <!-- Standard Navigation Template - Copy this to all HTML files -->
<aside class="sidebar">
    <div class="logo">
        <div class="logo-icon">🚀</div>
        <div>
            <h1 style="font-size: 18px; margin: 0;">Mission Control</h1>
            <p style="font-size: 11px; color: #94a3b8; margin: 4px 0 0 0;">v3.0</p>
        </div>
    </div>
    <ul class="nav">
        <li><a href="total-control.html"><i class="fas fa-home"></i> Oversikt</a></li>
        <li><a href="sakslista-pro.html" class="active"><i class="fas fa-list"></i> Saker</a></li>
        <li><a href="analytics.html"><i class="fas fa-chart-line"></i> Analyse</a></li>
        <li><a href="ai-assistant.html"><i class="fas fa-robot"></i> AI Assistant</a></li>
        <li><a href="widget-dashboard.html"><i class="fas fa-th-large"></i> Widgets</a></li>
        <li><a href="podkast-control.html"><i class="fas fa-podcast"></i> Podkast</a></li>
        <li><a href="cron-control.html"><i class="fas fa-clock"></i> Cron</a></li>
        <li><a href="agent-control.html"><i class="fas fa-robot"></i> Agent</a></li>
        <li><a href="notifications.html"><i class="fas fa-bell"></i> Varsler</a></li>
        <li><a href="system-monitor.html"><i class="fas fa-heartbeat"></i> System</a></li>
        <li><a href="database-admin.html"><i class="fas fa-database"></i> Database</a></li>
        <li><a href="git-control.html"><i class="fas fa-code-branch"></i> Git</a></li>
        <li><a href="api-docs.html"><i class="fas fa-book"></i> API Docs</a></li>
        <li><a href="innstillinger.html"><i class="fas fa-cog"></i> Innstillinger</a></li>
    </ul>
    
    <!-- Active Users -->
    <div class="active-users">
        <h4>Aktive Brukere</h4>
        <div class="user-list" id="active-users-list">
            <!-- Users injected here -->
        </div>
    </div>
</aside>

        <!-- Main Content -->
        <main class="main">
            <!-- Stats -->
            <div class="stats-grid">
                <div class="stat-card">
                    <h3>Aktive Saker</h3>
                    <div class="value" id="stat-count" style="color: var(--primary);">0</div>
                    <div class="label">i dag</div>
                </div>
                <div class="stat-card">
                    <h3>Siste Oppdatering</h3>
                    <div class="value" id="stat-updated" style="font-size: 24px;">--:--</div>
                    <div class="label">i dag</div>
                </div>
                <div class="stat-card">
                    <h3>Neste Rutine</h3>
                    <div class="value" id="stat-next" style="font-size: 24px;">06:00</div>
                    <div class="label">i morgen</div>
                </div>
                <div class="stat-card">
                    <h3>Auto-Status</h3>
                    <div class="value" style="color: var(--success);">🟢</div>
                    <div class="label">Aktiv</div>
                </div>
            </div>

            <!-- Header -->
            <div class="header">
                <h2>Dagens Saker</h2>
                <div class="header-actions">
                    <button class="btn btn-secondary" onclick="toggleTheme()" title="Bytt tema (T)">
                        <i class="fas fa-moon" id="theme-icon"></i>
                    </button>
                    <button class="btn btn-secondary" onclick="openPrintView()" title="Utskriftsvennlig visning (P)">
                        <i class="fas fa-print"></i>
                    </button>
                    <button class="btn btn-secondary" onclick="openExportModal()" title="Eksporter">
                        <i class="fas fa-download"></i> Export
                    </button>
                    <button class="btn btn-secondary" onclick="document.getElementById('import-file').click()" title="Importer">
                        <i class="fas fa-upload"></i> Import
                    </button>
                    <input type="file" id="import-file" style="display: none;" accept=".json" onchange="importSaker(this)">
                    
                    <button class="btn btn-warning" onclick="runMorningRoutine()" id="btn-morning">
                        <i class="fas fa-play"></i> Kjør Morning Routine v2.1
                    </button>
                    
                    <button class="btn btn-primary" onclick="openAddModal()">
                        <i class="fas fa-plus"></i> Legg til Sak
                    </button>
                </div>
            </div>

            <!-- Morning Routine v2.1 Info -->
            <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.1)); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 12px; padding: 16px 20px; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                    <span style="font-size: 24px;">🌅</span>
                    <div>
                        <h3 style="margin: 0; font-size: 16px; color: var(--text-primary);">Morning Routine v2.1</h3>
                        <p style="margin: 4px 0 0 0; font-size: 13px; color: var(--text-secondary);">Automatisk nyhetsinnhenting med OpenAI</p>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; font-size: 12px; color: var(--text-secondary);">
                    <div>📊 <strong>15 saker</strong> per dag (5 kategorier)</div>
                    <div>🎯 <strong>Maks 3 saker</strong> per kategori</div>
                    <div>🤖 <strong>OpenAI:</strong> Titler på maks 7 ord</div>
                    <div>⏰ <strong>Kjører:</strong> Hver dag kl 06:00 CET</div>
                </div>
                <div style="margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px;">
                    <span style="background: rgba(139, 92, 246, 0.15); color: #a78bfa; padding: 3px 8px; border-radius: 12px; font-size: 10px;">📺 Reality TV</span>
                    <span style="background: rgba(236, 72, 153, 0.15); color: #f472b6; padding: 3px 8px; border-radius: 12px; font-size: 10px;">💥 Kjendis Drama</span>
                    <span style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; padding: 3px 8px; border-radius: 12px; font-size: 10px;">🎬 Film & TV</span>
                    <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 3px 8px; border-radius: 12px; font-size: 10px;">🎵 Musikk</span>
                    <span style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; padding: 3px 8px; border-radius: 12px; font-size: 10px;">🌍 Internasjonalt</span>
                </div>
            </div>

            <!-- Duplicate Warning -->
            <div class="duplicate-warning" id="duplicate-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <span id="duplicate-message">Fant potensielle duplikater</span>
                <button class="btn btn-ghost" onclick="showDuplicatesOnly()" style="margin-left: auto;">Vis kun duplikater</button>
                <button class="btn btn-ghost" onclick="clearDuplicateFilter()">Vis alle</button>
            </div>

            <!-- Bulk Actions -->
            <div class="bulk-actions" id="bulk-actions">
                <input type="checkbox" id="select-all-bulk" onchange="toggleSelectAll()">
                <span><span id="selected-count">0</span> valgt</span>
                <button class="btn btn-ghost" onclick="bulkDelete()">
                    <i class="fas fa-trash"></i> Slett valgte
                </button>
                <button class="btn btn-ghost" onclick="bulkCategory()">
                    <i class="fas fa-tag"></i> Endre kategori
                </button>
                <button class="btn btn-ghost" onclick="clearSelection()">
                    <i class="fas fa-times"></i> Avbryt
                </button>
            </div>

            <!-- Toolbar -->
            <div class="toolbar">
                <div class="toolbar-left">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="search-input" placeholder="Søk i tittel, beskrivelse, notater..." onkeyup="filterSaker()">
                    </div>
                    
                    <select class="filter-select" id="filter-category" onchange="filterSaker()">
                        <option value="">Alle kategorier</option>
                        <option value="TALK">Talk</option>
                        <option value="MUSIC">Musikk</option>
                        <option value="NEWS">Nyheter</option>
                        <option value="BREAKING">Breaking</option>
                    </select>
                    
                    <select class="filter-select" id="filter-source" onchange="filterSaker()">
                        <option value="">Alle kilder</option>
                        <option value="VG">VG</option>
                        <option value="TV2">TV2</option>
                        <option value="Nettavisen">Nettavisen</option>
                        <option value="Dagbladet">Dagbladet</option>
                        <option value="NRK">NRK</option>
                        <option value="Se og Hør">Se og Hør</option>
                    </select>
                    
                    <button class="btn btn-ghost" onclick="toggleAdvancedFilters()" title="Avanserte filtre">
                        <i class="fas fa-filter"></i>
                    </button>
                </div>
                
                <div class="toolbar-right">
                    <button class="btn btn-ghost" onclick="refreshSaker()" title="Oppdater (R)">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                    <button class="btn btn-ghost" onclick="openShortcutsModal()" title="Tastatursnarveier (?)">
                        <i class="fas fa-keyboard"></i>
                    </button>
                </div>
            </div>

            <!-- Advanced Filters -->
            <div class="advanced-filters" id="advanced-filters">
                <div class="filter-group">
                    <label>Fra dato</label>
                    <input type="date" id="filter-date-from" onchange="filterSaker()">
                </div>
                <div class="filter-group">
                    <label>Til dato</label>
                    <input type="date" id="filter-date-to" onchange="filterSaker()">
                </div>
                <div class="filter-group">
                    <label>Sorter etter</label>
                    <select id="filter-sort" onchange="filterSaker()">
                        <option value="newest">Nyeste først</option>
                        <option value="oldest">Eldste først</option>
                        <option value="title">Tittel A-Å</option>
                        <option value="title-desc">Tittel Å-A</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Status</label>
                    <select id="filter-status" onchange="filterSaker()">
                        <option value="">Alle</option>
                        <option value="with-comments">Med kommentarer</option>
                        <option value="with-images">Med bilder</option>
                        <option value="with-url">Med lenke</option>
                    </select>
                </div>
            </div>

            <!-- Saker List -->
            <div class="saker-container">
                <div class="saker-header">
                    <div><input type="checkbox" id="select-all-header" onchange="toggleSelectAllVisible()"></div>
                    <div><i class="fas fa-grip-vertical"></i></div>
                    <div>Sak</div>
                    <div>Kategori</div>
                    <div>Tid</div>
                    <div style="text-align: right;">Handlinger</div>
                    <div></div>
                </div>
                
                <div class="saker-list" id="saker-list">
                    <!-- Saker injected here -->
                </div>
            </div>
        </main>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal-overlay" id="edit-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 id="edit-modal-title">Legg til Sak</h3>
                <button class="modal-close" onclick="closeEditModal()">&times;</button>
            </div>
            
            <div class="modal-body">
                <input type="hidden" id="sak-id">
                
                <div class="form-group">
                    <label>Tittel *</label>
                    <input type="text" id="sak-title" placeholder="Skriv en punchy tittel..." oninput="generateTitleSuggestions()">
                    <div class="ai-suggestions" id="title-suggestions">
                        <!-- AI suggestions injected here -->
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Beskrivelse</label>
                    <textarea id="sak-description" placeholder="2-3 setninger om saken..."></textarea>
                </div>
                
                <div class="form-row-3">
                    <div class="form-group">
                        <label>Kategori</label>
                        <select id="sak-category">
                            <option value="TALK">Talk</option>
                            <option value="MUSIC">Musikk</option>
                            <option value="NEWS">Nyheter</option>
                            <option value="BREAKING">Breaking</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label>Kilde</label>
                        <select id="sak-source">
                            <option value="VG">VG</option>
                            <option value="TV2">TV2</option>
                            <option value="Nettavisen">Nettavisen</option>
                            <option value="Dagbladet">Dagbladet</option>
                            <option value="NRK">NRK</option>
                            <option value="Se og Hør">Se og Hør</option>
                            <option value="Aftenposten">Aftenposten</option>
                            <option value="Annet">Annet</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label>Rekkefølge</label>
                        <input type="number" id="sak-order" placeholder="1" min="1">
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Lenke til artikkel</label>
                    <input type="url" id="sak-url" placeholder="https://..." onblur="checkForDuplicates()">
                </div>
                
                <div class="form-group">
                    <label>Notater</label>
                    <textarea id="sak-notes" placeholder="Essens + hvorfor NRJ + kilde..."></textarea>
                </div>
                
                <div class="form-group">
                    <label>Bilde URL</label>
                    <input type="url" id="sak-image" placeholder="https://..." onchange="updateImagePreview()">
                    <div class="image-preview" id="image-preview">
                        <span class="placeholder">Ingen bilde valgt</span>
                    </div>
                </div>
                
                <!-- Comments Section in Edit Modal -->
                <div class="comments-section" id="edit-comments-section" style="display: none;">
                    <h4><i class="fas fa-comments"></i> Kommentarer</h4>
                    <div class="comment-list" id="edit-comment-list">
                        <!-- Comments injected here -->
                    </div>
                    <div class="comment-input">
                        <input type="text" id="edit-comment-input" placeholder="Skriv en kommentar..." onkeypress="if(event.key==='Enter') addCommentFromEdit()">
                        <button class="btn btn-primary" onclick="addCommentFromEdit()">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer">
                <div class="modal-footer-left">
                    <span id="auto-save-status"></span>
                </div>
                <div class="modal-footer-right">
                    <button class="btn btn-secondary" onclick="closeEditModal()">Avbryt</button>
                    <button class="btn btn-ghost" onclick="openVersionHistory()" id="btn-version-history" style="display: none;">
                        <i class="fas fa-history"></i> Versjonshistorikk
                    </button>
                    <button class="btn btn-primary" onclick="saveSak()">
                        <i class="fas fa-save"></i> Lagre
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="modal-overlay preview-modal" id="preview-modal">
        <div class="modal">
            <div class="modal-header">
                <h3>Forhåndsvisning</h3>
                <button class="modal-close" onclick="closePreviewModal()">&times;</button>
            </div>
            
            <div class="modal-body">
                <div class="preview-content">
                    <img loading="lazy" class="preview-image" id="preview-image" src="" alt="" style="display: none;">
                    
                    <h2 class="preview-title" id="preview-title"></h2>
                    
                    <p class="preview-description" id="preview-description"></p>
                    
                    <div class="preview-notes" id="preview-notes"></div>
                    
                    <div class="preview-meta">
                        <span><i class="fas fa-folder"></i> <span id="preview-category"></span></span>
                        <span><i class="fas fa-clock"></i> <span id="preview-time"></span></span>
                        <span><i class="fas fa-link"></i> <a id="preview-link" href="#" target="_blank">Les artikkel</a></span>
                    </div>
                </div>
                
                <!-- Comments Section -->
                <div class="comments-section">
                    <h4><i class="fas fa-comments"></i> Kommentarer <span id="preview-comment-count"></span></h4>
                    <div class="comment-list" id="preview-comment-list">
                        <!-- Comments injected here -->
                    </div>
                    <div class="comment-input">
                        <input type="text" id="preview-comment-input" placeholder="Skriv en kommentar..." onkeypress="if(event.key==='Enter') addCommentFromPreview()">
                        <button class="btn btn-primary" onclick="addCommentFromPreview()">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closePreviewModal()">Lukk</button>
                <button class="btn btn-ghost" onclick="openVersionHistoryFromPreview()">
                    <i class="fas fa-history"></i> Historikk
                </button>
                <button class="btn btn-primary" onclick="editFromPreview()">
                    <i class="fas fa-edit"></i> Rediger
                </button>
            </div>
        </div>
    </div>

    <!-- Version History Modal -->
    <div class="modal-overlay" id="version-modal">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-history"></i> Versjonshistorikk</h3>
                <button class="modal-close" onclick="closeVersionModal()">&times;</button>
            </div>
            
            <div class="modal-body">
                <div class="version-list" id="version-list">
                    <!-- Versions injected here -->
                </div>
            </div>
            
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeVersionModal()">Lukk</button>
            </div>
        </div>
    </div>

    <!-- Export Modal -->
    <div class="modal-overlay" id="export-modal">
        <div class="modal" style="max-width: 500px;">
            <div class="modal-header">
                <h3><i class="fas fa-download"></i> Eksporter Saker</h3>
                <button class="modal-close" onclick="closeExportModal()">&times;</button>
            </div>
            
            <div class="modal-body">
                <div class="form-group">
                    <label>Velg format</label>
                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <button class="btn btn-primary" onclick="exportToPDF()" style="flex: 1;">
                            <i class="fas fa-file-pdf"></i> PDF
                        </button>
                        <button class="btn btn-success" onclick="exportToExcel()" style="flex: 1;">
                            <i class="fas fa-file-excel"></i> Excel
                        </button>
                        <button class="btn btn-secondary" onclick="exportSaker()" style="flex: 1;">
                            <i class="fas fa-file-code"></i> JSON
                        </button>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Eksporter</label>
                    <select id="export-scope" class="filter-select" style="width: 100%;">
                        <option value="all">Alle saker</option>
                        <option value="filtered">Filtrerte saker</option>
                        <option value="selected">Valgte saker</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>
                        <input type="checkbox" id="export-include-comments" checked>
                        Inkluder kommentarer
                    </label>
                </div>
                
                <div class="form-group">
                    <label>
                        <input type="checkbox" id="export-include-history" checked>
                        Inkluder versjonshistorikk
                    </label>
                </div>
            </div>
            
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeExportModal()">Avbryt</button>
            </div>
        </div>
    </div>

    <!-- Keyboard Shortcuts Modal -->
    <div class="modal-overlay shortcuts-modal" id="shortcuts-modal">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-keyboard"></i> Tastatursnarveier</h3>
                <button class="modal-close" onclick="closeShortcutsModal()">&times;</button>
            </div>
            
            <div class="modal-body">
                <div class="shortcuts-grid">
                    <div class="shortcut-category">
                        <h4>Generelt</h4>
                        <div class="shortcut-item">
                            <span>Ny sak</span>
                            <div class="shortcut-keys"><kbd>N</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Oppdater liste</span>
                            <div class="shortcut-keys"><kbd>R</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Søk</span>
                            <div class="shortcut-keys"><kbd>/</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Lukk modal</span>
                            <div class="shortcut-keys"><kbd>Esc</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Bytt tema</span>
                            <div class="shortcut-keys"><kbd>T</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Utskrift</span>
                            <div class="shortcut-keys"><kbd>P</kbd></div>
                        </div>
                    </div>
                    
                    <div class="shortcut-category">
                        <h4>Navigasjon</h4>
                        <div class="shortcut-item">
                            <span>Forrige sak</span>
                            <div class="shortcut-keys"><kbd>↑</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Neste sak</span>
                            <div class="shortcut-keys"><kbd>↓</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Velg sak</span>
                            <div class="shortcut-keys"><kbd>Space</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Rediger sak</span>
                            <div class="shortcut-keys"><kbd>E</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Forhåndsvis</span>
                            <div class="shortcut-keys"><kbd>V</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Slett sak</span>
                            <div class="shortcut-keys"><kbd>Del</kbd></div>
                        </div>
                    </div>
                    
                    <div class="shortcut-category">
                        <h4>Valg</h4>
                        <div class="shortcut-item">
                            <span>Velg alle</span>
                            <div class="shortcut-keys"><kbd>Ctrl</kbd>+<kbd>A</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Velg ingen</span>
                            <div class="shortcut-keys"><kbd>Ctrl</kbd>+<kbd>D</kbd></div>
                        </div>
                        <div class="shortcut-item">
                            <span>Inverter valg</span>
                            <div class="shortcut-keys"><kbd>Ctrl</kbd>+<kbd>I</kbd></div>
                        </div>
                    </div>
                    
                    <div class="shortcut-category">
                        <h4>Hjelp</h4>
                        <div class="shortcut-item">
                            <span>Vis denne hjelpen</span>
                            <div class="shortcut-keys"><kbd>?</kbd> eller <kbd>H</kbd></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="closeShortcutsModal()">Lukk</button>
            </div>
        </div>
    </div>

    <!-- Notification Container -->
    <div class="notification-container" id="notification-container"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    <script src="sakslista-pro.js"></script>
<script src="auto-nav.js"></script>
</body>
</html>