<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mission Control - AI Assistant</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #667eea; --primary-dark: #764ba2; --success: #10b981;
            --warning: #f59e0b; --danger: #ef4444; --info: #3b82f6;
            --dark: #0f172a; --dark-light: #1e293b; --text: #e2e8f0;
            --text-muted: #94a3b8; --text-dim: #64748b;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, var(--dark) 0%, var(--dark-light) 100%);
            color: var(--text); min-height: 100vh;
        }
        .container { display: flex; min-height: 100vh; }
        .sidebar {
            width: 280px; background: rgba(30, 41, 59, 0.98); padding: 24px;
            border-right: 1px solid rgba(255,255,255,0.1); position: fixed;
            height: 100vh; overflow-y: auto; z-index: 100;
        }
        .logo { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; }
        .logo-icon { width: 48px; height: 48px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .nav { list-style: none; }
        .nav li { margin-bottom: 8px; }
        .nav a { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; color: var(--text-muted); text-decoration: none; transition: all 0.2s; }
        .nav a:hover, .nav a.active { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; }
        .main { flex: 1; margin-left: 280px; padding: 32px; }
        .chat-container { 
            background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px; height: calc(100vh - 140px); display: flex; flex-direction: column;
        }
        .chat-header { 
            padding: 20px 24px; border-bottom: 1px solid rgba(255,255,255,0.1);
            display: flex; align-items: center; gap: 12px;
        }
        .chat-header .ai-avatar { 
            width: 40px; height: 40px; border-radius: 50%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: flex; align-items: center; justify-content: center;
        }
        .chat-messages { flex: 1; overflow-y: auto; padding: 24px; }
        .message { margin-bottom: 16px; max-width: 80%; }
        .message.user { margin-left: auto; }
        .message-content { 
            padding: 12px 16px; border-radius: 12px; font-size: 14px; line-height: 1.5;
        }
        .message.ai .message-content { 
            background: rgba(102, 126, 234, 0.2); border: 1px solid rgba(102, 126, 234, 0.3);
        }
        .message.user .message-content { 
            background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.3);
        }
        .chat-input { 
            padding: 20px 24px; border-top: 1px solid rgba(255,255,255,0.1);
            display: flex; gap: 12px;
        }
        .chat-input input { 
            flex: 1; padding: 12px 16px; background: rgba(15, 23, 42, 0.5);
            border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;
            color: white; font-size: 14px;
        }
        .chat-input button { 
            padding: 12px 24px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none; border-radius: 8px; color: white; cursor: pointer;
        }
        .suggestions { 
            display: flex; flex-wrap: wrap; gap: 8px; padding: 12px 24px;
            border-top: 1px solid rgba(255,255,255,0.05);
        }
        .suggestion-chip { 
            padding: 8px 16px; background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1); border-radius: 20px;
            font-size: 13px; cursor: pointer; transition: all 0.2s;
        }
        .suggestion-chip:hover { background: rgba(102, 126, 234, 0.2); }
        .typing-indicator { display: flex; gap: 4px; padding: 12px 16px; }
        .typing-indicator span { 
            width: 8px; height: 8px; background: var(--text-muted);
            border-radius: 50%; animation: typing 1.4s infinite;
        }
        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typing {
            0%, 100% { opacity: 0.3; transform: translateY(0); }
            50% { opacity: 1; transform: translateY(-4px); }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Standard Navigation Template - Copy this to all HTML files -->
<aside class="sidebar">
    <div class="logo">
        <div class="logo-icon">🚀</div>
        <div>
            <h1 style="font-size: 18px; margin: 0;">Mission Control</h1>
            <p style="font-size: 11px; color: #94a3b8; margin: 4px 0 0 0;">v3.0</p>
        </div>
    </div>
    <ul class="nav">
        <li><a href="total-control.html"><i class="fas fa-home"></i> Oversikt</a></li>
        <li><a href="sakslista-pro.html"><i class="fas fa-list"></i> Saker</a></li>
        <li><a href="analytics.html"><i class="fas fa-chart-line"></i> Analyse</a></li>
        <li><a href="ai-assistant.html" class="active"><i class="fas fa-robot"></i> AI Assistant</a></li>
        <li><a href="widget-dashboard.html"><i class="fas fa-th-large"></i> Widgets</a></li>
        <li><a href="podkast-control.html"><i class="fas fa-podcast"></i> Podkast</a></li>
        <li><a href="cron-control.html"><i class="fas fa-clock"></i> Cron</a></li>
        <li><a href="agent-control.html"><i class="fas fa-robot"></i> Agent</a></li>
        <li><a href="notifications.html"><i class="fas fa-bell"></i> Varsler</a></li>
        <li><a href="system-monitor.html"><i class="fas fa-heartbeat"></i> System</a></li>
        <li><a href="database-admin.html"><i class="fas fa-database"></i> Database</a></li>
        <li><a href="git-control.html"><i class="fas fa-code-branch"></i> Git</a></li>
        <li><a href="api-docs.html"><i class="fas fa-book"></i> API Docs</a></li>
        <li><a href="innstillinger.html"><i class="fas fa-cog"></i> Innstillinger</a></li>
    </ul>
</aside>

        <main class="main">
            <div class="chat-container">
                <div class="chat-header">
                    <div class="ai-avatar"><i class="fas fa-robot"></i></div>
                    <div>
                        <h3>BaarliClaw AI</h3>
                        <p style="font-size: 12px; color: var(--text-muted);">Online • Klar til å hjelpe</p>
                    </div>
                </div>
                
                <div class="chat-messages" id="chat-messages">
                    <div class="message ai">
                        <div class="message-content">
                            Hei! Jeg er BaarliClaw AI, din personlige assistent for Mission Control. 
                            Jeg kan hjelpe deg med å:
                            <ul style="margin-top: 8px; padding-left: 20px;">
                                <li>Kjøre Morning Routine</li>
                                <li>Analysere data og trender</li>
                                <li>Generere rapporter</li>
                                <li>Svare på spørsmål om systemet</li>
                            </ul>
                            Hva kan jeg hjelpe deg med i dag?
                        </div>
                    </div>
                </div>
                
                <div class="suggestions">
                    <div class="suggestion-chip" onclick="sendSuggestion('Kjør Morning Routine')">🌅 Kjør Morning Routine</div>
                    <div class="suggestion-chip" onclick="sendSuggestion('Vis dagens saker')">📋 Vis dagens saker</div>
                    <div class="suggestion-chip" onclick="sendSuggestion('Generer rapport')">📊 Generer rapport</div>
                    <div class="suggestion-chip" onclick="sendSuggestion('Sjekk systemstatus')">🔍 Sjekk systemstatus</div>
                </div>
                
                <div class="chat-input">
                    <input type="text" id="user-input" placeholder="Skriv en melding..." onkeypress="handleKeyPress(event)">
                    <button onclick="sendMessage()"><i class="fas fa-paper-plane"></i> Send</button>
                </div>
            </div>
        </main>
    </div>

    <script>
        const SUPABASE_URL = 'https://kvniauxokdtmpvjtfnej.supabase.co';
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt2bmlhdXhva2R0bXB2anRmbmVqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1MTM2NzIzNCwiZXhwIjoyMDY2OTQzMjM0fQ.OkhTtq9QAQ3xMzZYKyWyCjj7PiqMZJKSvpA0jcBJqpE';
        const API_BASE = 'http://47.84.19.119:8081/api';

        function handleKeyPress(e) {
            if (e.key === 'Enter') sendMessage();
        }

        function sendSuggestion(text) {
            document.getElementById('user-input').value = text;
            sendMessage();
        }

        async function sendMessage() {
            const input = document.getElementById('user-input');
            const message = input.value.trim();
            if (!message) return;

            // Add user message
            addMessage(message, 'user');
            input.value = '';

            // Show typing indicator
            showTyping();

            // Process command
            await processCommand(message);
        }

        function addMessage(text, sender) {
            const container = document.getElementById('chat-messages');
            const div = document.createElement('div');
            div.className = `message ${sender}`;
            div.innerHTML = `<div class="message-content">${text}</div>`;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        function showTyping() {
            const container = document.getElementById('chat-messages');
            const typing = document.createElement('div');
            typing.className = 'message ai typing';
            typing.id = 'typing-indicator';
            typing.innerHTML = `
                <div class="message-content">
                    <div class="typing-indicator">
                        <span></span><span></span><span></span>
                    </div>
                </div>`;
            container.appendChild(typing);
            container.scrollTop = container.scrollHeight;
        }

        function hideTyping() {
            const typing = document.getElementById('typing-indicator');
            if (typing) typing.remove();
        }

        async function processCommand(message) {
            const lowerMsg = message.toLowerCase();
            
            if (lowerMsg.includes('morning routine') || lowerMsg.includes('morgen')) {
                await runMorningRoutine();
            } else if (lowerMsg.includes('saker') || lowerMsg.includes('dagens')) {
                await showTodaysSaker();
            } else if (lowerMsg.includes('rapport') || lowerMsg.includes('report')) {
                await generateReport();
            } else if (lowerMsg.includes('status') || lowerMsg.includes('system')) {
                await checkSystemStatus();
            } else if (lowerMsg.includes('hjelp') || lowerMsg.includes('help')) {
                showHelp();
            } else {
                // General response
                setTimeout(() => {
                    hideTyping();
                    addMessage('Jeg forstår. La meg hjelpe deg med det. Hva mer trenger du?', 'ai');
                }, 1000);
            }
        }

        async function runMorningRoutine() {
            try {
                const response = await fetch(`${API_BASE}/routine/morning`, { method: 'POST' });
                hideTyping();
                if (response.ok) {
                    addMessage('✅ Morning Routine er startet! Dette tar ca 3-5 minutter. Jeg vil varsle deg når den er ferdig.', 'ai');
                } else {
                    addMessage('⚠️ Kunne ikke starte Morning Routine. Sjekk at backend er tilgjengelig.', 'ai');
                }
            } catch (error) {
                hideTyping();
                addMessage('❌ Feil ved kontakt med backend: ' + error.message, 'ai');
            }
        }

        async function showTodaysSaker() {
            try {
                const today = new Date().toISOString().split('T')[0];
                const response = await fetch(
                    `${SUPABASE_URL}/rest/v1/agenda_items?tenant_id=eq.a0000000-0000-0000-0000-000000000001&show_date=eq.${today}`,
                    { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` } }
                );
                
                hideTyping();
                if (response.ok) {
                    const saker = await response.json();
                    if (saker.length === 0) {
                        addMessage('📭 Ingen saker funnet for i dag. Vil du kjøre Morning Routine for å hente nye saker?', 'ai');
                    } else {
                        let msg = `📋 **Dagens saker (${saker.length} stk):**\n\n`;
                        saker.slice(0, 5).forEach((sak, i) => {
                            msg += `${i+1}. **${sak.title}**\n`;
                            if (sak.notes) msg += `   _${sak.notes.substring(0, 100)}..._\n\n`;
                        });
                        if (saker.length > 5) msg += `\n...og ${saker.length - 5} til. Se alle i Sakslista.`;
                        addMessage(msg, 'ai');
                    }
                }
            } catch (error) {
                hideTyping();
                addMessage('❌ Kunne ikke hente saker: ' + error.message, 'ai');
            }
        }

        async function generateReport() {
            hideTyping();
            addMessage('📊 **Genererer rapport...**\n\nJeg samler data fra:\n• Saksliste-statistikk\n• Nielsen radio-tall\n• Podtoppen rangering\n• System-helse\n\nRapporten vil være klar om kort tid!', 'ai');
        }

        async function checkSystemStatus() {
            try {
                const response = await fetch(`${API_BASE}/status`);
                hideTyping();
                if (response.ok) {
                    const status = await response.json();
                    addMessage(`✅ **System Status**\n\n🟢 Backend: ${status.status}\n🟢 Database: ${status.database || 'Connected'}\n🟢 API: Operational\n\nAlt ser bra ut!`, 'ai');
                } else {
                    addMessage('⚠️ Backend svarer, men med feil. Sjekk loggene.', 'ai');
                }
            } catch (error) {
                hideTyping();
                addMessage('🔴 **System Status**\n\n❌ Backend: Utilgjengelig\n⚠️ Sjekk at API-server kjører på port 8081\n\nFeil: ' + error.message, 'ai');
            }
        }

        function showHelp() {
            hideTyping();
            addMessage(`🤖 **Jeg kan hjelpe deg med:**

🌅 **Kjør Morning Routine** - Hent ferske nyheter
📋 **Vis dagens saker** - Se hva som er planlagt
📊 **Generer rapport** - Få full systemoversikt
🔍 **Sjekk systemstatus** - Verifiser at alt fungerer

Du kan også spørre meg om spesifikke ting som:
• "Hvor mange saker har vi denne uken?"
• "Hva er NRJs lyttertall?"
• "Vis meg podkast-statistikk"`, 'ai');
        }
    </script>
<script src="auto-nav.js"></script>
</body>
</html>
