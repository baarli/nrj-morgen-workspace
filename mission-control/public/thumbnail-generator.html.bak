<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Auto-Thumbnail Generator | Mission Control</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --bg-tertiary: #334155;
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-purple: #667eea;
            --accent-purple-dark: #764ba2;
            --accent-blue: #3b82f6;
            --accent-cyan: #06b6d4;
            --accent-pink: #ec4899;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #3b82f6;
            --border: rgba(255,255,255,0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
        }

        .app-container {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 280px;
            background: rgba(30, 41, 59, 0.98);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            z-index: 100;
            overflow-y: auto;
        }

        .sidebar-header {
            padding: 24px;
            border-bottom: 1px solid var(--border);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-purple-dark) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .logo-text h1 { font-size: 18px; margin-bottom: 2px; }
        .logo-text p { font-size: 11px; color: var(--text-secondary); }

        .nav {
            list-style: none;
            padding: 16px 12px;
            flex: 1;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-section-title {
            padding: 8px 16px;
            font-size: 11px;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            color: var(--text-secondary);
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            margin-bottom: 4px;
            font-size: 14px;
        }

        .nav-item:hover, .nav-item.active {
            background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-purple-dark) 100%);
            color: white;
        }

        .nav-item i { width: 20px; text-align: center; }

        /* Main Content */
        .main {
            flex: 1;
            margin-left: 280px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Top Bar */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 32px;
            background: rgba(30, 41, 59, 0.5);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        .breadcrumb .current { color: var(--text-primary); font-weight: 600; }

        .top-actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn:hover { transform: translateY(-1px); opacity: 0.9; }
        .btn-primary { background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-purple-dark) 100%); color: white; }
        .btn-success { background: var(--success); color: white; }
        .btn-danger { background: var(--danger); color: white; }
        .btn-warning { background: var(--warning); color: white; }
        .btn-secondary { background: rgba(255,255,255,0.1); color: white; }
        .btn-ghost { background: transparent; color: var(--text-secondary); border: 1px solid var(--border); }
        .btn-ghost:hover { background: rgba(255,255,255,0.05); color: white; }
        .btn-sm { padding: 6px 12px; font-size: 12px; }
        .btn-icon { padding: 10px; border-radius: 8px; }

        /* Content Area */
        .content {
            flex: 1;
            padding: 24px 32px;
            overflow-y: auto;
        }

        /* Tab Navigation */
        .tab-nav {
            display: flex;
            gap: 4px;
            padding: 4px;
            background: rgba(15, 23, 42, 0.5);
            border-radius: 12px;
            margin-bottom: 24px;
            overflow-x: auto;
        }

        .tab-btn {
            padding: 12px 20px;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.2s;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tab-btn:hover { color: var(--text-primary); }
        .tab-btn.active {
            background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-purple-dark) 100%);
            color: white;
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.3s ease; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Cards */
        .card {
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 24px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card:hover { transform: translateY(-2px); box-shadow: 0 10px 40px rgba(0,0,0,0.2); }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .card-title {
            font-size: 16px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Section */
        .section {
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
        }

        .stat-card h3 {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-card .value {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 4px;
        }

        .stat-card .label {
            font-size: 13px;
            color: var(--text-muted);
        }

        /* Form Elements */
        .form-group { margin-bottom: 20px; }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px 16px;
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: white;
            font-size: 14px;
            outline: none;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus { border-color: var(--accent-purple); }

        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }

        /* Template Grid */
        .template-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .template-card {
            background: rgba(15, 23, 42, 0.5);
            border: 2px solid var(--border);
            border-radius: 12px;
            padding: 16px;
            cursor: pointer;
            transition: all 0.2s;
            text-align: center;
        }

        .template-card:hover {
            border-color: var(--accent-purple);
            transform: translateY(-2px);
        }

        .template-card.active {
            border-color: var(--accent-purple);
            background: rgba(102, 126, 234, 0.1);
        }

        .template-icon {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .template-name {
            font-size: 14px;
            font-weight: 600;
        }

        .template-dims {
            font-size: 11px;
            color: var(--text-muted);
        }

        /* Canvas Preview */
        .canvas-container {
            background: rgba(15, 23, 42, 0.7);
            border-radius: 12px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        .canvas-wrapper {
            background: #000;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

        #thumbnailCanvas {
            display: block;
            max-width: 100%;
            height: auto;
        }

        /* Color Picker */
        .color-picker-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .color-option {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            cursor: pointer;
            border: 3px solid transparent;
            transition: all 0.2s;
        }

        .color-option:hover { transform: scale(1.1); }
        .color-option.active { border-color: white; box-shadow: 0 0 0 2px var(--accent-purple); }

        /* Font Selector */
        .font-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 8px;
        }

        .font-option {
            padding: 12px;
            background: rgba(15, 23, 42, 0.5);
            border: 2px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            font-size: 16px;
            transition: all 0.2s;
        }

        .font-option:hover { border-color: var(--accent-purple); }
        .font-option.active {
            border-color: var(--accent-purple);
            background: rgba(102, 126, 234, 0.1);
        }

        /* Clip List */
        .clip-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .clip-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: rgba(15, 23, 42, 0.5);
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .clip-item:hover { background: rgba(15, 23, 42, 0.7); }
        .clip-item.selected { background: rgba(102, 126, 234, 0.2); border: 1px solid var(--accent-purple); }

        .clip-checkbox {
            width: 20px;
            height: 20px;
            accent-color: var(--accent-purple);
        }

        .clip-info { flex: 1; }
        .clip-title { font-size: 14px; font-weight: 500; }
        .clip-meta { font-size: 12px; color: var(--text-muted); }

        /* Progress Bar */
        .progress-bar {
            height: 8px;
            background: rgba(255,255,255,0.1);
            border-radius: 4px;
            overflow: hidden;
            margin-top: 8px;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent-purple), var(--accent-purple-dark));
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        /* Batch Queue */
        .batch-queue {
            max-height: 300px;
            overflow-y: auto;
        }

        .batch-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: rgba(15, 23, 42, 0.5);
            border-radius: 8px;
            margin-bottom: 8px;
        }

        .batch-status {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .batch-status.pending { background: var(--warning); }
        .batch-status.processing { background: var(--info); animation: pulse 1s infinite; }
        .batch-status.complete { background: var(--success); }
        .batch-status.error { background: var(--danger); }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* AI Analysis Result */
        .ai-result {
            background: rgba(102, 126, 234, 0.1);
            border: 1px solid var(--accent-purple);
            border-radius: 8px;
            padding: 16px;
            margin-top: 16px;
        }

        .ai-result h4 {
            color: var(--accent-purple);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .ai-suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 12px;
        }

        .ai-suggestion {
            padding: 6px 12px;
            background: rgba(102, 126, 234, 0.2);
            border-radius: 20px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .ai-suggestion:hover {
            background: var(--accent-purple);
            color: white;
        }

        /* Image Upload */
        .upload-zone {
            border: 2px dashed var(--border);
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .upload-zone:hover {
            border-color: var(--accent-purple);
            background: rgba(102, 126, 234, 0.05);
        }

        .upload-zone i {
            font-size: 48px;
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        .upload-zone p {
            color: var(--text-secondary);
        }

        /* Gallery */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
        }

        .gallery-item {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.2s;
        }

        .gallery-item:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .gallery-item img {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }

        .gallery-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 12px;
            background: linear-gradient(transparent, rgba(0,0,0,0.8));
        }

        .gallery-title {
            font-size: 12px;
            font-weight: 500;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .sidebar { width: 240px; }
            .main { margin-left: 240px; }
        }

        @media (max-width: 768px) {
            .sidebar { display: none; }
            .main { margin-left: 0; }
            .stats-grid { grid-template-columns: 1fr; }
            .tab-nav { flex-wrap: wrap; }
        }

        /* Utility */
        .hidden { display: none !important; }
        .text-success { color: var(--success); }
        .text-danger { color: var(--danger); }
        .text-warning { color: var(--warning); }
        .text-muted { color: var(--text-muted); }
        .flex { display: flex; }
        .flex-col { flex-direction: column; }
        .gap-2 { gap: 8px; }
        .gap-4 { gap: 16px; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .mt-4 { margin-top: 16px; }
        .mb-4 { margin-bottom: 16px; }
        .w-full { width: 100%; }

        /* Range Slider */
        input[type="range"] {
            width: 100%;
            height: 6px;
            background: rgba(255,255,255,0.1);
            border-radius: 3px;
            outline: none;
            -webkit-appearance: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            background: var(--accent-purple);
            border-radius: 50%;
            cursor: pointer;
        }

        /* Loading Spinner */
        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(255,255,255,0.1);
            border-top-color: var(--accent-purple);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Toast Notification */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .toast {
            padding: 16px 20px;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideIn 0.3s ease;
            min-width: 300px;
        }

        .toast.success { border-left: 4px solid var(--success); }
        .toast.error { border-left: 4px solid var(--danger); }
        .toast.warning { border-left: 4px solid var(--warning); }
        .toast.info { border-left: 4px solid var(--info); }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <div class="logo-icon">🎨</div>
                    <div class="logo-text">
                        <h1>Thumbnail Gen</h1>
                        <p>AI-Powered Studio</p>
                    </div>
                </div>
            </div>
            
            <ul class="nav">
                <div class="nav-section">
                    <div class="nav-section-title">Verktøy</div>
                    <li class="nav-item active" onclick="showTab('generator')">
                        <i class="fas fa-magic"></i> Generator
                    </li>
                    <li class="nav-item" onclick="showTab('batch')">
                        <i class="fas fa-layer-group"></i> Batch
                    </li>
                    <li class="nav-item" onclick="showTab('gallery')">
                        <i class="fas fa-images"></i> Galleri
                    </li>
                    <li class="nav-item" onclick="showTab('templates')">
                        <i class="fas fa-palette"></i> Templates
                    </li>
                </div>
                
                <div class="nav-section">
                    <div class="nav-section-title">AI</div>
                    <li class="nav-item" onclick="showTab('ai-analyze')">
                        <i class="fas fa-brain"></i> Analyser
                    </li>
                    <li class="nav-item" onclick="showTab('ai-suggest')">
                        <i class="fas fa-lightbulb"></i> Forslag
                    </li>
                </div>
                
                <div class="nav-section">
                    <div class="nav-section-title">Innstillinger</div>
                    <li class="nav-item" onclick="showTab('settings')">
                        <i class="fas fa-cog"></i> Konfigurasjon
                    </li>
                </div>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main">
            <!-- Top Bar -->
            <div class="top-bar">
                <div class="breadcrumb">
                    <span>Mission Control</span>
                    <i class="fas fa-chevron-right" style="font-size: 12px; color: var(--text-muted);"></i>
                    <span class="current">Auto-Thumbnail Generator</span>
                </div>
                
                <div class="top-actions">
                    <button class="btn btn-ghost btn-sm" onclick="resetCanvas()">
                        <i class="fas fa-undo"></i> Tilbakestill
                    </button>
                    <button class="btn btn-primary" onclick="downloadThumbnail()">
                        <i class="fas fa-download"></i> Last ned
                    </button>
                </div>
            </div>

            <!-- Content Area -->
            <div class="content">
                <!-- GENERATOR TAB -->
                <div id="tab-generator" class="tab-content active">
                    <div class="stats-grid">
                        <div class="stat-card">
                            <h3>🎨 Generert</h3>
                            <div class="value" id="stat-generated">0</div>
                            <div class="label">Thumbnails i dag</div>
                        </div>
                        <div class="stat-card">
                            <h3>⚡ Batch</h3>
                            <div class="value" id="stat-batch">0</div>
                            <div class="label">I kø</div>
                        </div>
                        <div class="stat-card">
                            <h3>🤖 AI</h3>
                            <div class="value text-success">Klar</div>
                            <div class="label">Analyse status</div>
                        </div>
                        <div class="stat-card">
                            <h3>💾 Lagret</h3>
                            <div class="value" id="stat-saved">0</div>
                            <div class="label">I galleri</div>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 400px; gap: 24px;">
                        <!-- Left: Canvas Preview -->
                        <div class="canvas-container">
                            <div class="canvas-wrapper">
                                <canvas id="thumbnailCanvas" width="1080" height="1080"></canvas>
                            </div>
                            <div class="flex gap-2" style="justify-content: center;">
                                <button class="btn btn-secondary btn-sm" onclick="zoomCanvas(-0.1)">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <span id="zoomLevel" style="padding: 8px 16px;">100%</span>
                                <button class="btn btn-secondary btn-sm" onclick="zoomCanvas(0.1)">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Right: Controls -->
                        <div>
                            <!-- Template Selection -->
                            <div class="section">
                                <div class="section-header">
                                    <h3 class="section-title"><i class="fas fa-crop-alt" style="color: var(--accent-purple);"></i> Format</h3>
                                </div>
                                <div class="template-grid">
                                    <div class="template-card active" data-template="instagram" onclick="selectTemplate('instagram')">
                                        <div class="template-icon">📷</div>
                                        <div class="template-name">Instagram</div>
                                        <div class="template-dims">1080×1080</div>
                                    </div>
                                    <div class="template-card" data-template="tiktok" onclick="selectTemplate('tiktok')">
                                        <div class="template-icon">🎵</div>
                                        <div class="template-name">TikTok</div>
                                        <div class="template-dims">1080×1920</div>
                                    </div>
                                    <div class="template-card" data-template="youtube" onclick="selectTemplate('youtube')">
                                        <div class="template-icon">▶️</div>
                                        <div class="template-name">YouTube</div>
                                        <div class="template-dims">1280×720</div>
                                    </div>
                                    <div class="template-card" data-template="twitter" onclick="selectTemplate('twitter')">
                                        <div class="template-icon">🐦</div>
                                        <div class="template-name">Twitter</div>
                                        <div class="template-dims">1200×675</div>
                                    </div>
                                    <div class="template-card" data-template="facebook" onclick="selectTemplate('facebook')">
                                        <div class="template-icon">👥</div>
                                        <div class="template-name">Facebook</div>
                                        <div class="template-dims">1200×630</div>
                                    </div>
                                    <div class="template-card" data-template="stories" onclick="selectTemplate('stories')">
                                        <div class="template-icon">📱</div>
                                        <div class="template-name">Stories</div>
                                        <div class="template-dims">1080×1920</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Text Settings -->
                            <div class="section">
                                <div class="section-header">
                                    <h3 class="section-title"><i class="fas fa-font" style="color: var(--accent-blue);"></i> Tekst</h3>
                                </div>
                                <div class="form-group">
                                    <label>Hovedtittel</label>
                                    <input type="text" id="mainTitle" placeholder="Skriv tittel..." value="Baarli og Benjamin" oninput="updateCanvas()">
                                </div>
                                <div class="form-group">
                                    <label>Undertittel</label>
                                    <input type="text" id="subTitle" placeholder="Skriv undertittel..." value="Går i terapi" oninput="updateCanvas()">
                                </div>
                                <div class="form-group">
                                    <label>Episode #</label>
                                    <input type="text" id="episodeNum" placeholder="F.eks. EP.157" value="EP.157" oninput="updateCanvas()">
                                </div>
                            </div>

                            <!-- Style Settings -->
                            <div class="section">
                                <div class="section-header">
                                    <h3 class="section-title"><i class="fas fa-paint-brush" style="color: var(--accent-cyan);"></i> Stil</h3>
                                </div>
                                <div class="form-group">
                                    <label>Bakgrunnsfarge</label>
                                    <div class="color-picker-group">
                                        <div class="color-option active" style="background: linear-gradient(135deg, #667eea, #764ba2)" data-gradient="purple" onclick="selectColor('purple')"></div>
                                        <div class="color-option" style="background: linear-gradient(135deg, #f093fb, #f5576c)" data-gradient="pink" onclick="selectColor('pink')"></div>
                                        <div class="color-option" style="background: linear-gradient(135deg, #4facfe, #00f2fe)" data-gradient="blue" onclick="selectColor('blue')"></div>
                                        <div class="color-option" style="background: linear-gradient(135deg, #43e97b, #38f9d7)" data-gradient="green" onclick="selectColor('green')"></div>
                                        <div class="color-option" style="background: linear-gradient(135deg, #fa709a, #fee140)" data-gradient="orange" onclick="selectColor('orange')"></div>
                                        <div class="color-option" style="background: linear-gradient(135deg, #30cfd0, #330867)" data-gradient="dark" onclick="selectColor('dark')"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Font</label>
                                    <div class="font-grid">
                                        <div class="font-option active" data-font="bold" onclick="selectFont('bold')" style="font-weight: bold;">Bold</div>
                                        <div class="font-option" data-font="modern" onclick="selectFont('modern')" style="font-family: 'Arial Black', sans-serif;">Modern</div>
                                        <div class="font-option" data-font="elegant" onclick="selectFont('elegant')" style="font-family: Georgia, serif;">Elegant</div>
                                        <div class="font-option" data-font="playful" onclick="selectFont('playful')" style="font-family: 'Comic Sans MS', cursive;">Playful</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Image Upload -->
                            <div class="section">
                                <div class="section-header">
                                    <h3 class="section-title"><i class="fas fa-image" style="color: var(--accent-pink);"></i> Bilde</h3>
                                </div>
                                <div class="upload-zone" onclick="document.getElementById('imageUpload').click()">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <p>Dra og slipp bilde her, eller klikk for å velge</p>
                                    <input type="file" id="imageUpload" accept="image/*" style="display: none;" onchange="handleImageUpload(event)">
                                </div>
                                <div id="uploadedImagePreview" class="mt-4 hidden">
                                    <img loading="lazy" id="previewImg" style="max-width: 100%; border-radius: 8px;">
                                    <div class="flex gap-2 mt-4">
                                        <button class="btn btn-secondary btn-sm w-full" onclick="clearImage()">Fjern</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BATCH TAB -->
                <div id="tab-batch" class="tab-content">
                    <div class="section">
                        <div class="section-header">
                            <h3 class="section-title"><i class="fas fa-layer-group" style="color: var(--accent-purple);"></i> Batch Generering</h3>
                            <button class="btn btn-primary" onclick="startBatchGeneration()">
                                <i class="fas fa-play"></i> Start Batch
                            </button>
                        </div>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                            <div>
                                <h4 style="margin-bottom: 16px;">Velg Klipp</h4>
                                <div class="clip-list" id="clipList">
                                    <!-- Populated by JS -->
                                </div>
                                <div class="flex gap-2 mt-4">
                                    <button class="btn btn-secondary btn-sm" onclick="selectAllClips()">
                                        <i class="fas fa-check-square"></i> Velg alle
                                    </button>
                                    <button class="btn btn-secondary btn-sm" onclick="deselectAllClips()">
                                        <i class="fas fa-square"></i> Fjern alle
                                    </button>
                                </div>
                            </div>
                            
                            <div>
                                <h4 style="margin-bottom: 16px;">Batch Kø</h4>
                                <div class="batch-queue" id="batchQueue">
                                    <div class="empty-state" style="padding: 40px;">
                                        <i class="fas fa-inbox" style="font-size: 48px; color: var(--text-muted);"></i>
                                        <p style="margin-top: 16px; color: var(--text-secondary);">Ingen klipp i kø</p>
                                    </div>
                                </div>
                                <div id="batchProgress" class="hidden mt-4">
                                    <div class="flex justify-between mb-2">
                                        <span>Genererer...</span>
                                        <span id="batchProgressText">0/0</span>
                                    </div>
                                    <div class="progress-bar">
                                        <div class="progress-fill" id="batchProgressBar" style="width: 0%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- GALLERY TAB -->
                <div id="tab-gallery" class="tab-content">
                    <div class="section">
                        <div class="section-header">
                            <h3 class="section-title"><i class="fas fa-images" style="color: var(--accent-purple);"></i> Thumbnail Galleri</h3>
                            <div class="flex gap-2">
                                <button class="btn btn-secondary btn-sm" onclick="clearGallery()">
                                    <i class="fas fa-trash"></i> Tøm
                                </button>
                                <button class="btn btn-primary btn-sm" onclick="downloadAllGallery()">
                                    <i class="fas fa-download"></i> Last ned alle
                                </button>
                            </div>
                        </div>
                        <div class="gallery-grid" id="galleryGrid">
                            <div class="empty-state" style="grid-column: 1/-1; padding: 60px;">
                                <i class="fas fa-images" style="font-size: 64px; color: var(--text-muted);"></i>
                                <h3 style="margin-top: 24px;">Ingen thumbnails ennå</h3>
                                <p style="color: var(--text-secondary); margin-top: 8px;">Generer thumbnails for å se dem her</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TEMPLATES TAB -->
                <div id="tab-templates" class="tab-content">
                    <div class="section">
                        <div class="section-header">
                            <h3 class="section-title"><i class="fas fa-palette" style="color: var(--accent-purple);"></i> Tilpassede Templates</h3>
                            <button class="btn btn-primary" onclick="saveCurrentAsTemplate()">
                                <i class="fas fa-plus"></i> Lagre nåværende
                            </button>
                        </div>
                        <div class="template-grid" id="customTemplates">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>

                <!-- AI ANALYZE TAB -->
                <div id="tab-ai-analyze" class="tab-content">
                    <div class="section">
                        <div class="section-header">
                            <h3 class="section-title"><i class="fas fa-brain" style="color: var(--accent-purple);"></i> AI Tekstanalyse</h3>
                        </div>
                        <div class="form-group">
                            <label>Lim inn klipp-tekst eller transkripsjon</label>
                            <textarea id="analyzeText" rows="10" placeholder="Lim inn tekst fra podkast-klippet her..."></textarea>
                        </div>
                        <button class="btn btn-primary" onclick="analyzeWithAI()">
                            <i class="fas fa-magic"></i> Analyser med AI
                        </button>
                        <div id="aiAnalysisResult"></div>
                    </div>
                </div>

                <!-- AI SUGGEST TAB -->
                <div id="tab-ai-suggest" class="tab-content">
                    <div class="section">
                        <div class="section-header">
                            <h3 class="section-title"><i class="fas fa-lightbulb" style="color: var(--warning);"></i> AI Forslag</h3>
                        </div>
                        <div class="form-group">
                            <label>Tema eller nøkkelord</label>
                            <input type="text" id="suggestTopic" placeholder="F.eks. terapi, humor, relasjoner...">
                        </div>
                        <button class="btn btn-primary" onclick="getAISuggestions()">
                            <i class="fas fa-wand-magic-sparkles"></i> Få forslag
                        </button>
                        <div id="aiSuggestionsResult" class="mt-4"></div>
                    </div>
                </div>

                <!-- SETTINGS TAB -->
                <div id="tab-settings" class="tab-content">
                    <div class="section">
                        <div class="section-header">
                            <h3 class="section-title"><i class="fas fa-cog" style="color: var(--accent-purple);"></i> Konfigurasjon</h3>
                        </div>
                        <div class="form-group">
                            <label>OpenAI API Key</label>
                            <input type="password" id="openaiKey" placeholder="sk-...">
                        </div>
                        <div class="form-group">
                            <label>Standard Format</label>
                            <select id="defaultFormat">
                                <option value="instagram">Instagram (1080×1080)</option>
                                <option value="tiktok">TikTok (1080×1920)</option>
                                <option value="youtube">YouTube (1280×720)</option>
                                <option value="twitter">Twitter (1200×675)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Standard Font</label>
                            <select id="defaultFont">
                                <option value="bold">Bold</option>
                                <option value="modern">Modern</option>
                                <option value="elegant">Elegant</option>
                                <option value="playful">Playful</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Auto-lagre thumbnails</label>
                            <div class="toggle" id="autoSaveToggle" onclick="toggleSetting(this)"></div>
                        </div>
                        <button class="btn btn-primary" onclick="saveSettings()">
                            <i class="fas fa-save"></i> Lagre innstillinger
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="shared-navigation.js"></script>
    <script>
        // State
        const state = {
            template: 'instagram',
            color: 'purple',
            font: 'bold',
            zoom: 1,
            uploadedImage: null,
            gallery: [],
            clips: [
                { id: 1, title: 'EP.157 - Handleapp, hyperfokus og husfred', duration: '45:32', selected: false },
                { id: 2, title: 'EP.156 - Terapisession med Dr. Hansen', duration: '52:18', selected: false },
                { id: 3, title: 'EP.155 - Benjamin sin nye hobby', duration: '38:45', selected: false },
                { id: 4, title: 'EP.154 - Baarli på date', duration: '41:20', selected: false },
                { id: 5, title: 'EP.153 - Vi diskuterer terapi', duration: '48:15', selected: false },
            ],
            batchQueue: [],
            customTemplates: [],
            settings: {
                autoSave: false
            }
        };

        // Template dimensions
        const templates = {
            instagram: { width: 1080, height: 1080, name: 'Instagram' },
            tiktok: { width: 1080, height: 1920, name: 'TikTok' },
            youtube: { width: 1280, height: 720, name: 'YouTube' },
            twitter: { width: 1200, height: 675, name: 'Twitter' },
            facebook: { width: 1200, height: 630, name: 'Facebook' },
            stories: { width: 1080, height: 1920, name: 'Stories' }
        };

        // Color gradients
        const gradients = {
            purple: ['#667eea', '#764ba2'],
            pink: ['#f093fb', '#f5576c'],
            blue: ['#4facfe', '#00f2fe'],
            green: ['#43e97b', '#38f9d7'],
            orange: ['#fa709a', '#fee140'],
            dark: ['#30cfd0', '#330867']
        };

        // Fonts
        const fonts = {
            bold: { family: 'Arial Black, sans-serif', weight: 'bold' },
            modern: { family: 'Helvetica Neue, Arial, sans-serif', weight: 'bold' },
            elegant: { family: 'Georgia, serif', weight: 'normal' },
            playful: { family: 'Comic Sans MS, cursive', weight: 'bold' }
        };

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            loadSettings();
            initCanvas();
            renderClipList();
            renderGallery();
            renderCustomTemplates();
            updateStats();
        });

        // Tab Navigation
        function showTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            
            document.getElementById(`tab-${tabName}`).classList.add('active');
            event.target.closest('.nav-item').classList.add('active');
        }

        // Canvas Functions
        function initCanvas() {
            updateCanvas();
        }

        function updateCanvas() {
            const canvas = document.getElementById('thumbnailCanvas');
            const ctx = canvas.getContext('2d');
            const template = templates[state.template];
            
            // Set canvas size
            canvas.width = template.width;
            canvas.height = template.height;
            
            // Clear canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw background gradient
            const gradient = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
            const colors = gradients[state.color];
            gradient.addColorStop(0, colors[0]);
            gradient.addColorStop(1, colors[1]);
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            // Draw pattern overlay
            drawPattern(ctx, canvas.width, canvas.height);
            
            // Draw uploaded image if exists
            if (state.uploadedImage) {
                drawImage(ctx, canvas.width, canvas.height);
            }
            
            // Draw text
            drawText(ctx, canvas.width, canvas.height);
            
            // Draw episode badge
            drawEpisodeBadge(ctx, canvas.width, canvas.height);
        }

        function drawPattern(ctx, width, height) {
            ctx.save();
            ctx.globalAlpha = 0.1;
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 2;
            
            // Draw diagonal lines
            for (let i = -height; i < width + height; i += 40) {
                ctx.beginPath();
                ctx.moveTo(i, 0);
                ctx.lineTo(i + height, height);
                ctx.stroke();
            }
            
            // Draw circles
            ctx.fillStyle = '#ffffff';
            for (let i = 0; i < 5; i++) {
                ctx.beginPath();
                ctx.arc(
                    Math.random() * width,
                    Math.random() * height,
                    Math.random() * 100 + 50,
                    0,
                    Math.PI * 2
                );
                ctx.fill();
            }
            
            ctx.restore();
        }

        function drawImage(ctx, width, height) {
            ctx.save();
            
            // Create circular mask for image
            const imgSize = Math.min(width, height) * 0.5;
            const x = width * 0.7;
            const y = height * 0.5;
            
            ctx.beginPath();
            ctx.arc(x, y, imgSize / 2, 0, Math.PI * 2);
            ctx.closePath();
            ctx.clip();
            
            // Draw image
            ctx.drawImage(
                state.uploadedImage,
                x - imgSize / 2,
                y - imgSize / 2,
                imgSize,
                imgSize
            );
            
            // Add border
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 8;
            ctx.stroke();
            
            ctx.restore();
        }

        function drawText(ctx, width, height) {
            const fontStyle = fonts[state.font];
            const mainTitle = document.getElementById('mainTitle').value || 'Baarli og Benjamin';
            const subTitle = document.getElementById('subTitle').value || 'Går i terapi';
            
            ctx.save();
            
            // Main title
            ctx.font = `bold ${Math.min(width, height) * 0.08}px ${fontStyle.family}`;
            ctx.fillStyle = '#ffffff';
            ctx.textAlign = 'left';
            ctx.shadowColor = 'rgba(0,0,0,0.3)';
            ctx.shadowBlur = 20;
            ctx.shadowOffsetX = 4;
            ctx.shadowOffsetY = 4;
            
            const maxWidth = width * 0.6;
            const lineHeight = Math.min(width, height) * 0.1;
            const x = width * 0.08;
            const y = height * 0.35;
            
            wrapText(ctx, mainTitle, x, y, maxWidth, lineHeight);
            
            // Subtitle
            ctx.font = `${Math.min(width, height) * 0.04}px ${fontStyle.family}`;
            ctx.fillStyle = 'rgba(255,255,255,0.9)';
            ctx.shadowBlur = 10;
            
            wrapText(ctx, subTitle, x, y + lineHeight * 2, maxWidth, lineHeight * 0.8);
            
            ctx.restore();
        }

        function wrapText(ctx, text, x, y, maxWidth, lineHeight) {
            const words = text.split(' ');
            let line = '';
            
            for (let n = 0; n < words.length; n++) {
                const testLine = line + words[n] + ' ';
                const metrics = ctx.measureText(testLine);
                const testWidth = metrics.width;
                
                if (testWidth > maxWidth && n > 0) {
                    ctx.fillText(line, x, y);
                    line = words[n] + ' ';
                    y += lineHeight;
                } else {
                    line = testLine;
                }
            }
            ctx.fillText(line, x, y);
        }

        function drawEpisodeBadge(ctx, width, height) {
            const episodeNum = document.getElementById('episodeNum').value;
            if (!episodeNum) return;
            
            ctx.save();
            
            const badgeWidth = ctx.measureText(episodeNum).width + 40;
            const badgeHeight = 50;
            const x = width * 0.08;
            const y = height * 0.15;
            
            // Draw badge background
            ctx.fillStyle = 'rgba(0,0,0,0.5)';
            ctx.beginPath();
            ctx.roundRect(x, y, badgeWidth, badgeHeight, 25);
            ctx.fill();
            
            // Draw text
            ctx.font = 'bold 24px Arial, sans-serif';
            ctx.fillStyle = '#ffffff';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(episodeNum, x + badgeWidth / 2, y + badgeHeight / 2);
            
            ctx.restore();
        }

        // Template Selection
        function selectTemplate(template) {
            state.template = template;
            
            document.querySelectorAll('.template-card').forEach(card => {
                card.classList.remove('active');
            });
            document.querySelector(`[data-template="${template}"]`).classList.add('active');
            
            updateCanvas();
            showToast(`Format endret til ${templates[template].name}`, 'info');
        }

        // Color Selection
        function selectColor(color) {
            state.color = color;
            
            document.querySelectorAll('.color-option').forEach(option => {
                option.classList.remove('active');
            });
            document.querySelector(`[data-gradient="${color}"]`).classList.add('active');
            
            updateCanvas();
        }

        // Font Selection
        function selectFont(font) {
            state.font = font;
            
            document.querySelectorAll('.font-option').forEach(option => {
                option.classList.remove('active');
            });
            document.querySelector(`[data-font="${font}"]`).classList.add('active');
            
            updateCanvas();
        }

        // Image Upload
        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    state.uploadedImage = img;
                    document.getElementById('previewImg').src = e.target.result;
                    document.getElementById('uploadedImagePreview').classList.remove('hidden');
                    updateCanvas();
                    showToast('Bilde lastet opp!', 'success');
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function clearImage() {
            state.uploadedImage = null;
            document.getElementById('imageUpload').value = '';
            document.getElementById('uploadedImagePreview').classList.add('hidden');
            updateCanvas();
        }

        // Zoom
        function zoomCanvas(delta) {
            state.zoom = Math.max(0.5, Math.min(2, state.zoom + delta));
            document.getElementById('zoomLevel').textContent = Math.round(state.zoom * 100) + '%';
            
            const canvas = document.getElementById('thumbnailCanvas');
            canvas.style.transform = `scale(${state.zoom})`;
        }

        // Download
        function downloadThumbnail() {
            const canvas = document.getElementById('thumbnailCanvas');
            const link = document.createElement('a');
            link.download = `thumbnail-${state.template}-${Date.now()}.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
            
            // Add to gallery
            addToGallery(canvas.toDataURL('image/png'));
            
            showToast('Thumbnail lastet ned!', 'success');
            updateStats();
        }

        // Gallery
        function addToGallery(dataUrl) {
            const thumbnail = {
                id: Date.now(),
                dataUrl: dataUrl,
                template: state.template,
                title: document.getElementById('mainTitle').value,
                date: new Date().toLocaleString()
            };
            
            state.gallery.unshift(thumbnail);
            localStorage.setItem('thumbnailGallery', JSON.stringify(state.gallery));
            renderGallery();
        }

        function renderGallery() {
            const saved = localStorage.getItem('thumbnailGallery');
            if (saved) {
                state.gallery = JSON.parse(saved);
            }
            
            const grid = document.getElementById('galleryGrid');
            
            if (state.gallery.length === 0) {
                grid.innerHTML = `
                    <div class="empty-state" style="grid-column: 1/-1; padding: 60px;">
                        <i class="fas fa-images" style="font-size: 64px; color: var(--text-muted);"></i>
                        <h3 style="margin-top: 24px;">Ingen thumbnails ennå</h3>
                        <p style="color: var(--text-secondary); margin-top: 8px;">Generer thumbnails for å se dem her</p>
                    </div>
                `;
                return;
            }
            
            grid.innerHTML = state.gallery.map(item => `
                <div class="gallery-item" onclick="downloadGalleryItem(${item.id})">
                    <img loading="lazy" src="${item.dataUrl}" alt="${item.title}">
                    <div class="gallery-overlay">
                        <div class="gallery-title">${item.title}</div>
                        <div style="font-size: 11px; color: var(--text-muted);">${item.template} • ${item.date}</div>
                    </div>
                </div>
            `).join('');
        }

        function downloadGalleryItem(id) {
            const item = state.gallery.find(g => g.id === id);
            if (item) {
                const link = document.createElement('a');
                link.download = `thumbnail-${item.template}-${item.id}.png`;
                link.href = item.dataUrl;
                link.click();
                showToast('Thumbnail lastet ned!', 'success');
            }
        }

        function clearGallery() {
            if (confirm('Er du sikker på at du vil tømme galleriet?')) {
                state.gallery = [];
                localStorage.removeItem('thumbnailGallery');
                renderGallery();
                updateStats();
                showToast('Galleri tømt', 'info');
            }
        }

        function downloadAllGallery() {
            state.gallery.forEach((item, index) => {
                setTimeout(() => {
                    const link = document.createElement('a');
                    link.download = `thumbnail-${item.template}-${item.id}.png`;
                    link.href = item.dataUrl;
                    link.click();
                }, index * 200);
            });
            showToast('Laster ned alle thumbnails...', 'success');
        }

        // Clip List
        function renderClipList() {
            const list = document.getElementById('clipList');
            list.innerHTML = state.clips.map(clip => `
                <div class="clip-item ${clip.selected ? 'selected' : ''}" onclick="toggleClip(${clip.id})">
                    <input type="checkbox" class="clip-checkbox" ${clip.selected ? 'checked' : ''} onclick="event.stopPropagation(); toggleClip(${clip.id})">
                    <div class="clip-info">
                        <div class="clip-title">${clip.title}</div>
                        <div class="clip-meta">${clip.duration}</div>
                    </div>
                    <i class="fas fa-headphones" style="color: var(--text-muted);"></i>
                </div>
            `).join('');
        }

        function toggleClip(id) {
            const clip = state.clips.find(c => c.id === id);
            if (clip) {
                clip.selected = !clip.selected;
                renderClipList();
                updateBatchQueue();
            }
        }

        function selectAllClips() {
            state.clips.forEach(clip => clip.selected = true);
            renderClipList();
            updateBatchQueue();
        }

        function deselectAllClips() {
            state.clips.forEach(clip => clip.selected = false);
            renderClipList();
            updateBatchQueue();
        }

        function updateBatchQueue() {
            const selected = state.clips.filter(c => c.selected);
            const queue = document.getElementById('batchQueue');
            
            if (selected.length === 0) {
                queue.innerHTML = `
                    <div class="empty-state" style="padding: 40px;">
                        <i class="fas fa-inbox" style="font-size: 48px; color: var(--text-muted);"></i>
                        <p style="margin-top: 16px; color: var(--text-secondary);">Ingen klipp i kø</p>
                    </div>
                `;
                return;
            }
            
            queue.innerHTML = selected.map(clip => `
                <div class="batch-item" data-clip-id="${clip.id}">
                    <div class="batch-status pending">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 14px; font-weight: 500;">${clip.title}</div>
                        <div style="font-size: 12px; color: var(--text-muted);">${clip.duration}</div>
                    </div>
                    <span class="badge badge-secondary">Venter</span>
                </div>
            `).join('');
        }

        // Batch Generation
        async function startBatchGeneration() {
            const selected = state.clips.filter(c => c.selected);
            if (selected.length === 0) {
                showToast('Velg minst ett klipp', 'warning');
                return;
            }
            
            const progressDiv = document.getElementById('batchProgress');
            const progressBar = document.getElementById('batchProgressBar');
            const progressText = document.getElementById('batchProgressText');
            
            progressDiv.classList.remove('hidden');
            
            for (let i = 0; i < selected.length; i++) {
                const clip = selected[i];
                
                // Update progress
                progressText.textContent = `${i + 1}/${selected.length}`;
                progressBar.style.width = `${((i + 1) / selected.length) * 100}%`;
                
                // Update item status
                const item = document.querySelector(`[data-clip-id="${clip.id}"]`);
                if (item) {
                    item.querySelector('.batch-status').className = 'batch-status processing';
                    item.querySelector('.batch-status').innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                    item.querySelector('.badge').textContent = 'Genererer...';
                    item.querySelector('.badge').className = 'badge badge-info';
                }
                
                // Simulate generation
                await new Promise(resolve => setTimeout(resolve, 1500));
                
                // Generate thumbnail for this clip
                document.getElementById('mainTitle').value = clip.title;
                updateCanvas();
                
                // Add to gallery
                const canvas = document.getElementById('thumbnailCanvas');
                addToGallery(canvas.toDataURL('image/png'));
                
                // Update item status
                if (item) {
                    item.querySelector('.batch-status').className = 'batch-status complete';
                    item.querySelector('.batch-status').innerHTML = '<i class="fas fa-check"></i>';
                    item.querySelector('.badge').textContent = 'Ferdig';
                    item.querySelector('.badge').className = 'badge badge-success';
                }
            }
            
            showToast(`Batch generering fullført! ${selected.length} thumbnails opprettet.`, 'success');
            updateStats();
            
            // Reset after delay
            setTimeout(() => {
                progressDiv.classList.add('hidden');
                state.clips.forEach(clip => clip.selected = false);
                renderClipList();
                updateBatchQueue();
            }, 2000);
        }

        // AI Analysis (Simulated)
        function analyzeWithAI() {
            const text = document.getElementById('analyzeText').value;
            if (!text.trim()) {
                showToast('Lim inn tekst for å analysere', 'warning');
                return;
            }
            
            const resultDiv = document.getElementById('aiAnalysisResult');
            resultDiv.innerHTML = '<div class="flex items-center gap-4" style="padding: 24px;"><div class="spinner"></div><span>Analyserer...</span></div>';
            
            // Simulate AI analysis
            setTimeout(() => {
                const keywords = extractKeywords(text);
                const sentiment = analyzeSentiment(text);
                const suggestions = generateSuggestions(keywords);
                
                resultDiv.innerHTML = `
                    <div class="ai-result">
                        <h4><i class="fas fa-robot"></i> AI Analyse Resultat</h4>
                        <p><strong>Nøkkelord:</strong> ${keywords.join(', ')}</p>
                        <p><strong>Tone:</strong> ${sentiment}</p>
                        <p><strong>Anbefaling:</strong> Bruk ${sentiment === 'positiv' ? 'lyse, varme farger' : sentiment === 'negativ' ? 'mørke, intense farger' : 'nøytrale, balanserte farger'} for å reflektere innholdets tone.</p>
                        
                        <div class="ai-suggestions">
                            ${suggestions.map(s => `<span class="ai-suggestion" onclick="applySuggestion('${s}')">${s}</span>`).join('')}
                        </div>
                    </div>
                `;
            }, 2000);
        }

        function extractKeywords(text) {
            const commonWords = ['og', 'i', 'på', 'av', 'til', 'er', 'en', 'et', 'som', 'med', 'for', 'å', 'det', 'den', 'var', 'har', 'jeg', 'du', 'han', 'hun'];
            const words = text.toLowerCase().split(/\s+/);
            const freq = {};
            
            words.forEach(word => {
                if (word.length > 3 && !commonWords.includes(word)) {
                    freq[word] = (freq[word] || 0) + 1;
                }
            });
            
            return Object.entries(freq)
                .sort((a, b) => b[1] - a[1])
                .slice(0, 5)
                .map(([word]) => word);
        }

        function analyzeSentiment(text) {
            const positive = ['god', 'bra', 'flott', 'fantastisk', 'glad', 'lykkelig', 'positiv', 'supert'];
            const negative = ['dårlig', 'trist', 'vondt', 'negativ', 'problem', 'vanskelig', 'leit'];
            
            const words = text.toLowerCase().split(/\s+/);
            let posCount = words.filter(w => positive.includes(w)).length;
            let negCount = words.filter(w => negative.includes(w)).length;
            
            if (posCount > negCount) return 'positiv';
            if (negCount > posCount) return 'negativ';
            return 'nøytral';
        }

        function generateSuggestions(keywords) {
            const templates = [
                '🔥 Hett øyeblikk!',
                '😂 Du vil ikke tro dette',
                '💡 Visste du at...',
                '🎧 Ny episode ute!',
                '⚡ Må høres!',
                '🤯 Sinnsykt avsløring'
            ];
            
            return [...templates, ...keywords.map(k => `📌 ${k.charAt(0).toUpperCase() + k.slice(1)}`)];
        }

        function applySuggestion(suggestion) {
            document.getElementById('subTitle').value = suggestion.replace(/[📌🔥😂💡🎧⚡🤯]/g, '').trim();
            updateCanvas();
            showToast('Forslag brukt!', 'success');
        }

        // AI Suggestions
        function getAISuggestions() {
            const topic = document.getElementById('suggestTopic').value;
            if (!topic.trim()) {
                showToast('Skriv inn et tema', 'warning');
                return;
            }
            
            const resultDiv = document.getElementById('aiSuggestionsResult');
            resultDiv.innerHTML = '<div class="flex items-center gap-4" style="padding: 24px;"><div class="spinner"></div><span>Genererer forslag...</span></div>';
            
            setTimeout(() => {
                const suggestions = [
                    { title: `${topic} - Alt du trenger å vite`, subtitle: 'En episk samtale', color: 'purple' },
                    { title: 'Vi snakker om ' + topic, subtitle: 'Ikke for svake hjerter', color: 'pink' },
                    { title: topic.toUpperCase() + '!!!', subtitle: 'Sinnsyke avsløringer', color: 'blue' },
                    { title: 'Sannheten om ' + topic, subtitle: 'Hva ingen forteller deg', color: 'orange' },
                    { title: topic + ' med en twist', subtitle: 'Forbered deg', color: 'green' }
                ];
                
                resultDiv.innerHTML = `
                    <div class="template-grid">
                        ${suggestions.map((s, i) => `
                            <div class="template-card" onclick="applyTemplateSuggestion(${i})" style="cursor: pointer;">
                                <div style="font-size: 14px; font-weight: bold; margin-bottom: 8px;">${s.title}</div>
                                <div style="font-size: 12px; color: var(--text-muted);">${s.subtitle}</div>
                                <div style="margin-top: 8px; padding: 4px 8px; background: var(--bg-secondary); border-radius: 4px; font-size: 11px;">${s.color}</div>
                            </div>
                        `).join('')}
                    </div>
                `;
                
                state.aiSuggestions = suggestions;
            }, 1500);
        }

        function applyTemplateSuggestion(index) {
            const suggestion = state.aiSuggestions[index];
            if (suggestion) {
                document.getElementById('mainTitle').value = suggestion.title;
                document.getElementById('subTitle').value = suggestion.subtitle;
                selectColor(suggestion.color);
                updateCanvas();
                showToast('Template brukt!', 'success');
            }
        }

        // Custom Templates
        function saveCurrentAsTemplate() {
            const template = {
                id: Date.now(),
                name: prompt('Gi templaten et navn:') || 'Min Template',
                mainTitle: document.getElementById('mainTitle').value,
                subTitle: document.getElementById('subTitle').value,
                episodeNum: document.getElementById('episodeNum').value,
                color: state.color,
                font: state.font,
                format: state.template
            };
            
            state.customTemplates.push(template);
            localStorage.setItem('customTemplates', JSON.stringify(state.customTemplates));
            renderCustomTemplates();
            showToast('Template lagret!', 'success');
        }

        function renderCustomTemplates() {
            const saved = localStorage.getItem('customTemplates');
            if (saved) {
                state.customTemplates = JSON.parse(saved);
            }
            
            const grid = document.getElementById('customTemplates');
            
            if (state.customTemplates.length === 0) {
                grid.innerHTML = `
                    <div class="empty-state" style="grid-column: 1/-1; padding: 40px;">
                        <i class="fas fa-palette" style="font-size: 48px; color: var(--text-muted);"></i>
                        <p style="margin-top: 16px; color: var(--text-secondary);">Ingen egne templates ennå</p>
                    </div>
                `;
                return;
            }
            
            grid.innerHTML = state.customTemplates.map(t => `
                <div class="template-card" onclick="loadCustomTemplate(${t.id})">
                    <div class="template-icon" style="background: linear-gradient(135deg, ${gradients[t.color][0]}, ${gradients[t.color][1]}); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">🎨</div>
                    <div class="template-name">${t.name}</div>
                    <div class="template-dims">${templates[t.format].name}</div>
                    <button class="btn btn-danger btn-sm" style="margin-top: 8px;" onclick="event.stopPropagation(); deleteCustomTemplate(${t.id})">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            `).join('');
        }

        function loadCustomTemplate(id) {
            const template = state.customTemplates.find(t => t.id === id);
            if (template) {
                document.getElementById('mainTitle').value = template.mainTitle;
                document.getElementById('subTitle').value = template.subTitle;
                document.getElementById('episodeNum').value = template.episodeNum;
                selectColor(template.color);
                selectFont(template.font);
                selectTemplate(template.format);
                showToast('Template lastet!', 'success');
            }
        }

        function deleteCustomTemplate(id) {
            if (confirm('Slette denne templaten?')) {
                state.customTemplates = state.customTemplates.filter(t => t.id !== id);
                localStorage.setItem('customTemplates', JSON.stringify(state.customTemplates));
                renderCustomTemplates();
                showToast('Template slettet', 'info');
            }
        }

        // Settings
        function loadSettings() {
            const saved = localStorage.getItem('thumbnailSettings');
            if (saved) {
                state.settings = JSON.parse(saved);
                document.getElementById('autoSaveToggle').classList.toggle('active', state.settings.autoSave);
            }
        }

        function saveSettings() {
            state.settings = {
                openaiKey: document.getElementById('openaiKey').value,
                defaultFormat: document.getElementById('defaultFormat').value,
                defaultFont: document.getElementById('defaultFont').value,
                autoSave: document.getElementById('autoSaveToggle').classList.contains('active')
            };
            
            localStorage.setItem('thumbnailSettings', JSON.stringify(state.settings));
            showToast('Innstillinger lagret!', 'success');
        }

        function toggleSetting(element) {
            element.classList.toggle('active');
        }

        // Stats
        function updateStats() {
            const saved = localStorage.getItem('thumbnailGallery');
            const gallery = saved ? JSON.parse(saved) : [];
            
            document.getElementById('stat-generated').textContent = gallery.length;
            document.getElementById('stat-saved').textContent = gallery.length;
            document.getElementById('stat-batch').textContent = state.clips.filter(c => c.selected).length;
        }

        // Reset
        function resetCanvas() {
            document.getElementById('mainTitle').value = 'Baarli og Benjamin';
            document.getElementById('subTitle').value = 'Går i terapi';
            document.getElementById('episodeNum').value = 'EP.157';
            selectColor('purple');
            selectFont('bold');
            selectTemplate('instagram');
            clearImage();
            updateCanvas();
            showToast('Canvas tilbakestilt', 'info');
        }

        // Toast Notifications
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            
            const icons = {
                success: 'check-circle',
                error: 'exclamation-circle',
                warning: 'exclamation-triangle',
                info: 'info-circle'
            };
            
            toast.innerHTML = `
                <i class="fas fa-${icons[type]}"></i>
                <span>${message}</span>
            `;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.style.animation = 'slideIn 0.3s ease reverse';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
