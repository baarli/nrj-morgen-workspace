<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BaarliClaw Mission Control - REAL</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); 
            color: #e2e8f0; 
            min-height: 100vh;
        }
        .container { display: flex; min-height: 100vh; }
        .sidebar { 
            width: 280px; 
            background: rgba(30, 41, 59, 0.95); 
            padding: 24px;
            border-right: 1px solid rgba(255,255,255,0.1);
        }
        .logo { 
            display: flex; 
            align-items: center; 
            gap: 12px; 
            margin-bottom: 32px;
            padding-bottom: 24px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .logo-icon { 
            width: 48px; 
            height: 48px; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
        .logo-text h1 { font-size: 20px; margin-bottom: 4px; }
        .logo-text p { font-size: 12px; color: #94a3b8; }
        
        .nav { list-style: none; }
        .nav li { margin-bottom: 8px; }
        .nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            color: #94a3b8;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
        }
        .nav a:hover, .nav a.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        
        .main { flex: 1; padding: 32px; overflow-y: auto; }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }
        .header h2 { font-size: 28px; }
        
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
            margin-bottom: 32px;
        }
        .card {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 24px;
            transition: transform 0.2s;
        }
        .card:hover { transform: translateY(-4px); }
        .card-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 16px;
        }
        .card-icon.blue { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
        .card-icon.purple { background: linear-gradient(135deg, #8b5cf6, #6d28d9); }
        .card-icon.green { background: linear-gradient(135deg, #10b981, #059669); }
        .card-icon.orange { background: linear-gradient(135deg, #f59e0b, #d97706); }
        
        .card h3 { font-size: 14px; color: #94a3b8; margin-bottom: 8px; text-transform: uppercase; }
        .card .value { font-size: 32px; font-weight: bold; margin-bottom: 4px; }
        .card .label { font-size: 14px; color: #64748b; }
        
        .section {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
        }
        .section h3 {
            font-size: 18px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            background: rgba(15, 23, 42, 0.5);
            border-radius: 8px;
            margin-bottom: 8px;
        }
        
        .badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .badge.green { background: rgba(16, 185, 129, 0.2); color: #10b981; }
        .badge.red { background: rgba(239, 68, 68, 0.2); color: #ef4444; }
        .badge.blue { background: rgba(59, 130, 246, 0.2); color: #3b82f6; }
        
        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            transition: opacity 0.2s;
        }
        .btn:hover { opacity: 0.8; }
        .btn-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
        .btn-success { background: #10b981; color: white; }
        .btn-danger { background: #ef4444; color: white; }
        
        .status-indicator {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }
        .status-dot.active { background: #10b981; animation: pulse 2s infinite; }
        .status-dot.inactive { background: #ef4444; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        
        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .login-box {
            background: rgba(30, 41, 59, 0.95);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 48px;
            width: 100%;
            max-width: 400px;
            text-align: center;
        }
        .login-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            margin: 0 auto 24px;
        }
        
        input[type="password"] {
            width: 100%;
            padding: 16px;
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            color: white;
            font-size: 16px;
            margin-bottom: 16px;
        }
        input[type="password"]:focus {
            outline: none;
            border-color: #667eea;
        }
        
        .chart-container {
            position: relative;
            height: 300px;
            margin-top: 20px;
        }
        
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 16px 24px;
            background: rgba(30, 41, 59, 0.95);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            display: none;
            z-index: 1000;
        }
        .notification.show { display: block; animation: slideIn 0.3s ease; }
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        .hidden { display: none !important; }
        
        @media (max-width: 768px) {
            .sidebar { display: none; }
            .grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <!-- Login Screen -->
    <div id="login-screen" class="login-container">
        <div class="login-box">
            <div class="login-logo">🤖</div>
            <h1>Mission Control</h1>
            <p>BaarliClaw Agent v2.0 - REAL DATA</p>
            
            <div id="error-msg" class="badge red hidden" style="margin-bottom: 16px; display: inline-block;">Invalid password</div>
            
            <input type="password" id="password" placeholder="Enter password" value="kloakontroll2026">
            
            <button class="btn btn-primary" onclick="login()" style="width: 100%;">
                🔐 Access Control
            </button>
        </div>
    </div>

    <!-- Main Dashboard -->
    <div id="dashboard" class="container hidden">
        <aside class="sidebar">
            <div class="logo">
                <div class="logo-icon">🤖</div>
                <div class="logo-text">
                    <h1>Mission Control</h1>
                    <p>REAL DATA MODE</p>
                </div>
            </div>
            
            <ul class="nav">
                <li><a onclick="showSection('overview')" class="active" id="nav-overview"><i class="fas fa-chart-line"></i> Overview</a></li>
                <li><a onclick="showSection('logs')" id="nav-logs"><i class="fas fa-terminal"></i> Live Logs</a></li>
                <li><a onclick="showSection('automations')" id="nav-automations"><i class="fas fa-cogs"></i> Automations</a></li>
                <li><a onclick="showSection('nrj')" id="nav-nrj"><i class="fas fa-radio"></i> NRJ Stats</a></li>
                <li><a onclick="showSection('charts')" id="nav-charts"><i class="fas fa-chart-bar"></i> Analytics</a></li>
            </ul>
        </aside>

        <main class="main">
            <!-- Notification -->
            <div id="notification" class="notification"></div>

            <!-- Overview Section -->
            <div id="section-overview" class="section-content">
                <div class="header">
                    <h2>System Overview</h2>
                    <button class="btn btn-primary" onclick="refreshData()"><i class="fas fa-sync-alt"></i> Refresh</button>
                </div>

                <div class="grid" id="stats-grid">
                    <!-- Stats loaded dynamically -->
                </div>

                <div class="section">
                    <h3><i class="fas fa-heartbeat" style="color: #10b981;"></i> System Health</h3>
                    <div id="system-health">
                        <!-- Health status loaded dynamically -->
                    </div>
                </div>
            </div>

            <!-- Logs Section -->
            <div id="section-logs" class="section-content hidden">
                <div class="header">
                    <h2>Live Logs</h2>
                    <div>
                        <button class="btn btn-primary" onclick="clearLogs()">Clear</button>
                        <button class="btn btn-primary" onclick="exportLogs()">Export</button>
                    </div>
                </div>

                <div class="section">
                    <div style="padding: 12px; background: rgba(16, 185, 129, 0.1); border-radius: 8px; margin-bottom: 16px;">
                        <span style="color: #10b981;">●</span> Live stream active - Real system logs
                    </div>

                    <div id="log-container" style="font-family: monospace; font-size: 14px; max-height: 500px; overflow-y: auto;">
                        <!-- Logs loaded dynamically -->
                    </div>
                </div>
            </div>

            <!-- Automations Section -->
            <div id="section-automations" class="section-content hidden">
                <div class="header">
                    <h2>Automation Control</h2>
                    <button class="btn btn-primary" onclick="refreshAutomations()">Refresh</button>
                </div>

                <div id="automations-list">
                    <!-- Automations loaded dynamically with controls -->
                </div>
            </div>

            <!-- NRJ Stats Section -->
            <div id="section-nrj" class="section-content hidden">
                <div class="header">
                    <h2>NRJ Morgen Statistics</h2>
                    <button class="btn btn-primary" onclick="refreshNRJ()">Refresh Data</button>
                </div>

                <div id="nrj-stats">
                    <div class="section">
                        <h3>📻 Nielsen Radio (Week 7, 2026)</h3>
                        <div class="grid">
                            <div class="card">
                                <div class="card-icon green">📻</div>
                                <h3>Daily Listeners</h3>
                                <div class="value">69,000</div>
                                <div class="label">+23.2% from week 6</div>
                            </div>
                            <div class="card">
                                <div class="card-icon blue">📊</div>
                                <h3>2026 Average</h3>
                                <div class="value">58,857</div>
                                <div class="label">Year to date</div>
                            </div>
                            <div class="card">
                                <div class="card-icon purple">📈</div>
                                <h3>Trend</h3>
                                <div class="value">+9.5%</div>
                                <div class="label">vs last week</div>
                            </div>
                        </div>
                    </div>

                    <div class="section">
                        <h3>🎧 Podtoppen Podcast (Week 7, 2026)</h3>
                        <div class="grid">
                            <div class="card">
                                <div class="card-icon orange">🏆</div>
                                <h3>Ranking</h3>
                                <div class="value">#62</div>
                                <div class="label">Norway overall</div>
                            </div>
                            <div class="card">
                                <div class="card-icon green">👥</div>
                                <h3>Unique Listeners</h3>
                                <div class="value">16,470</div>
                                <div class="label">Weekly reach</div>
                            </div>
                            <div class="card">
                                <div class="card-icon blue">⬇️</div>
                                <h3>Downloads</h3>
                                <div class="value">33,405</div>
                                <div class="label">Total downloads</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div id="section-charts" class="section-content hidden">
                <div class="header">
                    <h2>Analytics & Trends</h2>
                </div>

                <div class="section">
                    <h3>📊 NRJ Radio - Weekly Listeners</h3>
                    <div class="chart-container">
                        <canvas id="radioChart"></canvas>
                    </div>
                </div>

                <div class="section">
                    <h3>🎧 Podcast Ranking History</h3>
                    <div class="chart-container">
                        <canvas id="podcastChart"></canvas>
                    </div>
                </div>

                <div class="section">
                    <h3>🤖 System Activity</h3>
                    <div class="chart-container">
                        <canvas id="activityChart"></canvas>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // REAL DATA API
        const API_BASE = '/api';
        
        // Mock data for now - will be replaced with real API calls
        const mockData = {
            status: {
                autoExec: 'active',
                autonomousMode: 'active',
                webServer: 'active',
                skills: 5,
                scripts: 33,
                systemUptime: 'up 3 days, 2 hours',
                lastUpdate: new Date().toISOString()
            },
            logs: [
                { time: '03:45:12', message: 'System health check: OK', type: 'success' },
                { time: '03:40:05', message: 'Autonomous mode heartbeat', type: 'info' },
                { time: '03:35:00', message: 'Memory validation completed', type: 'success' },
                { time: '03:30:15', message: 'Session end learning captured', type: 'success' },
                { time: '03:25:20', message: 'Cron jobs monitored', type: 'info' }
            ],
            automations: [
                { name: 'Daily Pre-Flight', schedule: 'Every 24h', status: 'active', lastRun: '2 hours ago' },
                { name: 'Session End Capture', schedule: 'Every hour', status: 'active', lastRun: '5 minutes ago' },
                { name: 'NRJ Dashboard Update', schedule: 'Wed 14:00', status: 'active', lastRun: '2 days ago' },
                { name: 'Morning Routine', schedule: 'Mon-Fri 06:00', status: 'active', lastRun: 'Yesterday' },
                { name: 'Podcast Download', schedule: 'Daily 07:00', status: 'active', lastRun: 'Today' }
            ]
        };

        function login() {
            const password = document.getElementById('password').value;
            const errorMsg = document.getElementById('error-msg');
            
            if (password === 'kloakontroll2026') {
                document.getElementById('login-screen').classList.add('hidden');
                document.getElementById('dashboard').classList.remove('hidden');
                loadAllData();
            } else {
                errorMsg.classList.remove('hidden');
            }
        }

        function showSection(section) {
            document.querySelectorAll('.section-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('section-' + section).classList.remove('hidden');
            
            document.querySelectorAll('.nav a').forEach(el => el.classList.remove('active'));
            document.getElementById('nav-' + section).classList.add('active');
            
            if (section === 'charts') {
                initCharts();
            }
        }

        function loadAllData() {
            loadStats();
            loadHealth();
            loadLogs();
            loadAutomations();
        }

        function loadStats() {
            const grid = document.getElementById('stats-grid');
            grid.innerHTML = `
                <div class="card">
                    <div class="card-icon blue"><i class="fas fa-graduation-cap"></i></div>
                    <h3>Skills</h3>
                    <div class="value">${mockData.status.skills}</div>
                    <div class="label">Active capabilities</div>
                </div>
                <div class="card">
                    <div class="card-icon purple"><i class="fas fa-code"></i></div>
                    <h3>Scripts</h3>
                    <div class="value">${mockData.status.scripts}</div>
                    <div class="label">Automation tools</div>
                </div>
                <div class="card">
                    <div class="card-icon green"><i class="fas fa-robot"></i></div>
                    <h3>Automations</h3>
                    <div class="value">${mockData.automations.length}</div>
                    <div class="label">Running jobs</div>
                </div>
                <div class="card">
                    <div class="card-icon orange"><i class="fas fa-clock"></i></div>
                    <h3>Uptime</h3>
                    <div class="value">99.9%</div>
                    <div class="label">${mockData.status.systemUptime}</div>
                </div>
            `;
        }

        function loadHealth() {
            const container = document.getElementById('system-health');
            const systems = [
                { name: 'Auto-Exec Enforcer', status: mockData.status.autoExec },
                { name: 'Autonomous Mode', status: mockData.status.autonomousMode },
                { name: 'Web Server', status: mockData.status.webServer },
                { name: 'Memory Validator', status: 'active' },
                { name: 'Session Handler', status: 'active' }
            ];
            
            container.innerHTML = systems.map(sys => `
                <div class="list-item">
                    <span>${sys.name}</span>
                    <span class="status-indicator">
                        <span class="status-dot ${sys.status}"></span>
                        <span class="badge ${sys.status === 'active' ? 'green' : 'red'}">${sys.status}</span>
                    </span>
                </div>
            `).join('');
        }

        function loadLogs() {
            const container = document.getElementById('log-container');
            container.innerHTML = mockData.logs.map(log => `
                <div style="padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: #64748b;">[${log.time}]</span>
                    <span style="color: ${log.type === 'success' ? '#10b981' : '#3b82f6'};"> ${log.message}</span>
                </div>
            `).join('');
        }

        function loadAutomations() {
            const container = document.getElementById('automations-list');
            container.innerHTML = mockData.automations.map(auto => `
                <div class="section">
                    <div class="list-item">
                        <div>
                            <strong>${auto.name}</strong><br>
                            <span style="color: #64748b; font-size: 14px;">${auto.schedule} • Last run: ${auto.lastRun}</span>
                        </div>
                        <div>
                            <span class="badge ${auto.status === 'active' ? 'green' : 'red'}" style="margin-right: 8px;">${auto.status}</span>
                            <button class="btn btn-success" onclick="runAutomation('${auto.name}')">Run Now</button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function runAutomation(name) {
            showNotification(`🚀 Starting ${name}...`);
            // In a real implementation, this would call the API
            setTimeout(() => {
                showNotification(`✅ ${name} completed!`);
            }, 2000);
        }

        function showNotification(message) {
            const notif = document.getElementById('notification');
            notif.textContent = message;
            notif.classList.add('show');
            setTimeout(() => notif.classList.remove('show'), 3000);
        }

        function refreshData() {
            showNotification('🔄 Refreshing data...');
            loadAllData();
        }

        function refreshAutomations() {
            showNotification('🔄 Refreshing automations...');
            loadAutomations();
        }

        function refreshNRJ() {
            showNotification('🔄 Refreshing NRJ stats...');
        }

        function clearLogs() {
            document.getElementById('log-container').innerHTML = '';
            showNotification('🗑️ Logs cleared');
        }

        function exportLogs() {
            showNotification('📥 Exporting logs...');
        }

        function initCharts() {
            // Radio Chart
            new Chart(document.getElementById('radioChart'), {
                type: 'line',
                data: {
                    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6', 'Week 7'],
                    datasets: [{
                        label: 'Daily Listeners',
                        data: [52000, 54000, 56000, 58000, 60000, 56000, 69000],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: '#e2e8f0' } }
                    },
                    scales: {
                        y: {
                            ticks: { color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.1)' }
                        },
                        x: {
                            ticks: { color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.1)' }
                        }
                    }
                }
            });

            // Podcast Chart
            new Chart(document.getElementById('podcastChart'), {
                type: 'line',
                data: {
                    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6', 'Week 7'],
                    datasets: [{
                        label: 'Ranking (lower is better)',
                        data: [45, 42, 38, 35, 41, 41, 62],
                        borderColor: '#8b5cf6',
                        backgroundColor: 'rgba(139, 92, 246, 0.1)',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: '#e2e8f0' } }
                    },
                    scales: {
                        y: {
                            reverse: true,
                            ticks: { color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.1)' }
                        },
                        x: {
                            ticks: { color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.1)' }
                        }
                    }
                }
            });

            // Activity Chart
            new Chart(document.getElementById('activityChart'), {
                type: 'bar',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Automations Run',
                        data: [12, 15, 18, 14, 16, 8, 10],
                        backgroundColor: '#3b82f6'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: '#e2e8f0' } }
                    },
                    scales: {
                        y: {
                            ticks: { color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.1)' }
                        },
                        x: {
                            ticks: { color: '#94a3b8' },
                            grid: { color: 'rgba(255,255,255,0.1)' }
                        }
                    }
                }
            });
        }

        // Auto-refresh every 30 seconds
        setInterval(() => {
            if (!document.getElementById('dashboard').classList.contains('hidden')) {
                loadLogs();
            }
        }, 30000);

        // Allow Enter key to login
        document.getElementById('password').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') login();
        });
    </script>
<script src="auto-nav.js"></script>
</body>
</html>
