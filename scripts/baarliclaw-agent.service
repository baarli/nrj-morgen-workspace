[Unit]
Description=BaarliClaw Continuous Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace
ExecStart=/bin/bash /root/.openclaw/workspace/scripts/continuous-agent.sh
Restart=always
RestartSec=10
Environment="WORKSPACE=/root/.openclaw/workspace"

[Install]
WantedBy=multi-user.target