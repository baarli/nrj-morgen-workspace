name: code-quality-checker
description: Systematisk kodekvalitetsjekk for workspace
version: 1.0.0
author: BaarliClaw
created: 2026-02-27

capabilities:
  - python-analysis
  - bash-analysis
  - html-analysis
  - quality-scoring
  - report-generation

usage: |
  # Sjekk en fil
  ./skills/code-quality-checker/check-quality.sh path/to/file.py
  
  # Sjekk alle filer
  ./skills/code-quality-checker/check-quality.sh --all
  
  # Generer rapport
  ./skills/code-quality-checker/check-quality.sh --report

path: skills/code-quality-checker/
main: check-quality.sh
docs: SKILL.md
