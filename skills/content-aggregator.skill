name: content-aggregator
description: News and content aggregation system with Brave News API integration, AI title generation, and automated research workflows. Powers the Morning Routine system for NRJ Morgen.

usage:
  # Basic news search
  python3 /root/.openclaw/workspace/scripts/brave-news-search.py 15
  
  # Run morning routine
  python3 /root/.openclaw/workspace/scripts/morning-routine-v2.1.py
  
  # Full automation pipeline
  bash /root/.openclaw/workspace/scripts/integrated-morning-routine.sh
  
  # Generate AI title
  python3 /root/.openclaw/workspace/scripts/ai-generate-title.py "title" "description"

key_features:
  - Brave News API integration
  - AI title generation (OpenAI, max 7 words)
  - Entertainment scoring algorithm
  - Content filtering (excludes sports, politics, tragedies)
  - 5 category system (15 articles/day)
  - Supabase database integration
  - Fully automated daily workflow

categories:
  - Reality TV (max 3)
  - Kjendis Drama (max 3)
  - Film & TV (max 3)
  - Musikk (max 3)
  - Internasjonalt (max 3)

output_files:
  - /tmp/morning-news.json
  - /tmp/morning-routine-v2-result.json
  - /var/log/morning-routine.log

api_keys:
  - BRAVE_API_KEY (Brave News API)
  - OPENAI_API_KEY (Title generation)
  - SUPABASE_SERVICE_KEY (Database)

scripts:
  - brave-news-search.py
  - morning-routine-v2.1.py
  - ai-generate-title.py
  - integrated-morning-routine.sh

triggers:
  - Daily at 06:00 (cron)
  - Manual execution
  - Paused via .morning-routine-paused file

documentation: /root/.openclaw/workspace/skills/content-aggregator/SKILL.md
